+      const revision = r.revision ?? 1, previous = latest.get(key), issues = ['PERIOD_AND_COVERAGE_UNVERIFIED'];
+      if (!dictionary.calibers[r.caliber]) issues.push('UNKNOWN_CALIBER');
+      if (!text(r.unit)) issues.push('UNIT_UNVERIFIED');
+      if (!timestamp(r.capturedAt)) issues.push('CAPTURE_TIME_UNVERIFIED');
+      else if (Date.parse(r.capturedAt) > now.getTime()) issues.push('CAPTURE_FROM_FUTURE');
+      if (previous && (revision < previous.revision || (revision === previous.revision && ceoContentHash(r) !== previous.recordHash))) issues.push('SOURCE_REVISION_CONFLICT');
+      if (previous?.issues.includes('SOURCE_REVISION_CONFLICT')) issues.push('SOURCE_REVISION_CONFLICT');
+      latest.set(key, { key, revision, source:r.source, storeRef:config.goal.storeRef, caliber:r.caliber,
+        value:r.value, unit:r.unit ?? null, subject:r.subject, window:r.window, statDate:r.statDate,
+        capturedAt:r.capturedAt ?? null, meta:r.meta ?? null, recordHash:ceoContentHash(r),
+        quality:'PENDING_VERIFICATION', issues:[...new Set(issues)], provenance:{path:relative,sha256,line:index+1} });
+    }
+  }
+  const observations = [...latest.values()].sort((a,b)=>a.key.localeCompare(b.key));
+  const gaps = new Set(['METRIC_DEFINITIONS_UNVERIFIED','COSTS_UNRECONCILED']);
+  if (!observations.length) gaps.add('NO_LOCAL_FACTS');
+  if (config.goal.capacityMinutes === null || config.goal.bufferMinutes === null) gaps.add('CAPACITY_UNCONFIRMED');
+  for (const observation of observations) for (const issue of observation.issues) gaps.add(issue);
+  const context = {schema:'ceo-operating-context/v1',loadedAt:now.toISOString(),goal:config.goal,facts:[],observations,
+    sourceManifest:manifest,dictionaryHash:digest(dictionaryBytes),gaps:[...gaps].sort(),resourceProposal:config.resourceProposal};
+  return {...context,contextId:ceoContextId(context)};
+}
diff --git a/dist/src/ceo-read-brief.js b/dist/src/ceo-read-brief.js
new file mode 100644
index 0000000..c24f6f9
--- /dev/null
+++ b/dist/src/ceo-read-brief.js
@@ -0,0 +1,82 @@
+const STATES = new Set(["DRAFT", "READY", "RUNNING", "BLOCKED_NEEDS_HUMAN", "DONE", "FAILED", "CANCELLED"]);
+
+function failure(code, message) {
+  const error = new Error(message);
+  error.code = code;
+  return error;
+}
+
+function stateUrl(baseUrl) {
+  // Require a literal loopback host and explicit port before URL normalization.
+  // WHATWG URL otherwise turns shorthand/numeric hosts into 127.0.0.1.
+  if (typeof baseUrl !== "string" || !/^http:\/\/(?:127\.0\.0\.1|localhost):\d{1,5}\/?$/i.test(baseUrl)) {
+    throw failure("INVALID_BASE_URL", "Use an HTTP loopback address with an explicit port.");
+  }
+  let base;
+  try { base = new URL(baseUrl); } catch { /* handled below */ }
+  const explicitPort = Number(baseUrl.match(/:(\d+)\/?$/)?.[1]);
+  if (!base || explicitPort < 1 || explicitPort > 65535 || base.username || base.password || base.search || base.hash || base.pathname !== "/") {
+    throw failure("INVALID_BASE_URL", "Use an HTTP loopback address with an explicit port.");
+  }
+  return new URL("/api/system/state", base).href;
+}
+
+function record(value) {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function validState(data) {
+  return record(data) && data.schema === "system-state/v1" && data.readOnly === true
+    && typeof data.generatedAt === "string" && Number.isFinite(Date.parse(data.generatedAt))
+    && record(data.summary) && typeof data.summary.healthy === "boolean"
+    && Array.isArray(data.sources) && data.sources.every(source => record(source) && typeof source.id === "string" && typeof source.ok === "boolean")
+    && Array.isArray(data.units) && data.units.every(unit => record(unit) && typeof unit.unitId === "string" && STATES.has(unit.state))
+    && Array.isArray(data.gates) && data.gates.every(record)
+    && Array.isArray(data.caveats) && data.caveats.every(text => typeof text === "string");
+}
+
+/** Read the existing local projection. Does not execute tasks or verify platform effects. */
+export async function readCeoBrief({ baseUrl = "http://127.0.0.1:3000", fetchImpl = globalThis.fetch, now = new Date() } = {}) {
+  const url = stateUrl(baseUrl);
+  let response;
+  try {
+    response = await fetchImpl(url, {
+      method: "GET", redirect: "error", signal: AbortSignal.timeout(8000),
+      headers: { Accept: "application/json" },
+    });
+  } catch {
+    throw failure("CONNECTION_FAILED", "Could not read the local OS state.");
+  }
+  if (response?.status !== 200) {
+    throw failure("INVALID_RESPONSE", "The local OS returned an unsupported response.");
+  }
+  let data;
+  try { data = await response.json(); } catch {
+    throw failure("INVALID_RESPONSE", "The local OS returned invalid JSON.");
+  }
+  if (!validState(data)) {
+    throw failure("INVALID_RESPONSE", "The local OS state does not match system-state/v1.");
+  }
+  return {
+    schema: "ceo-brief/v1",
+    observedAt: now.toISOString(),
+    sourceGeneratedAt: data.generatedAt,
+    readOnly: true,
+    connection: "VERIFIED",
+    dataHealth: data.sources.length > 0 && data.sources.every(source => source.ok) && data.summary.healthy ? "OK" : "DEGRADED",
+    sources: data.sources,
+    summary: data.summary,
+    summaryIsSourceProjection: true,
+    units: data.units.map(unit => ({
+      ...unit, rawState: unit.state,
+      businessStatus: unit.state === "DONE" ? "PENDING_VERIFICATION" : unit.state,
+      verification: "UNVERIFIED",
+    })),
+    gates: data.gates,
+    caveats: [
+      ...data.caveats,
+      "系统汇总和原始 DONE 仅为本地投影，不证明外部业务动作已经核验完成。",
+      "sourceGeneratedAt 是系统汇总生成时间，不证明平台指标新鲜度或经营目标达成。",
+    ],
+  };
+}
diff --git a/dist/src/ceo-review-input-guard.js b/dist/src/ceo-review-input-guard.js
new file mode 100644
index 0000000..e28b277
--- /dev/null
+++ b/dist/src/ceo-review-input-guard.js
@@ -0,0 +1,35 @@
+import {realpathSync,readdirSync,openSync,fstatSync,readSync,closeSync} from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
+const inside=(root,file)=>{const rel=path.relative(root,file);return rel!==''&&rel!=='..'&&!rel.startsWith(`..${path.sep}`)&&!path.isAbsolute(rel);};
+
+// Capture before awaited loaders; recheck synchronously inside the SQLite commit.
+export function captureCeoReviewInputs({projectRoot}){
+ const root=realpathSync(projectRoot);
+ function read(relative,limit,boundary=root){
+  const full=realpathSync(path.join(root,relative));if(!inside(boundary,full))fail('REVIEW_SOURCE_UNAVAILABLE');
+  const fd=openSync(full,'r');try{const info=fstatSync(fd);if(!info.isFile()||info.size>limit)fail('REVIEW_SOURCE_UNAVAILABLE');const bytes=Buffer.alloc(limit+1);let n=0;while(n<bytes.length){const got=readSync(fd,bytes,n,bytes.length-n,null);if(!got)break;n+=got;}if(n>limit)fail('REVIEW_SOURCE_UNAVAILABLE');return{full,bytes:bytes.subarray(0,n)};}finally{closeSync(fd);}
+ }
+ function contextSignature(){
+  try{
+   const rows=[];for(const [name,limit] of [['config/ceo-store-400370.json',65536],['config/metrics-schema.json',1048576]]){const r=read(name,limit);rows.push([name,r.full,hash(r.bytes)]);}
+   const relative='data/metrics/facts/aliexpress';let names=[];
+   try{const dir=realpathSync(path.join(root,relative));if(!inside(root,dir))fail('CONTEXT_CHANGED');names=readdirSync(dir).filter(n=>n.endsWith('.jsonl')).sort();}catch(e){if(e.code!=='ENOENT')throw e;}
+   if(names.length>100)fail('CONTEXT_CHANGED');let total=0;
+   for(const name of names){const r=read(relative+'/'+name,1048576);total+=r.bytes.length;if(total>5*1048576)fail('CONTEXT_CHANGED');rows.push([name,r.full,hash(r.bytes)]);}
+   return hash(JSON.stringify(rows));
+  }catch{fail('CONTEXT_CHANGED');}
+ }
+ function briefSignature(){
+  try{
+   const data=realpathSync(path.join(root,'data'));if(!inside(root,data))fail('REVIEW_SOURCE_UNAVAILABLE');
+   const manifest=read('data/ceo-operating/brief-manifest.json',8192,data),parsed=JSON.parse(manifest.bytes.toString('utf8')),rows=[[manifest.full,hash(manifest.bytes)]];
+   for(const key of ['baseline','plan']){const relative=parsed.sources?.[key]?.path;if(typeof relative!=='string'||relative.length>500||!relative.startsWith('data/')||!relative.endsWith('.json')||relative.includes('\\')||path.isAbsolute(relative)||path.win32.isAbsolute(relative)||relative.split('/').some(p=>p==='..'||p==='.'))fail('REVIEW_SOURCE_UNAVAILABLE');const r=read(relative,262144,data);rows.push([relative,r.full,hash(r.bytes)]);}
+   return hash(JSON.stringify(rows));
+  }catch{fail('REVIEW_SOURCE_UNAVAILABLE');}
+ }
+ const context=contextSignature(),brief=briefSignature();
+ return()=>{if(contextSignature()!==context)fail('CONTEXT_CHANGED');let current;try{current=briefSignature();}catch{fail('REVIEW_SOURCE_CHANGED');}if(current!==brief)fail('REVIEW_SOURCE_CHANGED');};
+}
diff --git a/dist/src/ceo-review-replanning.js b/dist/src/ceo-review-replanning.js
