+import { loadCeoOperatingContext } from '../dist/src/ceo-operating-context.js';
+import { CeoDraftWorkspace } from '../dist/src/ceo-draft-workspace.js';
+
+const codes=new Set(['INVALID_ARGUMENTS','INVALID_INPUT','INVALID_CONFIG','INVALID_SOURCE','SOURCE_LIMIT','UNSAFE_SOURCE','CONTEXT_CHANGED','INVALID_CONTEXT','INVALID_DECISION','INVALID_DB_PATH','GOAL_VERSION_CONFLICT','DECISION_VERSION_CONFLICT','DECISION_CONTEXT_CONFLICT','PLAN_VERSION_CONFLICT','STORAGE_FAILED']);
+function fail(code){const e=new Error(code);e.code=code;throw e;}
+async function main(argv){
+ let workspace;
+ try {
+  const [command,...rest]=argv,opts={};
+  const expected=command==='inspect'?['--root']:command==='save-draft'?['--root','--db','--input','--expected-context']:null;
+  if(!expected||rest.length!==expected.length*2)fail('INVALID_ARGUMENTS');
+  for(let i=0;i<rest.length;i+=2){if(!expected.includes(rest[i])||Object.hasOwn(opts,rest[i])||!rest[i+1])fail('INVALID_ARGUMENTS');opts[rest[i]]=rest[i+1];}
+  const context=await loadCeoOperatingContext({projectRoot:opts['--root']});
+  if(command==='inspect'){console.log(JSON.stringify(context));return;}
+  if(context.contextId!==opts['--expected-context'])fail('CONTEXT_CHANGED');
+  let input;
+  try {
+   if((await stat(opts['--input'])).size>1048576)fail('INVALID_INPUT');
+   const bytes=await readFile(opts['--input']);if(bytes.length>1048576)fail('INVALID_INPUT');
+   input=JSON.parse(bytes.toString('utf8'));
+  } catch {fail('INVALID_INPUT');}
+  if(!input||Array.isArray(input)||Object.keys(input).length!==2||!Object.hasOwn(input,'decision')||!Object.hasOwn(input,'candidates'))fail('INVALID_INPUT');
