diff --git a/dist/src/ceo-daily-plan.js b/dist/src/ceo-daily-plan.js
new file mode 100644
index 0000000..94c21a8
--- /dev/null
+++ b/dist/src/ceo-daily-plan.js
@@ -0,0 +1,151 @@
+import { createHash } from "node:crypto";
+import { validateCeoDecision } from "./ceo-decision-contract.js";
+
+const object = value => value !== null && typeof value === "object" && !Array.isArray(value);
+const text = value => typeof value === "string" && value.trim().length > 0;
+const rank = { HARD: 0, GOAL: 1, OPTIONAL: 2 };
+const compareText = (a, b) => a < b ? -1 : a > b ? 1 : 0;
+const sameStore = (a, b) => a?.platform === b?.platform && a?.environmentId === b?.environmentId;
+
+function reject(code) {
+  const error = new Error(`Cannot build daily draft: ${code}`);
+  error.code = code;
+  throw error;
+}
+
+function canonical(value) {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (object(value)) return Object.fromEntries(Object.keys(value).sort().map(key => [key, canonical(value[key])]));
+  return value;
+}
+
+function normalizedInputs(goal, decision, facts, candidates) {
+  const byId = key => (a, b) => compareText(a[key], b[key]);
+  const refs = values => [...values].sort((a, b) => compareText(JSON.stringify(canonical(a)), JSON.stringify(canonical(b))));
+  return canonical({
+    goal: { ...goal, targets: [...goal.targets].sort(byId("targetId")) },
+    decision: { ...decision,
+      options: refs(decision.options || []), evidenceRefs: refs(decision.evidenceRefs || []),
+      affectsTargets: [...(decision.affectsTargets || [])].sort(),
+      claims: (decision.claims || []).map(claim => ({ ...claim, evidenceBindings: refs(claim.evidenceBindings || []) })).sort(byId("claimId")),
+      assumptions: [...(decision.assumptions || [])].sort(), stopConditions: [...(decision.stopConditions || [])].sort(),
+    },
+    facts: [...facts].sort(byId("factId")),
+    candidates: candidates.map(task => ({ ...task, dependsOn: [...task.dependsOn].sort(), requiresEvidence: refs(task.requiresEvidence) })).sort(byId("taskId")),
+  });
+}
+
+/** Capacity-only draft for a single operator's proposed contiguous work period. No persistence or execution. */
+export function buildDailyPlan({ goal, decision, facts, candidates, existingDependencies=[], contextId, now = new Date() } = {}) {
+  const started = performance.now();
+  const checkBudget = () => { if (performance.now() - started > 60000) reject("BUDGET_EXCEEDED"); };
+  if (!object(goal) || !object(decision) || !Array.isArray(facts) || !Array.isArray(candidates) || !(now instanceof Date) || !Number.isFinite(now.getTime())) reject("INVALID_INPUT");
+  try { if (!goal.period?.timeZone) reject("INVALID_INPUT"); new Intl.DateTimeFormat("en", { timeZone: goal.period.timeZone }); } catch { reject("INVALID_INPUT"); }
+  if (candidates.length > 20) reject("TASK_LIMIT_EXCEEDED");
+  if(!Array.isArray(existingDependencies)||existingDependencies.length>100)reject('INVALID_DEPENDENCY');
+  const external=new Map(existingDependencies.map(t=>[t.taskId,t]));
+  const validation = validateCeoDecision(decision, { goal, facts, now });
+  checkBudget();
+  if (!text(goal.goalId) || !Array.isArray(goal.targets) || !goal.period?.timeZone) reject("INVALID_INPUT");
+  const tasksById = new Map();
+  for (const task of candidates) {
+    if (!object(task) || !text(task.taskId) || !text(task.actionId) || !text(task.title) || !text(task.acceptance)
+        || !object(task.storeRef) || !text(task.storeRef.platform) || !text(task.storeRef.environmentId)
+        || !["INVESTIGATION", "ACTION"].includes(task.mode) || !Object.hasOwn(rank, task.priorityClass)
+        || !Array.isArray(task.dependsOn) || !task.dependsOn.every(text) || !Array.isArray(task.requiresEvidence)
+        || !task.requiresEvidence.every(ref => object(ref) && text(ref.factId) && Number.isSafeInteger(ref.version) && ref.version > 0)) reject("INVALID_TASK");
+    if (tasksById.has(task.taskId)) reject("DUPLICATE_TASK");
+    if (task.dependsOn.length > 20 || new Set(task.dependsOn).size !== task.dependsOn.length) reject("INVALID_DEPENDENCY");
+    if (!Number.isSafeInteger(task.estimatedMinutes) || task.estimatedMinutes <= 0) reject("INVALID_DURATION");
+    if (task.deadline !== null && (typeof task.deadline !== "string" || !/(?:Z|[+-]\d{2}:\d{2})$/i.test(task.deadline) || !Number.isFinite(Date.parse(task.deadline)))) reject("INVALID_DEADLINE");
+    tasksById.set(task.taskId, task);
+  }
+  const visiting = new Set(), visited = new Set(), dependencyOrder = [];
+  const visit = id => {
+    checkBudget();
+    if(!tasksById.has(id)&&external.has(id))return;
+    if (visiting.has(id) || !tasksById.has(id)) reject("INVALID_DEPENDENCY");
+    if (visited.has(id)) return;
+    visiting.add(id);
+    for (const dependency of tasksById.get(id).dependsOn) visit(dependency);
+    visiting.delete(id); visited.add(id); dependencyOrder.push(id);
+  };
+  for (const id of tasksById.keys()) visit(id);
+  const capacity = goal.capacityMinutes, buffer = goal.bufferMinutes;
+  if ((capacity != null && (!Number.isSafeInteger(capacity) || capacity < 0))
+      || (buffer != null && (!Number.isSafeInteger(buffer) || buffer < 0))
+      || (capacity != null && buffer != null && buffer > capacity)) reject("INVALID_CAPACITY");
+  const availableMinutes = capacity == null || buffer == null ? null : capacity - buffer;
+  const warnings = [...validation.errors];
+  if (availableMinutes === null) warnings.push({ code: "CAPACITY_NOT_CONFIRMED", path: "/goal/capacity" });
+  const tasks = [], deferred = [], blocked = [], disposition = new Map();
+  const factMap = new Map(facts.filter(object).map(fact => [fact.factId, fact]));
+  const baseReason = task => {
+    if (validation.readiness === "INVALID") return "INVALID_DECISION";
+    if (validation.readiness === "NEEDS_CONFIRMATION") return "NEEDS_CONFIRMATION";
+    if (decision.conclusion === "NO_ACTION") return "NO_ACTION_SELECTED";
+    if (!sameStore(task.storeRef, goal.storeRef)) return "STORE_MISMATCH";
+    if (task.actionId !== decision.chosenActionId) return "NOT_SELECTED_ACTION";
+    if (validation.readiness === "NEEDS_EVIDENCE" && task.mode !== "INVESTIGATION") return "NEEDS_EVIDENCE";
+    if (task.requiresEvidence.some(ref => {
+      const fact = factMap.get(ref.factId);
+      return !fact || fact.version !== ref.version || fact.quality !== "USABLE" || fact.value === null
+        || Date.parse(fact.observedAt) > now.getTime() || !fact.coverage?.complete || fact.coverage?.ratio !== 1 || !sameStore(fact.storeRef, goal.storeRef);
+    })) return "MISSING_REQUIRED_EVIDENCE";
+    if(task.dependsOn.some(id=>!tasksById.has(id)&&external.has(id)&&!(external.get(id).status==='DONE'&&external.get(id).verification?.accepted===true&&external.get(id).contextId===contextId&&sameStore(external.get(id).definition?.storeRef,goal.storeRef))))return'DEPENDENCY_BLOCKED';
+    if (task.deadline && Date.parse(task.deadline) <= now.getTime()) return "DEADLINE_PASSED";
+    return null;
+  };
+  const initialReasons = new Map(candidates.map(task => [task.taskId, baseReason(task)]));
+  // A hard milestone lends urgency to its prerequisites instead of starving behind unrelated work.
+  const scores = new Map(candidates.map(task => [task.taskId, [rank[task.priorityClass], task.deadline ? Date.parse(task.deadline) : Infinity]]));
+  for (const id of [...dependencyOrder].reverse()) {
+    checkBudget();
+    if (initialReasons.get(id)) continue;
+    const score = scores.get(id);
+    for (const dependency of tasksById.get(id).dependsOn) {
+      checkBudget();
+      const own = scores.get(dependency);
+      if(!own)continue;
+      if (score[0] < own[0] || (score[0] === own[0] && score[1] < own[1])) scores.set(dependency, score);
+    }
+  }
+  const remaining = new Set(tasksById.keys());
+  let usedMinutes = 0;
+  while (remaining.size) {
+    checkBudget();
+    const ready = [...remaining].filter(id => tasksById.get(id).dependsOn.every(dependency => !remaining.has(dependency)));
+    ready.sort((a, b) => scores.get(a)[0] - scores.get(b)[0] || (scores.get(a)[1] === scores.get(b)[1] ? 0 : scores.get(a)[1] - scores.get(b)[1]) || compareText(a, b));
+    const id = ready[0];
+    if (!id) reject("INVALID_DEPENDENCY");
+    remaining.delete(id);
+    const task = tasksById.get(id);
+    let reason = initialReasons.get(id), bucket = "blocked";
+    if (!reason && task.dependsOn.some(dependency => disposition.get(dependency) === "blocked")) reason = "DEPENDENCY_BLOCKED";
+    if (!reason && task.dependsOn.some(dependency => disposition.get(dependency) === "deferred")) { reason = "DEPENDENCY_DEFERRED"; bucket = "deferred"; }
+    if (!reason && availableMinutes === null) { reason = "CAPACITY_NOT_CONFIRMED"; bucket = "deferred"; }
+    if (!reason && task.deadline && now.getTime() + (usedMinutes + task.estimatedMinutes) * 60000 > Date.parse(task.deadline)) reason = "DEADLINE_UNACHIEVABLE";
+    if (!reason && usedMinutes + task.estimatedMinutes > availableMinutes) { reason = "CAPACITY_EXCEEDED"; bucket = "deferred"; }
+    if (reason) {
+      (bucket === "blocked" ? blocked : deferred).push({ ...task, reason });
+      disposition.set(id, bucket);
+    } else {
+      tasks.push({ ...task }); usedMinutes += task.estimatedMinutes; disposition.set(id, "tasks");
+    }
+  }
+  blocked.sort((a, b) => compareText(a.taskId, b.taskId)); deferred.sort((a, b) => compareText(a.taskId, b.taskId));
+  const invalid = ["INVALID", "NEEDS_CONFIRMATION"].includes(validation.readiness);
+  const commitment = availableMinutes === null || invalid ? "UNCOMMITTED" : "WITHIN_CAPACITY";
+  const parts = Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: goal.period.timeZone, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(now).map(part => [part.type, part.value]));
+  const planDate = `${parts.year}-${parts.month}-${parts.day}`;
+  const normalized = ["VALIDATED", "NEEDS_EVIDENCE"].includes(validation.readiness)
+    ? normalizedInputs(goal, decision, facts, candidates) : canonical({ goal, decision, facts, candidates });
+  const usedExternal=[...new Set(candidates.flatMap(t=>t.dependsOn).filter(id=>!tasksById.has(id)&&external.has(id)))].sort().map(id=>{const t=external.get(id);return{taskId:id,version:t.version,status:t.status,contextId:t.contextId,verified:t.verification?.accepted===true};});
+  const fingerprint = canonical({ inputs: normalized, planDate, readiness: validation.readiness,
+    ...(usedExternal.length?{externalDependencies:usedExternal}:{}),
+    allocation: { tasks: tasks.map(task => task.taskId), deferred: deferred.map(task => [task.taskId, task.reason]), blocked: blocked.map(task => [task.taskId, task.reason]) } });
+  const planId = `ceo_plan_${createHash("sha256").update(JSON.stringify(fingerprint)).digest("hex").slice(0, 24)}`;
+  checkBudget();
+  return { schema: "ceo-daily-plan/v1", planId, status: "DRAFT", goalId: goal.goalId, goalVersion: goal.version, decisionId: decision.decisionId,
+    commitment, tasks, deferred, blocked, capacity: { availableMinutes, usedMinutes }, warnings };
+}
diff --git a/dist/src/ceo-daily-review.js b/dist/src/ceo-daily-review.js
new file mode 100644
index 0000000..6e5ae78
--- /dev/null
+++ b/dist/src/ceo-daily-review.js
@@ -0,0 +1,33 @@
+import {ceoContentHash} from './ceo-operating-context.js';
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const states=new Set(['PROPOSED','READY','RUNNING','PENDING_VERIFICATION','DONE','BLOCKED','FAILED']);
+const iso=v=>typeof v==='string'&&/(Z|[+-]\d{2}:\d{2})$/.test(v)&&Number.isFinite(Date.parse(v));
+function dateAt(now,zone){const p=Object.fromEntries(new Intl.DateTimeFormat('en',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(now).map(p=>[p.type,p.value]));return `${p.year}-${p.month}-${p.day}`;}
+function reason(task,context,now){
+ if(task.receipt?.outcome==='UNKNOWN')return'RECONCILE_UNKNOWN';
+ if(task.status==='PENDING_VERIFICATION')return'VERIFY_RECEIPT';
+ if(task.status==='RUNNING')return'WAIT_FOR_RECEIPT';
+ if(task.status==='DONE')return task.verification?.accepted===true?'OBSERVE_EFFECT':'VERIFY_RECEIPT';
+ if(task.contextId!==context.contextId)return'REASSESS_CONTEXT';
+ if(!iso(task.reviewAt)||Date.parse(task.reviewAt)<=now.getTime()||(task.definition.deadline&&(!iso(task.definition.deadline)||Date.parse(task.definition.deadline)<=now.getTime())))return'REASSESS_DECISION';
+ if(task.status==='READY'&&(!iso(task.approval?.expiresAt)||Date.parse(task.approval.expiresAt)<=now.getTime()))return'REASSESS_APPROVAL';
+ if(task.status==='FAILED'||task.status==='BLOCKED')return'REASSESS_BLOCKER';
+ return'AWAIT_APPROVAL';
+}
+
+// Snapshot of original tasks, never a claim that a particular day's actions occurred.
+export function buildCeoDailyReview({brief,context,tasks,date,note,actor,operationId,now=new Date()}){
+ if(actor?.role!=='owner'||actor.storeId!=='400370')fail('FORBIDDEN');
+ if(!(now instanceof Date)||!Number.isFinite(now.getTime()))fail('INVALID_TIME');
+ if(brief?.status!=='AVAILABLE'||brief.readOnly!==true||brief.plan?.isExpired||!/^[a-f0-9]{64}$/.test(brief.sourceId??'')||!Array.isArray(brief.days)||!brief.days.length)fail('REVIEW_SOURCE_UNAVAILABLE');
+ const today=dateAt(now,context.goal.period.timeZone),day=brief.days.find(d=>d.date===date);
+ if(today>brief.days.at(-1).date)fail('REVIEW_SOURCE_UNAVAILABLE');
+ if(typeof date!=='string'||!day||date>today)fail('INVALID_REVIEW_DATE');
+ if(typeof note!=='string'||!note.trim()||note.length>2000)fail('INVALID_INPUT');
+ const ids=[...new Set(day.actions.map(a=>a.sourceTaskRef))];if(!ids.length||ids.length>3)fail('INVALID_INPUT');
+ const selected=ids.map(id=>{const task=tasks.find(t=>t.taskId===id);if(!task)fail('TASK_NOT_FOUND');if(task.definition?.storeRef?.environmentId!=='400370')fail('FORBIDDEN');if(!states.has(task.status))fail('INVALID_INPUT');return task;});
+ const next=brief.days[brief.days.indexOf(day)+1];
+ return{schema:'ceo-daily-review/v1',reviewId:'ceo_review_'+ceoContentHash({actorId:actor.id,operationId}).slice(0,32),operationId,storeId:'400370',date,createdAt:now.toISOString(),actorId:actor.id,goalId:context.goal.goalId,goalVersion:context.goal.version,contextId:context.contextId,sourceId:brief.sourceId,note:note.trim(),dailyActionCompletionVerified:false,businessEffectStatus:'PENDING_OBSERVATION',
+  taskSnapshots:selected.map(t=>({taskId:t.taskId,title:t.definition.title,status:t.status,version:t.version,attempt:t.attempt,receipt:t.receipt?{outcome:t.receipt.outcome,summary:t.receipt.summary,at:t.receipt.at,evidenceCount:t.receipt.evidence?.length??0}:null,verification:t.verification?{accepted:t.verification.accepted,note:t.verification.note,at:t.verification.at}:null})),
+  handoff:{scheduled:false,nextDate:next?.date??null,nextTheme:next?.theme??null,candidates:selected.map(t=>({taskId:t.taskId,reason:reason(t,context,now)}))}};
+}
diff --git a/dist/src/ceo-decision-contract.js b/dist/src/ceo-decision-contract.js
new file mode 100644
index 0000000..131c2ca
--- /dev/null
+++ b/dist/src/ceo-decision-contract.js
@@ -0,0 +1,172 @@
+import { readFileSync } from "node:fs";
+import Ajv2020 from "ajv/dist/2020.js";
+import addFormats from "ajv-formats";
+
+const ajv = new Ajv2020({ allErrors: true, strict: true });
+addFormats(ajv);
+const validateShape = ajv.compile(JSON.parse(readFileSync(new URL("../../schemas/ceo-decision.schema.json", import.meta.url), "utf8")));
+const PROFIT_TARGET = "monthly-operating-profit-ex-quality-penalty";
+const object = value => value !== null && typeof value === "object" && !Array.isArray(value);
+const text = value => typeof value === "string" && value.trim().length > 0;
+const version = value => Number.isSafeInteger(value) && value > 0;
+const timestamp = value => text(value) && /(?:Z|[+-]\d{2}:\d{2})$/i.test(value) && Number.isFinite(Date.parse(value));
+const sameStore = (a, b) => a?.platform === b?.platform && a?.environmentId === b?.environmentId;
+const store = value => object(value) && text(value.platform) && text(value.environmentId);
+const referenceKey = value => JSON.stringify([value.factId, value.version]);
+const period = value => object(value) && timestamp(value.start) && timestamp(value.end) && Date.parse(value.start) < Date.parse(value.end);
+const validDate = value => typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)
+  && Number.isFinite(Date.parse(`${value}T00:00:00Z`)) && new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value;
+
+function nextDate(date) {
+  const value = new Date(`${date}T00:00:00Z`);
+  value.setUTCDate(value.getUTCDate() + 1);
+  return value.toISOString().slice(0, 10);
+}
+
+function fitsWindow(value, target, goalPeriod) {
+  if (!period(value)) return false;
+  const formatter = new Intl.DateTimeFormat("en-CA", {
+    timeZone: goalPeriod.timeZone, year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23",
+  });
+  const local = time => {
+    const parts = Object.fromEntries(formatter.formatToParts(new Date(time)).map(part => [part.type, part.value]));
+    return { date: `${parts.year}-${parts.month}-${parts.day}`, midnight: parts.hour === "00" && parts.minute === "00" && parts.second === "00" };
+  };
+  const start = local(value.start), end = local(value.end);
+  if (!start.midnight || !end.midnight || start.date < goalPeriod.fromDate || end.date > nextDate(goalPeriod.toDate)) return false;
+  if (target.window === "DAY") return nextDate(start.date) === end.date;
+  const nextMonth = new Date(`${start.date}T00:00:00Z`);
+  nextMonth.setUTCMonth(nextMonth.getUTCMonth() + 1, 1);
+  return start.date.endsWith("-01") && nextMonth.toISOString().slice(0, 10) === end.date;
+}
+
+function observationPending(claim, target, goalPeriod, now) {
+  if (claim.claimType !== "TARGET_ASSESSMENT") return false;
+  if (claim.period !== null) return fitsWindow(claim.period, target, goalPeriod) && Date.parse(claim.period.end) > now.getTime();
+  const parts = Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: goalPeriod.timeZone, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(now).map(part => [part.type, part.value]));
+  const date = `${parts.year}-${parts.month}-${parts.day}`;
+  return date < goalPeriod.fromDate || (target.window === "MONTH" && date <= goalPeriod.toDate);
+}
+
+function validFact(fact) {
+  return object(fact) && text(fact.factId) && version(fact.version) && store(fact.storeRef)
+    && text(fact.caliber) && text(fact.unit) && (fact.value === null || (typeof fact.value === "number" && Number.isFinite(fact.value)))
+    && period(fact.period) && timestamp(fact.observedAt) && ["USABLE", "INCOMPLETE"].includes(fact.quality)
+    && object(fact.coverage) && typeof fact.coverage.complete === "boolean"
+    && typeof fact.coverage.ratio === "number" && fact.coverage.ratio >= 0 && fact.coverage.ratio <= 1;
+}
+
+/** Validate draft consistency against caller-supplied authoritative goal/facts. Never authorizes or executes an action. */
+export function validateCeoDecision(decision, { goal, facts, now = new Date() } = {}) {
+  const issues = [];
+  const add = (level, code, path) => {
+    if (!issues.some(item => item.code === code && item.path === path)) issues.push({ level, code, path });
+  };
+  const result = () => {
+    const readiness = issues.some(i => i.level === "INVALID") ? "INVALID"
+      : issues.some(i => i.level === "CONFIRM") ? "NEEDS_CONFIRMATION"
+        : issues.length ? "NEEDS_EVIDENCE" : "VALIDATED";
+    return { ok: readiness === "VALIDATED", readiness, errors: issues.map(({ code, path }) => ({ code, path })) };
+  };
+  if (!object(goal) || !text(goal.goalId) || !Array.isArray(goal.targets) || !goal.targets.length) {
+    add("CONFIRM", "MISSING_GOAL", "/goal"); return result();
+  }
+  let validZone = false;
+  try { new Intl.DateTimeFormat("en", { timeZone: goal.period?.timeZone }); validZone = text(goal.period?.timeZone); } catch { /* invalid zone */ }
+  if (goal.schema !== "ceo-goal/v1" || !version(goal.version) || !store(goal.storeRef)
+      || !validZone || !validDate(goal.period?.fromDate) || !validDate(goal.period?.toDate) || goal.period.fromDate > goal.period.toDate
+      || !(now instanceof Date) || !Number.isFinite(now.getTime()) || !Array.isArray(facts) || facts.length > 200 || !facts.every(validFact)) {
+    add("INVALID", "INVALID_CONTEXT", "/context"); return result();
+  }
+  const targets = new Map();
+  for (const target of goal.targets) {
+    if (!object(target) || !text(target.targetId) || targets.has(target.targetId) || !["DAY", "MONTH"].includes(target.window)) {
+      add("INVALID", "INVALID_CONTEXT", "/goal/targets"); continue;
+    }
+    targets.set(target.targetId, target);
+    if (typeof target.value !== "number" || !Number.isFinite(target.value) || !text(target.unit)) add("CONFIRM", "MISSING_TARGET_DEFINITION", `/goal/targets/${target.targetId}`);
+    if (target.metricStatus !== "VERIFIED" || !text(target.caliber)) add("EVIDENCE", "METRIC_UNVERIFIED", `/goal/targets/${target.targetId}`);
+    if (target.targetId === PROFIT_TARGET && target.caliber === "sales.amount.net") add("INVALID", "CALIBER_MISMATCH", `/goal/targets/${target.targetId}/caliber`);
+    if (target.targetId === "daily-paid-items" && target.caliber && target.caliber !== "sales.qty.total") add("INVALID", "CALIBER_MISMATCH", `/goal/targets/${target.targetId}/caliber`);
+  }
+  if (issues.some(i => i.level === "INVALID")) return result();
+  if (!validateShape(decision)) {
+    for (const error of validateShape.errors || []) add("INVALID", "INVALID_DECISION", error.instancePath || "/decision");
+    return result();
+  }
+  if (decision.goalId !== goal.goalId) add("INVALID", "GOAL_MISMATCH", "/goalId");
+  if (decision.goalVersion !== goal.version) add("INVALID", "STALE_GOAL", "/goalVersion");
+  if (!sameStore(decision.storeRef, goal.storeRef)) add("INVALID", "STORE_MISMATCH", "/storeRef");
+  if (decision.policyVersion !== "ceo-policy/v1") add("INVALID", "UNSUPPORTED_POLICY", "/policyVersion");
+  if (!timestamp(decision.reviewAt)) add("INVALID", "INVALID_DECISION", "/reviewAt");
+  else if (Date.parse(decision.reviewAt) <= now.getTime()) add("INVALID", "EXPIRED_DECISION", "/reviewAt");
+  if (goal.deadline != null && !timestamp(goal.deadline)) add("INVALID", "INVALID_CONTEXT", "/goal/deadline");
+
+  const ids = new Set(), descriptions = new Set();
+  for (const option of decision.options) {
+    const description = option.description.trim().toLowerCase();
+    if (ids.has(option.actionId) || descriptions.has(description)) add("INVALID", "DUPLICATE_OPTION", "/options");
+    ids.add(option.actionId); descriptions.add(description);
+  }
+  if (decision.conclusion === "NO_ACTION") {
+    if (decision.chosenActionId !== null) add("INVALID", "UNKNOWN_ACTION", "/chosenActionId");
+  } else if (!ids.has(decision.chosenActionId)) add("INVALID", "UNKNOWN_ACTION", "/chosenActionId");
+  for (const targetId of decision.affectsTargets) if (!targets.has(targetId)) add("INVALID", "UNKNOWN_TARGET", "/affectsTargets");
+
+  const factMap = new Map();
+  for (const fact of facts) {
+    if (factMap.has(fact.factId)) add("INVALID", "AMBIGUOUS_FACT", `/facts/${fact.factId}`);
+    factMap.set(fact.factId, fact);
+  }
+  const resolve = (ref, path) => {
+    const fact = factMap.get(ref.factId);
+    if (!fact) { add("INVALID", "UNKNOWN_FACT", path); return null; }
+    if (fact.version !== ref.version) { add("INVALID", "STALE_FACT", path); return null; }
+    if (!sameStore(fact.storeRef, goal.storeRef)) add("INVALID", "STORE_MISMATCH", path);
+    if (Date.parse(fact.observedAt) > now.getTime()) add("INVALID", "FACT_FROM_FUTURE", path);
+    if (fact.quality !== "USABLE" || fact.value === null || !fact.coverage.complete || fact.coverage.ratio < 1) add("EVIDENCE", "INCOMPLETE_FACT", path);
+    return fact;
+  };
+  const declared = new Set(decision.evidenceRefs.map(referenceKey));
+  decision.evidenceRefs.forEach((ref, index) => resolve(ref, `/evidenceRefs/${index}`));
+  const assessed = new Set(), claimIds = new Set();
+  let pendingObservation = false;
+  for (const [index, claim] of decision.claims.entries()) {
+    const claimPath = `/claims/${index}`, target = targets.get(claim.targetId);
+    if (claimIds.has(claim.claimId)) add("INVALID", "DUPLICATE_CLAIM", claimPath);
+    claimIds.add(claim.claimId);
+    if (!target) { add("INVALID", "UNKNOWN_TARGET", claimPath); continue; }
+    if (claim.claimType === "TARGET_ASSESSMENT") assessed.add(claim.targetId);
+    if (claim.verdict === "INSUFFICIENT_EVIDENCE") add("EVIDENCE", "INSUFFICIENT_EVIDENCE", claimPath);
+    if (claim.verdict === "PENDING_OBSERVATION") {
+      pendingObservation = true;
+      if (!observationPending(claim, target, goal.period, now)) add("INVALID", "OBSERVATION_ALREADY_DUE", claimPath);
+    }
+    if (claim.claimType === "ACTION_BASIS" && claim.actionId !== decision.chosenActionId) add("INVALID", "UNSELECTED_ACTION_BASIS", claimPath);
+    if (claim.verdict === "SUPPORTED" && (!text(claim.caliber) || !text(claim.unit) || !period(claim.period))) add("INVALID", "INVALID_DECISION", claimPath);
+    if (claim.claimType === "TARGET_ASSESSMENT" && claim.verdict === "SUPPORTED") {
+      if ((target.caliber && claim.caliber !== target.caliber) || (target.unit && claim.unit !== target.unit)) add("INVALID", "CALIBER_MISMATCH", claimPath);
+      if (!fitsWindow(claim.period, target, goal.period)) add("INVALID", "WINDOW_MISMATCH", claimPath);
+      if (!claim.evidenceBindings.some(binding => binding.role === "PRIMARY_METRIC")) add("EVIDENCE", "MISSING_PRIMARY_EVIDENCE", claimPath);
+    }
+    if (claim.claimType === "ACTION_BASIS" && claim.verdict === "SUPPORTED" && !claim.evidenceBindings.some(binding => binding.role === "PRIMARY_METRIC")) add("EVIDENCE", "MISSING_PRIMARY_EVIDENCE", claimPath);
+    if (claim.verdict === "SUPPORTED" && !claim.evidenceBindings.length) add("EVIDENCE", "INSUFFICIENT_EVIDENCE", claimPath);
+    for (const [bindingIndex, binding] of claim.evidenceBindings.entries()) {
+      const bindingPath = `${claimPath}/evidenceBindings/${bindingIndex}`;
+      if (!declared.has(referenceKey(binding))) add("INVALID", "UNDECLARED_REFERENCE", bindingPath);
+      const fact = resolve(binding, bindingPath);
+      if (!fact || binding.role !== "PRIMARY_METRIC") continue;
+      if (fact.caliber !== claim.caliber || fact.unit !== claim.unit) add("INVALID", "CALIBER_MISMATCH", bindingPath);
+      if (!period(claim.period) || Date.parse(fact.period.start) !== Date.parse(claim.period.start) || Date.parse(fact.period.end) !== Date.parse(claim.period.end)) add("INVALID", "WINDOW_MISMATCH", bindingPath);
+      if (claim.targetId === PROFIT_TARGET) {
+        if (fact.coverage.costsReconciled !== true) add("EVIDENCE", "COSTS_UNRECONCILED", bindingPath);
+        if (fact.coverage.qualityPenaltiesExcluded !== true) add("EVIDENCE", "QUALITY_PENALTY_UNCONFIRMED", bindingPath);
+      }
+    }
+  }
+  if (pendingObservation && decision.conclusion !== "NO_ACTION" && !decision.claims.some(claim => claim.claimType === "ACTION_BASIS" && claim.verdict === "SUPPORTED" && claim.actionId === decision.chosenActionId && claim.evidenceBindings.some(binding => binding.role === "PRIMARY_METRIC"))) add("EVIDENCE", "MISSING_ACTION_BASIS", "/claims");
+  for (const targetId of targets.keys()) if (!assessed.has(targetId)) add("INVALID", "MISSING_TARGET_ASSESSMENT", "/claims");
+  if (decision.conclusion === "INSUFFICIENT_EVIDENCE") add("EVIDENCE", "INSUFFICIENT_EVIDENCE", "/conclusion");
+  return result();
+}
diff --git a/dist/src/ceo-draft-workspace.js b/dist/src/ceo-draft-workspace.js
new file mode 100644
index 0000000..bf5dae1
--- /dev/null
+++ b/dist/src/ceo-draft-workspace.js
@@ -0,0 +1,113 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import path from 'node:path';
+import { ceoContentHash, ceoContextId } from './ceo-operating-context.js';
+import { validateCeoDecision } from './ceo-decision-contract.js';
+import { buildDailyPlan } from './ceo-daily-plan.js';
+import {replanErrorCodes} from './ceo-review-replanning.js';
+
+function fail(code) { const e = new Error(code); e.code = code; throw e; }
+const domainCodes = new Set(['CONTEXT_CHANGED','INVALID_CONTEXT','INVALID_DECISION','GOAL_VERSION_CONFLICT','DECISION_VERSION_CONFLICT','DECISION_CONTEXT_CONFLICT','PLAN_VERSION_CONFLICT','REVIEW_SOURCE_CHANGED','REVIEW_SOURCE_UNAVAILABLE',...replanErrorCodes]);
+const entryId = v => typeof v === 'string' && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$/.test(v);
+export function ceoDraftEntryHash({entryRequest,expectedContextId,decision,candidates,requestBinding}){
+ if(!entryRequest||Object.keys(entryRequest).length!==3||!entryId(entryRequest.requestId)||typeof entryRequest.conversationRef!=='string'||!entryRequest.conversationRef.trim()||entryRequest.conversationRef.length>240||typeof entryRequest.actorId!=='string'||!entryRequest.actorId.trim()||entryRequest.actorId.length>120)fail('INVALID_INPUT');
+ return ceoContentHash({entryRequest,expectedContextId,decision,candidates,...(requestBinding?{requestBinding}:{})});
+}
+
+// Only the trusted local host supplies contexts; this is not a remotely exposed authentication boundary.
+export class CeoDraftWorkspace {
+  constructor({dbPath} = {}) {
+    if (typeof dbPath !== 'string' || !path.isAbsolute(dbPath)) fail('INVALID_DB_PATH');
+    this.dbPath = dbPath; this.db = null;
+  }
+  ready() {
+    if (this.db) return;
+    try {
+      mkdirSync(path.dirname(this.dbPath),{recursive:true});
+      this.db = new DatabaseSync(this.dbPath);
+      this.db.exec(`PRAGMA busy_timeout=5000; PRAGMA foreign_keys=ON;
+        CREATE TABLE IF NOT EXISTS ceo_goal_versions (
+          goal_id TEXT NOT NULL, version INTEGER NOT NULL, payload_hash TEXT NOT NULL,
+          payload_json TEXT NOT NULL, PRIMARY KEY(goal_id,version));
+        CREATE TABLE IF NOT EXISTS ceo_context_snapshots (
+          context_id TEXT PRIMARY KEY, goal_id TEXT NOT NULL, goal_version INTEGER NOT NULL,
+          payload_json TEXT NOT NULL, FOREIGN KEY(goal_id,goal_version) REFERENCES ceo_goal_versions(goal_id,version));
+        CREATE TABLE IF NOT EXISTS ceo_decision_versions (
+          decision_id TEXT PRIMARY KEY, context_id TEXT NOT NULL, payload_hash TEXT NOT NULL,
+          payload_json TEXT NOT NULL, FOREIGN KEY(context_id) REFERENCES ceo_context_snapshots(context_id));
+        CREATE TABLE IF NOT EXISTS ceo_plan_versions (
+          plan_id TEXT PRIMARY KEY, context_id TEXT NOT NULL, decision_id TEXT NOT NULL,
+          payload_hash TEXT NOT NULL, payload_json TEXT NOT NULL, candidates_json TEXT NOT NULL, created_at TEXT NOT NULL,
+          FOREIGN KEY(context_id) REFERENCES ceo_context_snapshots(context_id),
+          FOREIGN KEY(decision_id) REFERENCES ceo_decision_versions(decision_id));
+        CREATE TABLE IF NOT EXISTS ceo_entry_draft_requests (
+          request_id TEXT PRIMARY KEY, request_hash TEXT NOT NULL, result_json TEXT NOT NULL);`);
+    } catch { this.close(); fail('STORAGE_FAILED'); }
+  }
+  close() { this.db?.close(); this.db = null; }
+  getPlan(planId) {
+    this.ready();
+    try { const r=this.db.prepare('SELECT payload_json FROM ceo_plan_versions WHERE plan_id=?').get(planId); return r ? JSON.parse(r.payload_json) : null; }
+    catch { fail('STORAGE_FAILED'); }
+  }
+  getDraftRequest(requestId) {
+    if (!entryId(requestId)) fail('INVALID_INPUT');
+    this.ready();
+    try { const row=this.db.prepare('SELECT result_json FROM ceo_entry_draft_requests WHERE request_id=?').get(requestId); return row ? JSON.parse(row.result_json) : null; }
+    catch { fail('STORAGE_FAILED'); }
+  }
+  saveDraft({context,decision,candidates,expectedContextId,now=new Date(),entryRequest,requestBinding,finalizeDraft,existingDependencies=[]}) {
+    let entryHash;
+    const replay = () => {
+      const row=this.db.prepare('SELECT request_hash,result_json FROM ceo_entry_draft_requests WHERE request_id=?').get(entryRequest.requestId);
+      if (!row) return null;
+      if (row.request_hash!==entryHash) fail('OPERATION_CONFLICT');
+      return {...JSON.parse(row.result_json),replayed:true};
+    };
+    if (entryRequest !== undefined) {
+      entryHash=ceoDraftEntryHash({entryRequest,expectedContextId,decision,candidates,requestBinding});
+      this.ready();
+      const previous=replay();if(previous)return previous;
+    }
+    if (context?.schema !== 'ceo-operating-context/v1' || !Array.isArray(context.facts) || context.facts.length
+      || !Array.isArray(context.observations) || !Array.isArray(context.sourceManifest)
+      || !context.goal || !context.dictionaryHash || context.contextId !== ceoContextId(context)) fail('INVALID_CONTEXT');
+    if (context.contextId !== expectedContextId) fail('CONTEXT_CHANGED');
+    const validation=validateCeoDecision(decision,{goal:context.goal,facts:context.facts,now});
+    if (['INVALID','NEEDS_CONFIRMATION'].includes(validation.readiness)) fail('INVALID_DECISION');
+    let plan;
+    try { plan=buildDailyPlan({goal:context.goal,facts:context.facts,decision,candidates,now,existingDependencies,contextId:context.contextId}); }
+    catch { fail('INVALID_DECISION'); }
+    const goal=context.goal,goalHash=ceoContentHash(goal),decisionHash=ceoContentHash(decision),planHash=ceoContentHash(plan);
+    this.ready();
+    let transaction=false;
+    try {
+      this.db.exec('BEGIN IMMEDIATE');transaction=true;
+      if (entryRequest) {
+        const previous=replay();
+        if(previous){this.db.exec('COMMIT');transaction=false;return previous;}
+      }
+      const oldGoal=this.db.prepare('SELECT payload_hash FROM ceo_goal_versions WHERE goal_id=? AND version=?').get(goal.goalId,goal.version);
+      if (oldGoal && oldGoal.payload_hash!==goalHash) fail('GOAL_VERSION_CONFLICT');
+      this.db.prepare('INSERT OR IGNORE INTO ceo_goal_versions VALUES(?,?,?,?)').run(goal.goalId,goal.version,goalHash,JSON.stringify(goal));
+      this.db.prepare('INSERT OR IGNORE INTO ceo_context_snapshots VALUES(?,?,?,?)').run(context.contextId,goal.goalId,goal.version,JSON.stringify(context));
+      const oldDecision=this.db.prepare('SELECT payload_hash,context_id FROM ceo_decision_versions WHERE decision_id=?').get(decision.decisionId);
+      if (oldDecision && oldDecision.payload_hash!==decisionHash) fail('DECISION_VERSION_CONFLICT');
+      if (oldDecision && oldDecision.context_id!==context.contextId) fail('DECISION_CONTEXT_CONFLICT');
+      this.db.prepare('INSERT OR IGNORE INTO ceo_decision_versions VALUES(?,?,?,?)').run(decision.decisionId,context.contextId,decisionHash,JSON.stringify(decision));
+      const oldPlan=this.db.prepare('SELECT payload_hash,context_id FROM ceo_plan_versions WHERE plan_id=?').get(plan.planId);
+      if (oldPlan && (oldPlan.payload_hash!==planHash || oldPlan.context_id!==context.contextId)) fail('PLAN_VERSION_CONFLICT');
+      if (!oldPlan) this.db.prepare('INSERT INTO ceo_plan_versions VALUES(?,?,?,?,?,?,?)').run(plan.planId,context.contextId,decision.decisionId,planHash,JSON.stringify(plan),JSON.stringify(candidates),now.toISOString());
+      let result={schema:'ceo-draft-receipt/v1',contextId:context.contextId,planId:plan.planId,status:'DRAFT',commitment:plan.commitment,created:!oldPlan,plan,
+        ...(entryRequest?{entry:entryRequest,externalExecution:false,replayed:false}:{})};
+      if(finalizeDraft)result=finalizeDraft(result);
+      if(entryRequest)this.db.prepare('INSERT INTO ceo_entry_draft_requests VALUES(?,?,?)').run(entryRequest.requestId,entryHash,JSON.stringify(result));
+      this.db.exec('COMMIT');transaction=false;
+      return result;
+    } catch (e) {
+      if (transaction) { try { this.db.exec('ROLLBACK'); } catch { /* Keep original failure; no success receipt. */ } }
+      if (domainCodes.has(e.code) || e.code==='OPERATION_CONFLICT') throw e;
+      fail('STORAGE_FAILED');
+    }
+  }
+}
diff --git a/dist/src/ceo-governance.js b/dist/src/ceo-governance.js
new file mode 100644
index 0000000..924401b
--- /dev/null
+++ b/dist/src/ceo-governance.js
@@ -0,0 +1,54 @@
+import {readFileSync} from 'node:fs';
+import {timingSafeEqual,createHash} from 'node:crypto';
+const policy=JSON.parse(readFileSync(new URL('../../config/ceo-capabilities.v1.json',import.meta.url),'utf8'));
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const canonical=v=>Array.isArray(v)?v.map(canonical):v&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,canonical(v[k])])):v;
+const hash=v=>createHash('sha256').update(JSON.stringify(canonical(v))).digest('hex');
+const sameToken=(a,b)=>{if(typeof a!=='string'||Buffer.byteLength(a)!==Buffer.byteLength(b))return false;return timingSafeEqual(Buffer.from(a),Buffer.from(b));};
+const safeReads=[/^\/api\/system\/state$/, /^\/api\/ceo\/(?:me|context|plans|tasks|daily-reviews|operating-brief|replanning-brief)$/, /^\/api\/ceo\/tasks\/[^/]+(?:\/evidence-check)?$/, /^\/api\/ceo\/draft-requests\/[^/]+$/];
+export function classifyCeoRequest(method,pathname){
+ if(method==='GET'&&['/healthz','/api/version'].includes(pathname))return 'public.read';
+ if(method==='GET'&&safeReads.some(re=>re.test(pathname)))return 'read';
+ if(method==='POST'&&pathname==='/api/ceo-shadow/feedback')return 'human.review';
+ if(method==='POST'&&pathname==='/api/ceo/vnext/shadow-analysis')return 'analyze';
+ if(method==='POST'&&pathname==='/api/ceo/import')return 'task.import';
+ if(method==='POST'&&/^\/api\/ceo\/tasks\/[^/]+\/commands$/.test(pathname))return 'task.command';
+ return 'unsafe';
+}
+export function createCeoGovernance({credentials,now=()=>Date.now(),maxOperations=10000,allowIsolatedHumanManual=false}={}){
+ if(!credentials||typeof credentials!=='object'||Array.isArray(credentials)||typeof now!=='function'||!Number.isSafeInteger(maxOperations)||maxOperations<1)fail('INVALID_CREDENTIALS');
+ const issued=new WeakSet(),revoked=new Set(),operations=new Map(),ids=new Set(),tokens=new Set();
+ const records=Object.entries(credentials).map(([key,c])=>{
+  const profile=c?.profile??'legacy',role=c?.role??(key==='owner'?'owner':'agent');
+  if(!c||typeof c.id!=='string'||!c.id||c.id.length>120||ids.has(c.id)||c.storeId!==policy.storeId||!Object.hasOwn(policy.profiles,profile)||!['owner','agent'].includes(role)||typeof c.token!=='string'||Buffer.byteLength(c.token)<32||Buffer.byteLength(c.token)>256||tokens.has(c.token)||(c.expiresAt!==undefined&&(!/(?:Z|[+-]\d{2}:\d{2})$/.test(c.expiresAt)||!Number.isFinite(Date.parse(c.expiresAt)))))fail('INVALID_CREDENTIALS');
+  ids.add(c.id);tokens.add(c.token);const principal=Object.freeze({id:c.id,role,profile,storeId:c.storeId,...(c.expiresAt?{expiresAt:c.expiresAt}:{})});issued.add(principal);
+  return{token:c.token,principal};
+ });
+ const grants=Object.fromEntries(Object.entries(policy.profiles).map(([k,v])=>[k,new Set(v)]));
+ if(allowIsolatedHumanManual===true)grants.human.add('human.manual');
+ function validate(principal){if(!issued.has(principal)||revoked.has(principal.id)||(principal.expiresAt&&Date.parse(principal.expiresAt)<=now()))fail('UNAUTHORIZED');}
+ function authenticateToken(token){const record=records.find(r=>sameToken(token,r.token));if(!record)fail('UNAUTHORIZED');validate(record.principal);return record.principal;}
+ function authorize({principal,operation,storeId=policy.storeId}){validate(principal);if(storeId!==principal.storeId||!grants[principal.profile].has(operation))fail('FORBIDDEN');return Object.freeze({allowed:true,policyVersion:policy.policyVersion,actorId:principal.id,operation,storeId});}
+ function reserveOperation({principal,operation,storeId,operationId,payload}){
+  authorize({principal,operation,storeId});if(typeof operationId!=='string'||!/^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$/.test(operationId))fail('INVALID_OPERATION');
+  const key=principal.id+':'+operationId,requestHash=hash({operation,storeId,payload}),old=operations.get(key);
+  if(old)fail(old===requestHash?'REPLAY_REJECTED':'OPERATION_CONFLICT');if(operations.size>=maxOperations)fail('OPERATION_LIMIT');operations.set(key,requestHash);
+ }
+ return Object.freeze({authenticateToken,authorize,reserveOperation,revoke:id=>revoked.add(id),policyVersion:policy.policyVersion});
+}
+export function createCeoGateway({governance,resolveOperation=()=>null}={}){
+ if(!governance)fail('GOVERNANCE_REQUIRED');
+ return(req,res,next)=>{
+  try{
+   const raw=req.originalUrl??req.url;if(typeof raw!=='string'||/%(?:2f|5c|00|2e)/i.test(raw)||raw.includes('\\'))fail('FORBIDDEN');
+   const url=new URL(raw,'http://localhost');if(url.search)fail('FORBIDDEN');
+   const classified=classifyCeoRequest(req.method,url.pathname),operation=classified==='unsafe'?(resolveOperation(req,url.pathname)??'unsafe'):classified;
+   if(operation==='public.read')return next();
+   const token=/^Bearer ([^\s]+)$/.exec(req.headers.authorization??'')?.[1],principal=governance.authenticateToken(token);
+   const requestedStore=req.body?.storeId??req.body?.storeRef?.environmentId??'400370';
+   governance.authorize({principal,operation,storeId:requestedStore});
+   if(req.method!=='GET')governance.reserveOperation({principal,operation,storeId:requestedStore,operationId:req.body?.operationId??req.body?.requestId,payload:{method:req.method,path:url.pathname,body:req.body}});
+   Object.defineProperty(req,'ceoPrincipal',{value:principal,writable:false});next();
+  }catch(e){const code=['UNAUTHORIZED','FORBIDDEN','INVALID_OPERATION','REPLAY_REJECTED','OPERATION_CONFLICT','OPERATION_LIMIT'].includes(e.code)?e.code:'FORBIDDEN';res.status(code==='UNAUTHORIZED'?401:code==='INVALID_OPERATION'?400:['REPLAY_REJECTED','OPERATION_CONFLICT','OPERATION_LIMIT'].includes(code)?409:403).json({error:code});}
+ };
+}
diff --git a/dist/src/ceo-isolated-runtime.js b/dist/src/ceo-isolated-runtime.js
new file mode 100644
index 0000000..16be1dd
--- /dev/null
+++ b/dist/src/ceo-isolated-runtime.js
@@ -0,0 +1,49 @@
+import http from 'node:http';
+import express from 'express';
+import path from 'node:path';
+import {readFile,realpath} from 'node:fs/promises';
+import {randomUUID} from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+import {createRuntimeManifest} from './ceo-runtime-manifest.js';
+import {acquireRuntimeLease,runtimeHealth,stopOwnedRuntime} from './ceo-runtime-host.js';
+import {createCeoGovernance,createCeoGateway} from './ceo-governance.js';
+
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+/** G1 fixture entry only. No database fallback, credentials discovery, browser or workflow dispatch. */
+export async function startIsolatedCeoRuntime({codeRoot,dataRoot,files,releaseId,credentials,queries={},feedback=null,bindingConfirmed=false,port=0,dependencies=[]}={}){
+ const root=await realpath(dataRoot);let marker;
+ try{marker=JSON.parse(await readFile(path.join(root,'.ceo-isolated-fixture.json'),'utf8'));}catch{fail('ISOLATED_FIXTURE_REQUIRED');}
+ if(marker.synthetic!==true||!Number.isSafeInteger(port)||port<0||port>65535||[3000,3173,8765,9223,9224].includes(port))fail('ISOLATED_FIXTURE_REQUIRED');
+ const manifest=await createRuntimeManifest({codeRoot,dataRoot:root,files,releaseId,mode:'SHADOW',storeId:'400370'});
+ const governance=createCeoGovernance({credentials});
+ const identity=Object.freeze({pid:process.pid,entryPath:fileURLToPath(import.meta.url),instanceId:randomUUID(),releaseId,startedAt:new Date().toISOString()});
+ const leasePath=path.join(root,'ceo-runtime.lease.json'),lease=await acquireRuntimeLease({leasePath,identity}),app=express();
+ app.disable('x-powered-by');app.use(express.json({limit:65536}));
+ app.use((_req,res,next)=>{res.setHeader('Cache-Control','no-store');res.setHeader('X-Content-Type-Options','nosniff');next();});
+ const health=()=>runtimeHealth({manifest,identity,dependencies,bindingConfirmed});
+ app.get('/healthz',async(_req,res)=>{try{const result=await health();res.status(result.ready?200:503).json(result);}catch{res.status(503).json({ready:false,error:'HEALTH_UNAVAILABLE'});}});
+ app.get('/api/version',async(_req,res)=>res.json(await health()));
+ app.use(createCeoGateway({governance}));
+ app.get('/api/ceo/me',(req,res)=>res.json({actor:req.ceoPrincipal,mode:'SHADOW',externalExecution:false}));
+ for(const [route,key]of [['/api/ceo/context','context'],['/api/ceo/tasks','tasks'],['/api/ceo/plans','plans'],['/api/system/state','state']])app.get(route,async(_req,res)=>{
+  if(typeof queries[key]!=='function'){res.status(503).json({error:'READ_MODEL_UNCONFIGURED'});return;}
+  try{res.json(await queries[key]());}catch{res.status(503).json({error:'READ_MODEL_UNAVAILABLE'});}
+ });
+ app.post('/api/ceo-shadow/feedback',async(req,res)=>{
+  if(typeof feedback!=='function'){res.status(503).json({error:'FEEDBACK_UNCONFIGURED'});return;}
+  try{res.json(await feedback({actor:req.ceoPrincipal,payload:structuredClone(req.body)}));}catch{res.status(503).json({error:'FEEDBACK_UNAVAILABLE'});}
+ });
+ app.use((_req,res)=>res.status(404).json({error:'NOT_FOUND'}));
