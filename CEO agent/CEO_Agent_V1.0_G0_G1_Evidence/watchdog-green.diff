--- /dev/null
+++ b/dist/src/ceo-review-replanning.js
@@ -0,0 +1,40 @@
+import {ceoContentHash} from './ceo-operating-context.js';
+export const replanErrorCodes=['REPLAN_NOT_READY','REPLAN_INPUT_CHANGED','REPLAN_BINDING_INVALID','REPLAN_IN_FLIGHT','REPLAN_REQUIRES_NEW_PLAN','PLAN_REVIEW_LINK_CONFLICT'];
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const object=v=>v!==null&&typeof v==='object'&&!Array.isArray(v);
+const exact=(v,keys)=>object(v)&&Object.keys(v).length===keys.length&&keys.every(k=>Object.hasOwn(v,k));
+const text=(v,n)=>typeof v==='string'&&v.trim().length>0&&v.length<=n;
+const choices=t=>t.receipt?.outcome==='UNKNOWN'||['RUNNING','PENDING_VERIFICATION'].includes(t.status)?['WAIT']:t.status==='DONE'?['OBSERVE']:['REPLAN','DEFER'];
+export const operatingTasks=tasks=>tasks.filter(t=>typeof t.taskId==='string'&&t.taskId.startsWith('store-400370-')&&t.definition?.storeRef?.environmentId==='400370').sort((a,b)=>a.taskId.localeCompare(b.taskId));
+
+export function buildCeoReplanningBrief({context,brief,reviews,tasks}){
+ const current=operatingTasks(tasks),review=reviews.find(r=>r.storeId==='400370')??null;
+ const reviewHash=review?ceoContentHash(review):null,expectedTaskVersions=Object.fromEntries(current.map(t=>[t.taskId,t.version]));
+ let status='AVAILABLE';
+ if(brief?.status!=='AVAILABLE'||brief.readOnly!==true||brief.plan?.isExpired)status='SOURCE_UNAVAILABLE';
+ else if(current.length>100)status='TASK_LIMIT';
+ else if(!review)status='NEEDS_REVIEW';
+ else if(review.contextId!==context.contextId||review.sourceId!==brief.sourceId||review.goalId!==context.goal.goalId||review.goalVersion!==context.goal.version)status='REVIEW_STALE';
+ const snapshots=new Map((review?.taskSnapshots??[]).map(t=>[t.taskId,t]));
+ const packetId=ceoContentHash({contextId:context.contextId,sourceId:brief?.sourceId??null,reviewHash,tasks:current,status});
+ return{schema:'ceo-replanning-brief/v1',status,canSubmit:status==='AVAILABLE',readOnly:true,contextId:context.contextId,sourceId:brief?.sourceId??null,packetId,reviewHash,goal:context.goal,gaps:context.gaps,
+  review:review?{reviewId:review.reviewId,date:review.date,createdAt:review.createdAt,note:review.note,dailyActionCompletionVerified:false}:null,
+  expectedTaskVersions,changedSinceReview:review?current.filter(t=>snapshots.get(t.taskId)?.version!==t.version||snapshots.get(t.taskId)?.status!==t.status).map(t=>t.taskId):[],
+  tasks:current.slice(0,100).map(t=>({taskId:t.taskId,title:t.definition.title,status:t.status,version:t.version,attempt:t.attempt,allowedChoices:choices(t),contextChanged:t.contextId!==context.contextId,reviewAt:t.reviewAt,
+   receipt:t.receipt?{outcome:t.receipt.outcome,summary:t.receipt.summary,at:t.receipt.at,evidenceCount:t.receipt.evidence?.length??0}:null})),businessEffectStatus:'PENDING_OBSERVATION',externalExecution:false};
+}
+
+export function validateReviewReplanBinding({packet,binding,candidates}){
+ if(!exact(binding,['reviewId','reviewHash','packetId','expectedTaskVersions','dispositions','rationale'])||!text(binding.rationale,2000)||!object(binding.expectedTaskVersions)||!Array.isArray(binding.dispositions)||binding.dispositions.length>100)fail('REPLAN_BINDING_INVALID');
+ if(!packet.canSubmit)fail(packet.status==='NEEDS_REVIEW'?'REPLAN_NOT_READY':'REPLAN_INPUT_CHANGED');
+ if(binding.reviewId!==packet.review.reviewId||binding.reviewHash!==packet.reviewHash||binding.packetId!==packet.packetId)fail('REPLAN_INPUT_CHANGED');
+ if(ceoContentHash(binding.expectedTaskVersions)!==ceoContentHash(packet.expectedTaskVersions))fail('REPLAN_BINDING_INVALID');
+ if(!Array.isArray(candidates)||candidates.length>20)fail('REPLAN_BINDING_INVALID');
+ const dispositions=new Map();
+ for(const d of binding.dispositions){if(!exact(d,['taskId','choice','reason'])||!text(d.reason,1000)||dispositions.has(d.taskId))fail('REPLAN_BINDING_INVALID');dispositions.set(d.taskId,d);}
+ if(dispositions.size!==packet.tasks.length)fail('REPLAN_BINDING_INVALID');
+ const candidateIds=new Set(candidates.map(c=>c.taskId));if(candidateIds.size!==candidates.length)fail('REPLAN_BINDING_INVALID');
+ for(const task of packet.tasks){const d=dispositions.get(task.taskId);if(!d)fail('REPLAN_BINDING_INVALID');if(!task.allowedChoices.includes(d.choice))fail(task.allowedChoices.includes('WAIT')?'REPLAN_IN_FLIGHT':'REPLAN_BINDING_INVALID');if((d.choice==='REPLAN')!==candidateIds.has(task.taskId))fail('REPLAN_BINDING_INVALID');}
+ if(candidates.some(c=>!packet.tasks.some(t=>t.taskId===c.taskId)))fail('REPLAN_BINDING_INVALID');
+ return{schema:'ceo-plan-review-link/v1',reviewId:binding.reviewId,reviewHash:binding.reviewHash,reviewDate:packet.review.date,packetId:binding.packetId,contextId:packet.contextId,sourceId:packet.sourceId,expectedTaskVersions:binding.expectedTaskVersions,dispositions:binding.dispositions,rationale:binding.rationale,scheduled:false,taskWritePerformed:false};
+}
diff --git a/dist/src/ceo-runtime-host.js b/dist/src/ceo-runtime-host.js
new file mode 100644
index 0000000..7ebabd2
--- /dev/null
+++ b/dist/src/ceo-runtime-host.js
@@ -0,0 +1,56 @@
+import http from 'node:http';
+import {open,readFile,stat,unlink,mkdir,rename,rmdir} from 'node:fs/promises';
+import path from 'node:path';
+import {randomUUID} from 'node:crypto';
+import {verifyRuntimeManifest} from './ceo-runtime-manifest.js';
+
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const identityKeys=['pid','entryPath','instanceId','releaseId','startedAt'];
+const validIdentity=v=>v&&Number.isSafeInteger(v.pid)&&v.pid>0&&path.isAbsolute(v.entryPath??'')&&['instanceId','releaseId','startedAt'].every(k=>typeof v[k]==='string'&&v[k].length>0&&v[k].length<256)&&Number.isFinite(Date.parse(v.startedAt));
+const same=(a,b)=>validIdentity(a)&&validIdentity(b)&&identityKeys.every(k=>a[k]===b[k]);
+async function readLease(file){const info=await stat(file);if(!info.isFile()||info.size>8192)fail('INVALID_LEASE');const bytes=await readFile(file);if(bytes.length>8192)fail('INVALID_LEASE');let v;try{v=JSON.parse(bytes);}catch{fail('INVALID_LEASE');}if(!validIdentity(v)||typeof v.leaseId!=='string')fail('INVALID_LEASE');return v;}
+export async function acquireRuntimeLease({leasePath,identity}){
+ if(!path.isAbsolute(leasePath??'')||!validIdentity(identity))fail('INVALID_LEASE');
+ const value={...Object.fromEntries(identityKeys.map(k=>[k,identity[k]])),leaseId:randomUUID()};
+ let handle;try{handle=await open(leasePath,'wx',0o600);}catch(e){if(e.code==='EEXIST')fail('INSTANCE_ALREADY_RUNNING');throw e;}
+ try{await handle.writeFile(JSON.stringify(value));await handle.sync();}finally{await handle.close();}
+ return Object.freeze({identity:Object.freeze({...identity}),async release(){const current=await readLease(leasePath);if(!same(current,value)||current.leaseId!==value.leaseId)fail('INSTANCE_IDENTITY_CHANGED');await unlink(leasePath);}});
+}
+export async function stopOwnedRuntime({leasePath,identity,readProcessIdentity,probeIdentity,requestStop}){
+ const lease=await readLease(leasePath);
+ if(!same(lease,identity)||typeof readProcessIdentity!=='function'||typeof probeIdentity!=='function'||typeof requestStop!=='function')fail('INSTANCE_IDENTITY_CHANGED');
+ if(!same(await readProcessIdentity(identity.pid),identity)||!same(await probeIdentity(),identity)||!same(await readLease(leasePath),identity))fail('INSTANCE_IDENTITY_CHANGED');
+ // No PID/port kill fallback: the verified instance receives a graceful request.
+ await requestStop(Object.freeze({...identity}));return{requested:true,instanceId:identity.instanceId};
+}
+export async function recoverRuntimeLease({leasePath,identity,confirmStale}){
+ const original=await readLease(leasePath);if(typeof confirmStale!=='function')fail('RECOVERY_UNVERIFIED');
+ const proof=await confirmStale(original);if(proof?.process!=='ABSENT'||proof?.listener!=='ABSENT')fail('RECOVERY_UNVERIFIED');
+ const guard=leasePath+'.recovery';try{await mkdir(guard);}catch{fail('RECOVERY_IN_PROGRESS');}
+ try{
+  const current=await readLease(leasePath),again=await confirmStale(current);
+  if(current.leaseId!==original.leaseId||!same(current,original)||again?.process!=='ABSENT'||again?.listener!=='ABSENT')fail('RECOVERY_UNVERIFIED');
+  await rename(leasePath,leasePath+'.stale-'+original.leaseId);
+  return await acquireRuntimeLease({leasePath,identity});
+ }finally{await rmdir(guard);}
+}
+export async function runtimeHealth({manifest,identity,dependencies=[],bindingConfirmed=false,inFlight=false}){
+ const reasons=[];const verified=await verifyRuntimeManifest(manifest);if(!verified.ok)reasons.push(verified.reason);
+ if(!validIdentity(identity)||identity.releaseId!==manifest.releaseId)reasons.push('INSTANCE_IDENTITY_CHANGED');
+ if(!bindingConfirmed)reasons.push('BINDING_UNCONFIRMED');
+ const dependenciesState=[];
+ for(const dependency of dependencies){
+  let ok=false;try{const info=await stat(dependency.path);ok=dependency.kind==='directory'?info.isDirectory():info.isFile();}catch{}
+  dependenciesState.push({id:dependency.id,ok});if(!ok)reasons.push('DEPENDENCY_UNAVAILABLE:'+dependency.id);
+ }
+ return{schema:'ceo-runtime-health/v1',ready:reasons.length===0,readOnly:true,releaseId:manifest.releaseId,mode:manifest.mode,storeId:manifest.storeId,fingerprint:manifest.fingerprint,instanceId:identity.instanceId,pid:identity.pid,startedAt:identity.startedAt,inFlight:Boolean(inFlight),dependencies:dependenciesState,reasons};
+}
+export function createRuntimeHealthServer(options){
+ return http.createServer(async(req,res)=>{
+  res.setHeader('Cache-Control','no-store');res.setHeader('Content-Type','application/json');
+  if(req.method!=='GET'){res.writeHead(405);res.end(JSON.stringify({error:'READ_ONLY_ENDPOINT'}));return;}
+  if(!['/healthz','/api/version'].includes(req.url)){res.writeHead(404);res.end(JSON.stringify({error:'NOT_FOUND'}));return;}
+  try{const health=await runtimeHealth(options);res.writeHead(req.url==='/healthz'&&!health.ready?503:200);res.end(JSON.stringify(health));}
+  catch{res.writeHead(503);res.end(JSON.stringify({ready:false,error:'HEALTH_UNAVAILABLE'}));}
+ });
+}
diff --git a/dist/src/ceo-runtime-manifest.js b/dist/src/ceo-runtime-manifest.js
new file mode 100644
index 0000000..7ec7cd0
--- /dev/null
+++ b/dist/src/ceo-runtime-manifest.js
@@ -0,0 +1,38 @@
+import {readFile,realpath,stat} from 'node:fs/promises';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+
+const digest=v=>createHash('sha256').update(v).digest('hex');
+const fail=code=>{throw Object.assign(new Error(code),{code});};
+const freeze=v=>{if(v&&typeof v==='object'){Object.values(v).forEach(freeze);Object.freeze(v);}return v;};
+const within=(root,p)=>{const rel=path.relative(root,p);return rel!==''&&rel!=='..'&&!rel.startsWith('..'+path.sep)&&!path.isAbsolute(rel);};
+const groups=['code','frontend','contracts','policy'];
+function fingerprint(m){return digest(JSON.stringify({schema:m.schema,releaseId:m.releaseId,mode:m.mode,storeId:m.storeId,codeRoot:m.codeRoot,dataRoot:m.dataRoot,files:m.files}));}
+function safeRelative(name){
+ if(typeof name!=='string'||!name||name.includes('\\')||path.posix.isAbsolute(name)||path.win32.isAbsolute(name)||name.split('/').some(x=>!x||x==='.'||x==='..'))fail('INVALID_MANIFEST_PATH');
+ if(/(?:^|\/)(?:\.env[^/]*|\.secretary-llm\.json|[^/]*(?:credentials|token|secret|private-key)[^/]*\.(?:json|pem|key|txt))$/i.test(name))fail('SENSITIVE_MANIFEST_PATH');
+}
+export async function createRuntimeManifest({codeRoot,dataRoot,releaseId,mode='SHADOW',storeId='400370',files}={}){
+ if(typeof releaseId!=='string'||!/^[A-Za-z0-9._-]{1,100}$/.test(releaseId)||!['SHADOW','LEGACY_READ_ONLY'].includes(mode)||storeId!=='400370'||!path.isAbsolute(dataRoot??''))fail('INVALID_MANIFEST');
+ const code=await realpath(codeRoot),data=path.resolve(dataRoot);
+ if(code.toLowerCase()===data.toLowerCase()||within(code,data)||within(data,code))fail('CODE_DATA_OVERLAP');
+ if(!files||groups.some(g=>!Array.isArray(files[g])||!files[g].length)||Object.keys(files).some(g=>!groups.includes(g)))fail('INCOMPLETE_MANIFEST');
+ const entries=[],seen=new Set();
+ for(const group of groups)for(const relative of [...files[group]].sort()){
+  safeRelative(relative);if(seen.has(relative.toLowerCase()))fail('DUPLICATE_MANIFEST_FILE');seen.add(relative.toLowerCase());
+  const file=await realpath(path.join(code,relative));if(!within(code,file))fail('UNSAFE_MANIFEST_FILE');
+  const info=await stat(file);if(!info.isFile()||info.size>16*1024*1024)fail('INVALID_MANIFEST_FILE');
+  const bytes=await readFile(file);if(bytes.length>16*1024*1024)fail('INVALID_MANIFEST_FILE');
+  entries.push({group,path:relative,sha256:digest(bytes),bytes:bytes.length});
+ }
+ const m={schema:'ceo-runtime-manifest/v1',releaseId,mode,storeId,codeRoot:code,dataRoot:data,files:entries};
+ return freeze({...m,fingerprint:fingerprint(m)});
+}
+export async function verifyRuntimeManifest(m){
+ try{
+  if(!m||m.schema!=='ceo-runtime-manifest/v1'||fingerprint(m)!==m.fingerprint)return{ok:false,reason:'MANIFEST_CHANGED'};
+  const files=Object.fromEntries(groups.map(g=>[g,m.files.filter(f=>f.group===g).map(f=>f.path)]));
+  const fresh=await createRuntimeManifest({...m,files});
+  return fresh.fingerprint===m.fingerprint?{ok:true}:{ok:false,reason:'RELEASE_BYTES_CHANGED'};
+ }catch{return{ok:false,reason:'RELEASE_UNAVAILABLE'};}
+}
diff --git a/dist/src/ceo-task-evidence.js b/dist/src/ceo-task-evidence.js
new file mode 100644
index 0000000..a64a726
--- /dev/null
+++ b/dist/src/ceo-task-evidence.js
@@ -0,0 +1,72 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {ceoContentHash} from './ceo-operating-context.js';
+
+const FILE_LIMIT=10*1024*1024,TOTAL_LIMIT=32*1024*1024;
+const inside=(base,file)=>{const relative=path.relative(base,file);return relative!==''&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep);};
+const scoped=file=>{const stores=[...file.matchAll(/(?:^|[\\/-])store-(\d+)(?=$|[\\/-])/g)].map(m=>m[1]);return stores.length>0&&stores.every(id=>id==='400370');};
+const sameFile=(a,b)=>a.dev===b.dev&&a.ino===b.ino;
+function localFile(projectRoot,reference){
+ if(typeof reference!=='string'||!reference||reference.length>512||/^(?:[\\/]{2}|[A-Za-z][A-Za-z0-9+.-]*:(?![\\/]))/.test(reference)||reference.includes('\0'))throw {code:'UNSUPPORTED_REFERENCE'};
+ const parts=reference.replace(/^[A-Za-z]:[\\/]/,'').split(/[\\/]/);
+ if(parts.some(p=>p==='..'||p==='.'||/[. ]$/.test(p)||p.includes(':')))throw {code:'UNSUPPORTED_REFERENCE'};
+ const root=fs.realpathSync(projectRoot),data=path.join(root,'data'),candidate=path.resolve(root,reference);
+ if(!inside(data,candidate)||!scoped(path.dirname(path.relative(data,candidate))))throw {code:'UNSUPPORTED_REFERENCE'};
+ // Reject reparse points before opening a file, including a redirected data root.
+ let current=root,identity;
+ for(const part of path.relative(root,candidate).split(path.sep)){current=path.join(current,part);identity=fs.lstatSync(current,{bigint:true});if(identity.isSymbolicLink())throw {code:'UNSUPPORTED_REFERENCE'};}
+ const canonical=fs.realpathSync(candidate);
+ if(!inside(data,canonical)||!scoped(path.dirname(path.relative(data,canonical))))throw {code:'UNSUPPORTED_REFERENCE'};
+ if(!identity.isFile())throw {code:'UNSUPPORTED_REFERENCE'};
+ if(identity.ino===0n)throw {code:'UNREADABLE'};
+ if(!sameFile(identity,fs.statSync(canonical,{bigint:true})))throw {code:'CHANGED_DURING_READ'};
+ return{file:canonical,identity};
+}
+
+// Synchronous and bounded so the acceptance recheck can run inside the existing transaction.
+// These are byte-integrity observations, never a business acceptance judgment.
+export function checkCeoTaskEvidence({projectRoot,task,now=new Date()}){
+ let remaining=TOTAL_LIMIT;
+ const evidence=task.receipt?.evidence,files=[];
+ if(Array.isArray(evidence)&&evidence.length<=8)for(const entry of evidence){
+  const row={reference:entry?.reference??'',expectedSha256:entry?.sha256??'',status:'UNREADABLE'};let fd;
+  try{
+   if(!/^[a-f0-9]{64}$/.test(entry?.sha256))throw {code:'INVALID_DIGEST'};
+   const {file,identity}=localFile(projectRoot,entry.reference);
+   fd=fs.openSync(file,fs.constants.O_RDONLY|(process.platform==='win32'?0:fs.constants.O_NOFOLLOW));
+   const before=fs.fstatSync(fd,{bigint:true});
+   if(!sameFile(before,identity))throw {code:'CHANGED_DURING_READ'};
+   if(!before.isFile())throw {code:'UNSUPPORTED_REFERENCE'};
+   if(before.size>BigInt(FILE_LIMIT))throw {code:'TOO_LARGE'};
+   if(before.size>BigInt(remaining))throw {code:'TOTAL_LIMIT'};
+   const hash=createHash('sha256'),buffer=Buffer.alloc(65536);let bytes=0;
+   while(true){
+    const count=fs.readSync(fd,buffer,0,Math.min(buffer.length,FILE_LIMIT-bytes+1,remaining+1),null);if(!count)break;
+    bytes+=count;remaining-=count;
+    if(bytes>FILE_LIMIT)throw {code:'TOO_LARGE'};
+    if(remaining<0)throw {code:'TOTAL_LIMIT'};
+    hash.update(buffer.subarray(0,count));
+   }
+   const after=fs.fstatSync(fd,{bigint:true}),current=localFile(projectRoot,entry.reference);
+   if(before.size!==BigInt(bytes)||after.size!==BigInt(bytes)||before.mtimeNs!==after.mtimeNs||before.ctimeNs!==after.ctimeNs||!sameFile(before,after)||current.file!==file||!sameFile(current.identity,after))throw {code:'CHANGED_DURING_READ'};
+   row.bytes=bytes;row.actualSha256=hash.digest('hex');row.status=row.actualSha256===entry.sha256?'MATCH':'MISMATCH';
+  }catch(e){row.status=['UNSUPPORTED_REFERENCE','TOO_LARGE','TOTAL_LIMIT','INVALID_DIGEST','CHANGED_DURING_READ'].includes(e?.code)?e.code:['ENOENT','ENOTDIR'].includes(e?.code)?'MISSING':'UNREADABLE';}
+  finally{if(fd!==undefined)fs.closeSync(fd);}
+  files.push(row);
+ }
+ const status=!files.length?'NO_EVIDENCE':files.every(f=>f.status==='MATCH')?'MATCH':'FAILED';
+ const bound={taskId:task.taskId,taskVersion:task.version,receiptHash:ceoContentHash(task.receipt??null),status,files};
+ return{schema:'ceo-evidence-check/v1',readOnly:true,...bound,checkId:ceoContentHash(bound),checkedAt:now.toISOString(),businessAcceptance:'HUMAN_REQUIRED'};
+}
+
+export function requireCeoEvidenceCheck({task,args,checkEvidence}){
+ if(!task.taskId.startsWith('store-400370-'))return null; // Explicit demo/other tasks do not count as operating progress.
+ const fail=code=>{throw Object.assign(new Error(code),{code});};
+ if(typeof checkEvidence!=='function')fail('EVIDENCE_CHECK_UNAVAILABLE');
+ if(typeof args.evidenceCheckId!=='string'||!/^[a-f0-9]{64}$/.test(args.evidenceCheckId))fail('EVIDENCE_CHECK_REQUIRED');
+ const result=checkEvidence(task);
+ if(result.status!=='MATCH')fail('EVIDENCE_CHECK_FAILED');
+ if(result.checkId!==args.evidenceCheckId)fail('EVIDENCE_CHECK_STALE');
+ return result;
+}
