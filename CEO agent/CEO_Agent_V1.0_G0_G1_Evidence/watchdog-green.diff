+  const receipt=workspace.saveDraft({context,decision:input.decision,candidates:input.candidates,expectedContextId:opts['--expected-context']});
+  console.log(JSON.stringify(receipt));
+ } catch(e){console.error(codes.has(e.code)?e.code:'CONTEXT_UNAVAILABLE');process.exitCode=1;}
+ finally{workspace?.close();}
+}
+if(process.argv[1]&&pathToFileURL(path.resolve(process.argv[1])).href===import.meta.url)await main(process.argv.slice(2));
