--- /dev/null
+++ b/scripts/ceo-draft-plan.mjs
@@ -0,0 +1,30 @@
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { buildDailyPlan } from "../dist/src/ceo-daily-plan.js";
+
+async function main(argv) {
+  if (argv.length !== 2 || argv[0] !== "--input" || !argv[1]) {
+    console.error("INVALID_ARGUMENTS: Expected --input followed by a JSON file.");
+    process.exitCode = 1;
+    return;
+  }
+  let input;
+  try { input = JSON.parse(await readFile(argv[1], "utf8")); }
+  catch {
+    console.error("INVALID_INPUT: Unable to read a JSON draft input.");
+    process.exitCode = 1;
+    return;
+  }
+  try {
+    // The external agent cannot move the host clock backwards to revive a stale decision.
+    console.log(JSON.stringify(buildDailyPlan({ ...input, now: new Date() })));
+  } catch {
+    console.error("INVALID_INPUT: Unable to build a draft from this input.");
+    process.exitCode = 1;
+  }
+}
+
+if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {
+  await main(process.argv.slice(2));
+}
