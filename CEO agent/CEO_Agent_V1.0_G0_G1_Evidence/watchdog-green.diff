+}
+
+export async function createMainRuntimeInfo({codeRoot,dataRoot,releaseId='g1-unreleased',instanceId=randomUUID(),startedAt=new Date().toISOString()}){
+ async function list(directory,extensions){
+  const result=[];
+  async function visit(relative){for(const entry of await readdir(path.join(codeRoot,relative),{withFileTypes:true})){const name=relative+'/'+entry.name;if(entry.isDirectory())await visit(name);else if(entry.isFile()&&extensions.some(ext=>name.endsWith(ext)))result.push(name);}}
+  await visit(directory);return result.sort();
+ }
+ const files={code:[...await list('dist/src',['.js']),'package.json','package-lock.json'],frontend:await list('public',['.js','.css','.html']),contracts:[...await list('schemas',['.json']),...await list('prompts',['.md'])],policy:['config/ceo-capabilities.v1.json']};
+ const manifest=await createRuntimeManifest({codeRoot,dataRoot,releaseId,mode:'SHADOW',storeId:'400370',files});
+ const identity={pid:process.pid,entryPath:path.join(codeRoot,'dist/src/server.js'),instanceId,releaseId,startedAt};
+ return Object.freeze({manifest,identity,health:()=>runtimeHealth({manifest,identity,bindingConfirmed:false,dependencies:[]})});
+}
