+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { readCeoBrief } from "../dist/src/ceo-read-brief.js";
+
+async function main(argv) {
+  if (argv.length !== 0 && (argv.length !== 2 || argv[0] !== "--base-url")) {
+    console.error("INVALID_ARGUMENTS: Expected no arguments or --base-url followed by a loopback URL.");
+    process.exitCode = 1;
+    return;
+  }
+  try {
+    const brief = await readCeoBrief(argv.length ? { baseUrl: argv[1] } : {});
+    console.log(JSON.stringify(brief));
+  } catch (error) {
+    const codes = new Set(["INVALID_BASE_URL", "INVALID_RESPONSE", "CONNECTION_FAILED"]);
+    const code = codes.has(error?.code) ? error.code : "CONNECTION_FAILED";
+    console.error(`${code}: Unable to read the local OS brief.`);
+    process.exitCode = 1;
+  }
+}
+
+if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {
+  await main(process.argv.slice(2));
+}
