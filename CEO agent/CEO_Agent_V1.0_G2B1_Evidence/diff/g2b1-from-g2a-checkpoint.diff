+}
+
+export function loadRealPaidOrderContract(){
+ const raw=contractBytes();
+ let parsed;try{parsed=JSON.parse(raw.toString('utf8'));}catch{fail('INVALID_REAL_CONTRACT');}
+ const contract=validateRealContract(parsed);
+ return freeze({contract,contractHash:contentHash(contract),declaredStatus:contract.status,bytesHash:contentHash(raw.toString('utf8'))});
+}
+
+/** Isolated fixture roots are the only place a test-only contract may be exercised. */
+export function assertIsolatedFixtureRoot(fixtureRoot){
+ if(typeof fixtureRoot!=='string'||!fixtureRoot)fail('ISOLATED_FIXTURE_REQUIRED');
+ let real;try{real=realpathSync(resolve(fixtureRoot));}catch{fail('ISOLATED_FIXTURE_REQUIRED');}
+ let marker;try{marker=lstatSync(join(real,'.ceo-isolated-fixture.json'));}catch{fail('ISOLATED_FIXTURE_REQUIRED');}
