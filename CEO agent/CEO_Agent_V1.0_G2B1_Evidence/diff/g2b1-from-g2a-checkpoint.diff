+import {readFileSync,realpathSync,lstatSync} from 'node:fs';
+import {resolve,dirname,join} from 'node:path';
+import {contentHash,freeze,fail,safeText,timestamp,exact} from './ceo-vnext-common.js';
+
+/**
+ * Real paid-order export contract (G2-B1).
+ *
+ * This module owns the *contract*, not the data. It can parse and validate an
+ * exporter-produced, closed-period, de-identified export, but it will refuse to do
+ * so until a Human-approved contract exists. The shipped contract is a DRAFT, so the
+ * real path is closed by construction rather than by a runtime flag someone could flip.
+ *
+ * Column names belong to the exporter. The runtime never guesses a column position or
+ * a column name, and rejects any column that is not explicitly mapped.
+ */
+
+const ID=/^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$/;
+const HASH=/^[a-f0-9]{64}$/;
+const DATE=/^\d{4}-\d{2}-\d{2}$/;
+const MONEY=/^(?:0|[1-9]\d{0,11})(?:\.\d{1,2})?$/;
+const ENVELOPE_KEYS=['schema','exportId','storeMappingId','period','exportedAt','coverage','currency','columns','rows'];
+
+function contractBytes(){return readFileSync(new URL('../../config/ceo-paid-orders.real-contract.v1.json',import.meta.url));}
+
+export function validateRealContract(contract){
+ if(!contract||typeof contract!=='object'||Array.isArray(contract))fail('INVALID_REAL_CONTRACT');
+ if(contract.schema!=='ceo-paid-order-real-contract/v1')fail('INVALID_REAL_CONTRACT');
+ if(!safeText(contract.version)||contract.version.length>60)fail('INVALID_REAL_CONTRACT');
+ if(!['DRAFT_PENDING_HUMAN_APPROVAL','APPROVED','SUPERSEDED'].includes(contract.status))fail('INVALID_REAL_CONTRACT');
+ if(typeof contract.testOnly!=='boolean')fail('INVALID_REAL_CONTRACT');
+ if(!ID.test(contract.storeMappingId??''))fail('INVALID_REAL_CONTRACT');
+ if(contract.sourceKind!=='OWN_STORE_ORDER_EXPORT')fail('INVALID_REAL_CONTRACT');
+ if(contract.exportFormat!=='CLOSED_PERIOD_DEIDENTIFIED_JSON_ROWS')fail('INVALID_REAL_CONTRACT');
+ const envelope=contract.exportEnvelope;
+ if(!envelope||envelope.schemaValue!=='ceo-real-paid-export/v1'||!Array.isArray(envelope.required)||envelope.required.join(',')!==ENVELOPE_KEYS.join(','))fail('INVALID_REAL_CONTRACT');
+ const fields=contract.canonicalFields;
+ if(!fields||typeof fields!=='object'||Array.isArray(fields))fail('INVALID_REAL_CONTRACT');
+ if(Object.keys(fields).sort().join(',')!==['itemCount','orderRef','orderStatus','paidAmount','paidAt','paidCurrency','paymentStatus','storeRef'].join(','))fail('INVALID_REAL_CONTRACT');
+ for(const [name,spec] of Object.entries(fields)){
+  if(!spec||typeof spec!=='object'||!['STRING','ENUM','INTEGER','TIMESTAMP_WITH_OFFSET','DECIMAL_STRING','CURRENCY'].includes(spec.type)||!safeText(spec.definition))fail('INVALID_REAL_CONTRACT');
+  if(spec.type==='ENUM'&&(!Array.isArray(spec.values)||!spec.values.length||spec.values.some(v=>!ID.test(v))))fail('INVALID_REAL_CONTRACT');
+  if(spec.type==='STRING'&&!safeText(spec.pattern??''))fail('INVALID_REAL_CONTRACT');
+ }
+ if(!Array.isArray(contract.forbiddenExportFields)||!contract.forbiddenExportFields.length||contract.forbiddenExportFields.some(f=>!safeText(f)))fail('INVALID_REAL_CONTRACT');
+ if(contract.periodSemantics?.closedPeriodRequired!==true||contract.periodSemantics?.ianaTimeZoneRequired!==true)fail('INVALID_REAL_CONTRACT');
+ if(contract.coverage?.allowed?.join(',')!=='COMPLETE')fail('INVALID_REAL_CONTRACT');
+ if(contract.currency?.conversion!=='NONE'||contract.currency?.minorUnit!=='cent')fail('INVALID_REAL_CONTRACT');
+ if(!Array.isArray(contract.approvalRequirements)||!contract.approvalRequirements.length)fail('INVALID_REAL_CONTRACT');
+ if(!Array.isArray(contract.knownGaps)||contract.knownGaps.some(g=>!/^[A-Z0-9_]{1,100}$/.test(g)))fail('INVALID_REAL_CONTRACT');
+ if(contract.approval!==null){
