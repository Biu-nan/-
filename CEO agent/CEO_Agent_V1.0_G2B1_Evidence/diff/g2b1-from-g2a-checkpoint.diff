+ function directories(){for(const p of [target,...['objects','manifests','receipts','requests'].map(x=>resolve(target,x))]){checkPath(p);if(!stat(p))mkdirSync(p);if(!lstatSync(p).isDirectory())fail('ISOLATED_FIXTURE_REQUIRED');}}
+ function objectRead(d){if(!plain(d)||!HASH.test(d.sha256??'')||!Number.isSafeInteger(d.size)||d.size<1||d.size>LIMIT)fail('ARCHIVE_CORRUPT');const b=bytesAt(resolve(target,'objects',d.sha256+'.blob'));if(b.length!==d.size||sha(b)!==d.sha256)fail('ARCHIVE_CORRUPT');return b;}
