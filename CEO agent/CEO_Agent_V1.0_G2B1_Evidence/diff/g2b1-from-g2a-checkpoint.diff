+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,writeFile,rm,readFile} from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {verifyCeoRealPaidInput} from '../src/ceo-real-data-verification.js';
+import {buildCeoShadowReport} from '../src/ceo-vnext-analysis.js';
+import {projectCeoCockpit,projectCeoWorkBuddyEntry,assertReadOnlyProjection} from '../src/ceo-cockpit-projection.js';
+import {loadStoreMappingRegistry} from '../src/ceo-store-mapping.js';
+import {loadRealPaidOrderContract} from '../src/ceo-paid-order-contract.js';
+import {loadRealPaidOrderPolicy} from '../src/ceo-real-export-adapter.js';
+import {realChain,approvalEnvelope} from './fixtures/ceo-real-chain-fixture.js';
+import {exportPayload} from './fixtures/ceo-real-export-fixture.js';
+
+const now=new Date('2026-11-05T01:00:00Z');
+async function root(t){const dir=await mkdtemp(path.join(os.tmpdir(),'b1-cockpit-'));t.after(()=>rm(dir,{recursive:true,force:true}));await writeFile(path.join(dir,'.ceo-isolated-fixture.json'),'{"synthetic":true}');return dir;}
+const taskSnapshot={schema:'ceo-task-snapshot/v1',storeId:'400370',snapshotId:'snap-1',capturedAt:now.toISOString(),tasks:[]};
+const workflowState={schema:'ceo-workflow-state/v1',storeId:'400370',snapshotId:'wf-1',capturedAt:now.toISOString(),workflows:[]};
+function reportFor(context){
+ return buildCeoShadowReport({context,taskSnapshot,workflowState,now,requestRef:'cockpit-1',draft:{
+  claims:[
+   {claimId:'f0',kind:'FACT',text:'host',factIds:['payment-0'],metric:'sales'},
+   {claimId:'f1',kind:'FACT',text:'host',factIds:['payment-1'],metric:'sales'},
+   {claimId:'f2',kind:'FACT',text:'host',factIds:['payment-2'],metric:'sales'},
+   {claimId:'h0',kind:'HYPOTHESIS',text:'履约与退款可能影响表现',factIds:[],metric:'general'}
+  ],
+  priorities:[{title:'核对支付后履约与退款',kind:'INVESTIGATE',factIds:['payment-0'],rationale:'缺退款口径',acceptance:'提供同期间退款对账'}],
+  planCandidates:[]
+ }});
+}
+
+test('a verified real analysis projects a READY cockpit with values and no actions',async t=>{
+ const dir=await root(t);
+ const verification=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ assert.equal(verification.status,'VERIFIED');
+ const report=reportFor(verification.domain.context);
+ const cockpit=projectCeoCockpit({verification,report,context:verification.domain.context,now});
+ assert.equal(cockpit.status,'READY');
+ assert.deepEqual(cockpit.facts.map(f=>f.value),[2,3,188.3]);
+ assert.deepEqual(cockpit.facts.map(f=>f.unit),['单','件','CNY']);
+ assert.ok(cockpit.facts.every(f=>f.quality==='VERIFIED'));
+ assert.deepEqual(cockpit.actions,[]);
+ assert.equal(cockpit.readOnly,true);
+ assert.equal(cockpit.formalTaskWrites,0);
+ assert.equal(cockpit.workflowExecutions,0);
+ assert.equal(cockpit.storeAlias,'纳物一店');
+ assert.ok(cockpit.gaps.includes('COMPARISON_PERIOD_MISSING'));
+ assert.equal(cockpit.priorities.length,1);
+ assert.equal(cockpit.claimsSummary.SUPPORTED,3);
+ assert.match(cockpit.cockpitId,/^cockpit-[a-f0-9]{64}$/);
+ assert.equal(assertReadOnlyProjection(cockpit).cockpitId,cockpit.cockpitId);
+});
+
+test('a rejected chain yields a BLOCKED cockpit with no numbers but visible reasons',async t=>{
+ const dir=await root(t);
+ const shippedRegistry=loadStoreMappingRegistry();
+ const verification=verifyCeoRealPaidInput({fixtureRoot:dir,contract:loadRealPaidOrderContract().contract,policy:loadRealPaidOrderPolicy().policy,registry:shippedRegistry,mapping:shippedRegistry.registry.stores[0],exportPayload:exportPayload(),approval:approvalEnvelope(),revision:1,now});
+ assert.equal(verification.status,'REJECTED');
+ const chain=realChain();
+ const domain=await (async()=>{const {prepareCeoRealPaymentDomain}=await import('../src/ceo-real-export-adapter.js');return prepareCeoRealPaymentDomain({fixtureRoot:dir,...chain,now});})();
+ const report=reportFor(domain.context);
+ const cockpit=projectCeoCockpit({verification,report,context:domain.context,now});
+ assert.equal(cockpit.status,'BLOCKED');
+ assert.ok(cockpit.facts.every(f=>f.value===null));
+ assert.ok(cockpit.facts.every(f=>f.quality==='UNVERIFIED'));
+ assert.ok(cockpit.verification.failed.includes('REAL_CONTRACT_NOT_APPROVED'));
+ assert.ok(cockpit.gaps.length>0);
+ // Investigation priorities stay visible even when nothing is verified.
+ assert.equal(cockpit.priorities.length,1);
+});
+
+test('the WorkBuddy entry can ask and read, but carries no authority and is not wired',async t=>{
+ const dir=await root(t);
+ const verification=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ const report=reportFor(verification.domain.context);
+ const cockpit=projectCeoCockpit({verification,report,context:verification.domain.context,now});
+ const entry=projectCeoWorkBuddyEntry({cockpit,report,now});
+ assert.equal(entry.schema,'ceo-workbuddy-entry/v1');
+ assert.equal(entry.authority,'NONE');
+ assert.equal(entry.productionWiringEnabled,false);
+ assert.equal(entry.writePath,null);
+ assert.deepEqual(entry.allowedIntents,['ASK_OPERATING_QUESTION','VIEW_COCKPIT']);
+ for(const forbidden of ['principal','dataApproval','context','versions','databasePath','executor','reportId'])assert.ok(entry.cannotSupply.includes(forbidden),forbidden);
+ assert.match(entry.entryId,/^wb-entry-[a-f0-9]{64}$/);
+ assert.equal(assertReadOnlyProjection(entry).entryId,entry.entryId);
+});
+
+test('a projection that claims write capability is refused',async t=>{
+ const dir=await root(t);
+ const verification=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ const report=reportFor(verification.domain.context);
+ const cockpit=projectCeoCockpit({verification,report,context:verification.domain.context,now});
+ assert.throws(()=>assertReadOnlyProjection({...cockpit,formalTaskWrites:1}),{code:'PROJECTION_NOT_READ_ONLY'});
+ assert.throws(()=>assertReadOnlyProjection({...cockpit,workflowExecutions:1}),{code:'PROJECTION_NOT_READ_ONLY'});
+ assert.throws(()=>assertReadOnlyProjection({...cockpit,readOnly:false}),{code:'PROJECTION_NOT_READ_ONLY'});
+ assert.throws(()=>assertReadOnlyProjection({...cockpit,authority:'WRITE'}),{code:'PROJECTION_NOT_READ_ONLY'});
+ assert.throws(()=>assertReadOnlyProjection({...cockpit,productionWiringEnabled:true}),{code:'PRODUCTION_WIRING_FORBIDDEN'});
+});
+
+test('cockpit identity is deterministic for the same evidence and changes with the period',async t=>{
+ const dir=await root(t);
+ const one=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ const two=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ const a=projectCeoCockpit({verification:one,report:reportFor(one.domain.context),context:one.domain.context,now});
+ const b=projectCeoCockpit({verification:two,report:reportFor(two.domain.context),context:two.domain.context,now});
+ assert.equal(a.cockpitId,b.cockpitId);
+ const otherPeriod=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain({exportPayload:exportPayload({period:{start:'2026-10-01',end:'2026-10-31',timeZone:'Asia/Shanghai'},exportedAt:'2026-11-04T23:00:00Z'})}),now});
+ assert.equal(otherPeriod.status,'VERIFIED');
+ assert.notEqual(otherPeriod.receipt,one.receipt);
+});
+
+test('the shipped connection contract keeps every real gate closed and lists the 15 checks',async()=>{
+ const raw=await readFile('config/ceo-g2b1-connection-contract.v1.json','utf8');
+ const contract=JSON.parse(raw);
+ assert.equal(contract.productionWiringEnabled,false);
+ assert.equal(contract.mode,'PREPARATION_ONLY');
+ assert.equal(contract.realStoreMapping.status,'UNVERIFIED');
+ assert.deepEqual(contract.realStoreMapping.authorityReviewers,[]);
+ assert.equal(contract.realStoreMapping.identityMigrationAllowed,false);
+ assert.equal(contract.paidData.status,'DRAFT_PENDING_HUMAN_APPROVAL');
+ assert.equal(contract.workBuddy.authority,'NONE');
+ assert.equal(contract.workBuddy.productionWiringEnabled,false);
+ assert.equal(contract.cockpit.readOnly,true);
+ assert.deepEqual(contract.cockpit.writes,[]);
+ assert.equal(contract.paidData.checks.length,15);
+ assert.ok(contract.acceptanceCriteria.length>=5);
+});
+
+test('a report from a different context cannot be projected as this cockpit',async t=>{
+ const dir=await root(t);
+ const verification=verifyCeoRealPaidInput({fixtureRoot:dir,...realChain(),now});
+ const other=await (async()=>{const {prepareCeoRealPaymentDomain}=await import('../src/ceo-real-export-adapter.js');return prepareCeoRealPaymentDomain({fixtureRoot:dir,...realChain({revision:2,exportPayload:exportPayload({rows:[]})}),now});})();
+ const report=reportFor(other.context);
+ assert.throws(()=>projectCeoCockpit({verification,report,context:verification.domain.context,now}),{code:'INVALID_COCKPIT_INPUT'});
+});
