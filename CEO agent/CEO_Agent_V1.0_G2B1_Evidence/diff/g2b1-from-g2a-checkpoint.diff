--- /dev/null
+++ b/dist/src/ceo-store-mapping.js
@@ -0,0 +1,109 @@
+import {readFileSync} from 'node:fs';
+import {contentHash,freeze,fail,timestamp,safeText} from './ceo-vnext-common.js';
+
+/**
+ * Store mapping gate.
+ *
+ * G2-B1 needs "纳物一店" bound to the CEO business scope before any real paid-order
+ * snapshot is admissible. The binding is authored by the store owner, not by this
+ * runtime: the runtime only *evaluates* a mapping and can never mint one. A declared
+ * status in the registry is treated as a claim, never as evidence.
+ *
+ * Reusing the frozen CEO store scope is deliberate. Re-pointing or migrating the
+ * formal identity is a separate Human decision, so a mapping that would change the
+ * store scope is REJECTED here instead of silently widening it.
+ */
+
+const ID=/^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$/;
+const HASH=/^[a-f0-9]{64}$/;
+const FIELD_KEYS=['mappingId','storeAlias','platform','ceoStoreId','environmentId','platformShopId','authorityRecordId','approvedBy','approvedAt','validUntil','mappingHash','declaredStatus'];
+const OPTIONAL_KEYS=['notes'];
+
+function registryBytes(){return readFileSync(new URL('../../config/ceo-store-mapping.v1.json',import.meta.url));}
+export function loadStoreMappingRegistry(){const raw=registryBytes();let registry;try{registry=JSON.parse(raw.toString('utf8'));}catch{fail('INVALID_STORE_REGISTRY');}return validateRegistry(registry,raw);}
+
+export function validateRegistry(registry,raw=null){
+ if(!registry||typeof registry!=='object'||Array.isArray(registry))fail('INVALID_STORE_REGISTRY');
+ if(registry.schema!=='ceo-store-mapping-registry/v1'||!safeText(registry.version)||registry.version.length>40)fail('INVALID_STORE_REGISTRY');
+ if(!ID.test(registry.storePolicyStoreId??''))fail('INVALID_STORE_REGISTRY');
+ if(registry.identityMigrationAllowed!==false)fail('IDENTITY_MIGRATION_NOT_ALLOWED');
+ if(!Array.isArray(registry.authorityReviewers)||registry.authorityReviewers.length>50||registry.authorityReviewers.some(x=>!ID.test(x??'')))fail('INVALID_STORE_REGISTRY');
+ if(!Array.isArray(registry.stores)||registry.stores.length>50)fail('INVALID_STORE_REGISTRY');
+ const ids=new Set();
+ for(const store of registry.stores){
+  if(!store||typeof store!=='object'||Array.isArray(store))fail('INVALID_STORE_REGISTRY');
+  if(!FIELD_KEYS.every(k=>Object.hasOwn(store,k))||!Object.keys(store).every(k=>FIELD_KEYS.includes(k)||OPTIONAL_KEYS.includes(k)))fail('INVALID_STORE_REGISTRY');
+  if(!ID.test(store.mappingId??'')||ids.has(store.mappingId))fail('INVALID_STORE_REGISTRY');
+  ids.add(store.mappingId);
+  if(typeof store.storeAlias!=='string'||!store.storeAlias.trim()||store.storeAlias.length>80)fail('INVALID_STORE_REGISTRY');
+  if(store.declaredStatus!=='UNVERIFIED')fail('DECLARED_STATUS_IS_NOT_AUTHORITY');
+ }
+ const body={...registry};
+ return freeze({registry:structuredClone(body),registryHash:contentHash(body),registryBytesHash:raw?contentHash(raw.toString('utf8')):contentHash(JSON.stringify(body))});
+}
+
+/**
+ * Evaluate one mapping against the registry. Pure: no clock drift, no writes.
+ * @returns immutable evaluation with an explicit reason list for every missing gate.
+ */
+export function evaluateStoreMapping({mapping,registry,now=new Date()}={}){
+ const loaded=registry&&registry.registry?registry:validateRegistry(registry);
+ const reg=loaded.registry;
+ if(!mapping||typeof mapping!=='object'||Array.isArray(mapping))fail('INVALID_STORE_MAPPING');
+ if(!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_STORE_MAPPING');
+ const declared=reg.stores.find(s=>s.mappingId===mapping.mappingId)??null;
+ const {notes:ignoredNotes,...core}=mapping;
+ // The approval must bind the exact record bytes, so the hash field itself is excluded.
+ const bindingHash=contentHash({...core,mappingHash:null});
+ const reject=[],missing=[],expired=[];
+ if(!declared)reject.push('MAPPING_NOT_IN_REGISTRY');
+ if(mapping.ceoStoreId!==reg.storePolicyStoreId)reject.push('CEO_STORE_SCOPE_MISMATCH');
+ if(mapping.ceoStoreId!==declared?.ceoStoreId)reject.push('MAPPING_BYTES_DIFFER_FROM_REGISTRY');
+ if(mapping.storeAlias!==declared?.storeAlias)reject.push('MAPPING_BYTES_DIFFER_FROM_REGISTRY');
+ if(mapping.platform!==declared?.platform)reject.push('MAPPING_BYTES_DIFFER_FROM_REGISTRY');
+ if(mapping.environmentId!==declared?.environmentId)reject.push('MAPPING_BYTES_DIFFER_FROM_REGISTRY');
+ if(mapping.declaredStatus!=='UNVERIFIED')reject.push('DECLARED_STATUS_IS_NOT_AUTHORITY');
+ if(mapping.approvedBy!==null&&!ID.test(mapping.approvedBy??''))reject.push('APPROVER_MALFORMED');
+ if(mapping.approvedBy!==null&&!reg.authorityReviewers.includes(mapping.approvedBy))reject.push('APPROVER_NOT_IN_REGISTRY');
+ if(mapping.mappingHash!==null&&(!HASH.test(mapping.mappingHash??'')||mapping.mappingHash!==bindingHash))reject.push('APPROVAL_NOT_BOUND_TO_BYTES');
+ if(mapping.platformShopId!==null&&!ID.test(mapping.platformShopId??''))reject.push('PLATFORM_SHOP_ID_MALFORMED');
+ if(mapping.authorityRecordId!==null&&!ID.test(mapping.authorityRecordId??''))reject.push('AUTHORITY_RECORD_MALFORMED');
+ if(mapping.platformShopId===null)missing.push('PLATFORM_SHOP_ID_MISSING');
+ if(mapping.authorityRecordId===null)missing.push('AUTHORITY_RECORD_MISSING');
+ if(mapping.approvedBy===null)missing.push('APPROVER_MISSING');
+ if(mapping.approvedAt===null)missing.push('APPROVED_AT_MISSING');
+ if(mapping.validUntil===null)missing.push('VALID_UNTIL_MISSING');
+ if(mapping.mappingHash===null)missing.push('MAPPING_HASH_MISSING');
+ if(mapping.approvedAt!==null&&(!timestamp(mapping.approvedAt)||Date.parse(mapping.approvedAt)>+now))reject.push('APPROVED_AT_INVALID');
+ if(mapping.validUntil!==null&&!timestamp(mapping.validUntil))reject.push('VALID_UNTIL_INVALID');
+ if(mapping.validUntil!==null&&timestamp(mapping.validUntil)&&Date.parse(mapping.validUntil)<=+now)expired.push('MAPPING_EXPIRED');
+ if(mapping.approvedAt!==null&&mapping.validUntil!==null&&timestamp(mapping.approvedAt)&&timestamp(mapping.validUntil)&&Date.parse(mapping.validUntil)<=Date.parse(mapping.approvedAt))reject.push('VALIDITY_WINDOW_INVALID');
+ if(!reg.authorityReviewers.length)missing.push('NO_AUTHORITY_REVIEWER_REGISTERED');
+ const status=reject.length?'REJECTED':expired.length?'EXPIRED':missing.length?'UNVERIFIED':'VERIFIED';
+ return freeze({
+  schema:'ceo-store-mapping-evaluation/v1',
+  mappingId:typeof mapping.mappingId==='string'?mapping.mappingId:null,
+  storeAlias:typeof mapping.storeAlias==='string'?mapping.storeAlias:null,
+  ceoStoreId:typeof mapping.ceoStoreId==='string'?mapping.ceoStoreId:null,
+  platform:typeof mapping.platform==='string'?mapping.platform:null,
+  environmentId:typeof mapping.environmentId==='string'?mapping.environmentId:null,
+  status,
+  mappingHash:bindingHash,
+  registryHash:loaded.registryHash,
+  reasons:[...reject,...expired,...missing],
+  rejected:reject,expired,missing,
+  evaluatedAt:now.toISOString(),
+  authorityGranted:status==='VERIFIED'
+ });
+}
+
+/** Throws with a stable code so callers cannot treat an unverified mapping as usable. */
+export function requireVerifiedStoreMapping(args={}){
+ const evaluation=evaluateStoreMapping(args);
+ if(evaluation.status==='VERIFIED')return evaluation;
+ const code=evaluation.status==='EXPIRED'?'STORE_MAPPING_EXPIRED':evaluation.status==='REJECTED'?'STORE_MAPPING_REJECTED':'STORE_MAPPING_UNVERIFIED';
+ const error=Object.assign(new Error(code),{code,reasons:evaluation.reasons,mappingId:evaluation.mappingId});
+ throw error;
+}
+
+export function findMapping(registry,mappingId){const loaded=registry&&registry.registry?registry:validateRegistry(registry);return structuredClone(loaded.registry.stores.find(s=>s.mappingId===mappingId)??null);}
