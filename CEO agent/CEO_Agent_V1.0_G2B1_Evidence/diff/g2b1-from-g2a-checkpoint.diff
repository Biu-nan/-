+ const list=CHECK_IDS.map(id=>checks.get(id));
+ const status=list.every(c=>c.ok)?'VERIFIED':'REJECTED';
+ const body={
+  schema:'ceo-real-paid-verification/v1',
+  status,
+  storeAlias:mapping?.storeAlias??null,
+  storeId:mappingStoreId,
+  period:mapped?structuredClone(mapped.period):null,
+  reviewerId:reviewerId??null,
+  approvalRecordId:approval?.approvalRecordId??null,
+  checks:list,
+  failed:list.filter(c=>!c.ok&&c.evaluated).map(c=>({checkId:c.checkId,code:c.code})),
+  notEvaluated:list.filter(c=>!c.evaluated).map(c=>c.checkId),
+  exportGaps:mapped?[...mapped.gaps]:[],
+  stats:mapped?structuredClone(mapped.stats):null,
+  contractHash:contractGate.ok?contractGate.value.contractHash:null,
+  policyHash:policyGate.ok?policyGate.value.policyHash:null,
+  mappingHash:mappingGate.ok?mappingGate.value.mappingHash:null,
+  evaluatedAt:now.toISOString(),
+  domainCode
+ };
+ const receipt='verify-'+contentHash(body);
+ return freeze({...body,receipt,domain});
+}
+
+/** Compact projection for the acceptance report and the connection contract. */
+export function verificationSummary(verification){
+ const failed=verification.failed.map(f=>f.code??f.checkId);
+ return freeze({schema:'ceo-real-paid-verification-summary/v1',status:verification.status,receipt:verification.receipt,failedCount:failed.length,failed,storeAlias:verification.storeAlias,storeId:verification.storeId,reviewerId:verification.reviewerId,period:verification.period,exportGaps:verification.exportGaps});
+}
