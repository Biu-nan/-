+++ b/dist/src/ceo-readiness-versions.js
@@ -0,0 +1,20 @@
+import {readFileSync,realpathSync} from 'node:fs';
+import {fileURLToPath} from 'node:url';
+import path from 'node:path';
+import {sha,contentHash,freeze,fail} from './ceo-vnext-common.js';
+const codeRoot=fileURLToPath(new URL('../../',import.meta.url));
+/** Host constructs this resolver, never a client versions object. Disk drift invalidates new writes. */
+export function createCeoReadinessVersionResolver({dictionaryBytes,sourcePolicy}={}){
+ const dictionaryString=Buffer.from(dictionaryBytes??'').toString('utf8'),dict=JSON.parse(dictionaryString),policy=structuredClone(sourcePolicy);
+ function capture(){
+  // G2-B1 supersedes the G2-B0 package; the older manifest is kept so a rollback to the
+  // previous stage resolves its own runtime hash instead of silently inheriting this one.
+  const manifest='config/ceo-g2b1-package.v1.json';
+  let config;try{config=JSON.parse(readFileSync(path.join(codeRoot,manifest),'utf8'));}catch{config=JSON.parse(readFileSync(path.join(codeRoot,'config/ceo-g2b0-package.v1.json'),'utf8'));}
+  const files=config.files.map(relative=>{if(typeof relative!=='string'||relative.includes('..')||path.isAbsolute(relative)||relative.includes('\\'))fail('INVALID_PACKAGE_PATH');const full=realpathSync(path.join(codeRoot,relative));const rel=path.relative(realpathSync(codeRoot),full);if(rel.startsWith('..')||path.isAbsolute(rel))fail('INVALID_PACKAGE_PATH');return{path:relative,sha256:sha(readFileSync(full))};});
+  const pack=JSON.parse(readFileSync(path.join(codeRoot,'config/ceo-knowledge.v1.json'),'utf8')),prompt=readFileSync(path.join(codeRoot,'prompts/ceo-vnext-core.md'));
+  const data={runtimeVersion:config.runtimeVersion,runtimeHash:contentHash({files,nodeVersion:process.version}),nodeVersion:process.version,knowledgeVersion:pack.version,knowledgeHash:contentHash({pack,promptHash:sha(prompt)}),dictionaryVersion:dict.version,dictionaryHash:sha(dictionaryString),sourcePolicyVersion:policy.version,sourcePolicyHash:contentHash(policy)};
+  return freeze({...data,packageHash:contentHash(data)});
+ }
+ const bound=capture();return()=>{const fresh=capture();if(contentHash(fresh)!==contentHash(bound))fail('RUNTIME_BINDING_CHANGED');return bound;};
+}
diff --git a/dist/src/ceo-real-data-verification.js b/dist/src/ceo-real-data-verification.js
new file mode 100644
index 0000000..bd31204
--- /dev/null
+++ b/dist/src/ceo-real-data-verification.js
@@ -0,0 +1,153 @@
+import {contentHash,freeze,fail} from './ceo-vnext-common.js';
+import {requireApprovedRealContract,mapRealExport} from './ceo-paid-order-contract.js';
+import {requireApprovedRealPolicy} from './ceo-real-export-adapter.js';
+import {evaluateStoreMapping} from './ceo-store-mapping.js';
+import {prepareCeoRealPaymentDomain} from './ceo-real-export-adapter.js';
+
+/**
+ * Trust verification for the first real data domain (G2-B1, item D).
+ *
+ * This is the auditable "why" layer: it never throws on a rejected chain, it returns a
+ * stable checklist so a Human can see which single link is missing. A context is only
+ * produced when every check passed, and the checklist itself is content-hashed so the
+ * acceptance decision can be replayed later.
+ */
+
+const CHECK_IDS=[
+ 'CONTRACT_APPROVED','CONTRACT_BOUND','POLICY_APPROVED','STORE_MAPPING_VERIFIED','STORE_SCOPE_ALIGNED',
+ 'REVIEWER_AUTHORIZED','STORE_REF_BOUND','EXPORT_COLUMNS_CONTRACTED','NO_PERSONAL_DATA',
+ 'CLOSED_PERIOD','TIMEZONE_DECLARED','CURRENCY_DECLARED','COVERAGE_COMPLETE','NO_SYNTHETIC_MARKERS','SNAPSHOT_ADMISSIBLE'
+];
+
+const CODE_TO_CHECK={
+ REAL_CONTRACT_NOT_APPROVED:'CONTRACT_APPROVED',
+ REAL_CONTRACT_APPROVAL_MISSING:'CONTRACT_BOUND',
+ REAL_CONTRACT_EXPIRED:'CONTRACT_BOUND',
+ REAL_CONTRACT_APPROVAL_INVALID:'CONTRACT_BOUND',
+ REAL_CONTRACT_APPROVAL_NOT_BOUND:'CONTRACT_BOUND',
+ REAL_POLICY_NOT_APPROVED:'POLICY_APPROVED',
+ REAL_POLICY_APPROVAL_MISSING:'POLICY_APPROVED',
+ REAL_POLICY_EXPIRED:'POLICY_APPROVED',
+ REAL_POLICY_APPROVAL_INVALID:'POLICY_APPROVED',
+ REAL_POLICY_APPROVAL_NOT_BOUND:'POLICY_APPROVED',
+ REAL_POLICY_FIXTURE_MARKER:'POLICY_APPROVED',
+ STORE_MAPPING_UNVERIFIED:'STORE_MAPPING_VERIFIED',
+ STORE_MAPPING_EXPIRED:'STORE_MAPPING_VERIFIED',
+ STORE_MAPPING_REJECTED:'STORE_MAPPING_VERIFIED',
+ REAL_EXPORT_STORE_MAPPING_MISMATCH:'STORE_REF_BOUND',
+ STORE_REF_MISMATCH:'STORE_REF_BOUND',
+ REAL_EXPORT_COLUMNS_MISMATCH:'EXPORT_COLUMNS_CONTRACTED',
+ REAL_EXPORT_PII_REJECTED:'NO_PERSONAL_DATA',
+ REAL_EXPORT_NOT_CLOSED_PERIOD:'CLOSED_PERIOD',
+ REAL_EXPORT_TIMEZONE_REQUIRED:'TIMEZONE_DECLARED',
+ REAL_EXPORT_PERIOD_INVALID:'TIMEZONE_DECLARED',
+ REAL_EXPORT_CURRENCY_MISMATCH:'CURRENCY_DECLARED',
+ REAL_EXPORT_COVERAGE_INCOMPLETE:'COVERAGE_COMPLETE',
+ SYNTHETIC_MARKER_IN_REAL_EXPORT:'NO_SYNTHETIC_MARKERS',
+ REAL_APPROVAL_REVIEWER_UNAUTHORIZED:'REVIEWER_AUTHORIZED',
+ REAL_APPROVAL_TIME_INVALID:'REVIEWER_AUTHORIZED'
+};
+
+function attempt(fn){
+ try{return{ok:true,value:fn()};}catch(e){return{ok:false,code:typeof e.code==='string'?e.code:'UNKNOWN',message:String(e.message??e)};}
+}
+
+export function verifyCeoRealPaidInput({fixtureRoot,contract,policy,mapping,registry,exportPayload,approval,revision,now=new Date()}={}){
+ if(!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_VERIFICATION_INPUT');
+ // A check starts as "not evaluated": silence is never reported as a failure with no reason.
+ const checks=new Map(CHECK_IDS.map(id=>[id,{checkId:id,ok:false,code:null,evaluated:false}]));
+ const set=(id,ok,code=null)=>{const c=checks.get(id);c.ok=ok;c.code=ok?null:code;c.evaluated=true;};
+ /** A check that could not run because a prerequisite failed is *not* a false negative. */
+ const skip=(id,reason)=>{const c=checks.get(id);c.ok=false;c.code='NOT_EVALUATED';c.evaluated=false;c.blockedBy=reason;};
+ const failByCode=(id,code)=>{const target=CODE_TO_CHECK[code]??id;set(target,false,code);};
+
+ const contractGate=attempt(()=>requireApprovedRealContract({contract,fixtureRoot,now}));
+ if(contractGate.ok){set('CONTRACT_APPROVED',true);set('CONTRACT_BOUND',true);}
+ else if(CODE_TO_CHECK[contractGate.code]==='CONTRACT_BOUND'){set('CONTRACT_APPROVED',true);set('CONTRACT_BOUND',false,contractGate.code);}
+ else{set('CONTRACT_APPROVED',false,contractGate.code);skip('CONTRACT_BOUND',contractGate.code);}
+
+ const policyGate=attempt(()=>requireApprovedRealPolicy({policy,fixtureRoot,now}));
+ if(policyGate.ok)set('POLICY_APPROVED',true);else failByCode('POLICY_APPROVED',policyGate.code);
+
+ const mappingGate=attempt(()=>evaluateStoreMapping({mapping,registry,now}));
+ if(mappingGate.ok&&mappingGate.value.status==='VERIFIED')set('STORE_MAPPING_VERIFIED',true);
+ else failByCode('STORE_MAPPING_VERIFIED',mappingGate.ok?'STORE_MAPPING_'+mappingGate.value.status:mappingGate.code);
+
+ const policyStoreId=policyGate.ok?policyGate.value.policy.storeId:null;
+ const mappingStoreId=mappingGate.ok?mappingGate.value.ceoStoreId:null;
+ const aligned=!!policyStoreId&&!!mappingStoreId&&policyStoreId===mappingStoreId;
+ const scopeCode=aligned?null:(policyStoreId&&mappingStoreId?'STORE_SCOPE_MISMATCH':'STORE_SCOPE_UNRESOLVED');
+ set('STORE_SCOPE_ALIGNED',aligned,scopeCode);
+
+ const reviewers=policyGate.ok?policyGate.value.policy.approvedReviewers:[];
+ const authority=registry?.registry?.authorityReviewers??[];
+ const reviewerId=approval?.reviewerId;
+ const reviewerOK=typeof reviewerId==='string'&&!reviewerId.startsWith('fixture-')&&reviewers.includes(reviewerId)&&authority.includes(reviewerId);
+ set('REVIEWER_AUTHORIZED',reviewerOK,reviewerOK?null:'REAL_APPROVAL_REVIEWER_UNAUTHORIZED');
+
+ let mapped=null,exportCode=null;
+ if(contractGate.ok){
+  const result=attempt(()=>mapRealExport({contract:contractGate.value.contract,exportPayload}));
+  if(result.ok)mapped=result.value;else exportCode=result.code;
+ }else exportCode='CONTRACT_NOT_ADMISSIBLE';
+ const exportChecks=['EXPORT_COLUMNS_CONTRACTED','NO_PERSONAL_DATA','CLOSED_PERIOD','TIMEZONE_DECLARED','CURRENCY_DECLARED','COVERAGE_COMPLETE','STORE_REF_BOUND','NO_SYNTHETIC_MARKERS'];
+ if(exportCode===null)for(const id of exportChecks)set(id,true);
+ else{
+  if(exportCode==='CONTRACT_NOT_ADMISSIBLE')for(const id of exportChecks)skip(id,'CONTRACT_APPROVED');
+  else{
+   failByCode('EXPORT_COLUMNS_CONTRACTED',exportCode);
+   const named=CODE_TO_CHECK[exportCode];
+   for(const id of exportChecks)if(id!==named)skip(id,exportCode);
+  }
+ }
+ if(mapped){
+  // A payload that passed the envelope still has to carry the mapped shop reference.
+  const storeRefs=[...new Set(mapped.rows.map(r=>r.storeId))];
+  const storeBound=storeRefs.length<=1&&(storeRefs.length===0||!mappingGate.ok||storeRefs[0]===mapping.platformShopId);
+  set('STORE_REF_BOUND',storeBound,storeBound?null:'STORE_REF_MISMATCH');
