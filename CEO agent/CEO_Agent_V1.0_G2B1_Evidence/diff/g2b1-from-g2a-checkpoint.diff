+ let cursor=dirname(join(real,'.ceo-isolated-fixture.json'));
+ if(cursor!==real)fail('ISOLATED_FIXTURE_REQUIRED');
+ return real;
+}
+
+/**
+ * Contract gate. Default deny: a DRAFT contract cannot be used, and a test-only
+ * contract is usable only inside a marked isolated fixture root.
+ */
+export function requireApprovedRealContract({contract,fixtureRoot,now=new Date()}={}){
+ const checked=validateRealContract(contract);
+ if(!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_REAL_CONTRACT');
+ if(checked.testOnly===true)assertIsolatedFixtureRoot(fixtureRoot);
+ if(checked.status!=='APPROVED'){const e=Object.assign(new Error('REAL_CONTRACT_NOT_APPROVED'),{code:'REAL_CONTRACT_NOT_APPROVED',status:checked.status,contractVersion:checked.version});throw e;}
+ if(!checked.approval)fail('REAL_CONTRACT_APPROVAL_MISSING');
+ if(Date.parse(checked.approval.validUntil)<=+now)fail('REAL_CONTRACT_EXPIRED');
+ if(Date.parse(checked.approval.approvedAt)>+now)fail('REAL_CONTRACT_APPROVAL_INVALID');
+ return freeze({contract:checked,contractHash:contentHash(checked),approval:structuredClone(checked.approval)});
+}
+
+const decimalCents=value=>{
+ const text=typeof value==='number'?String(value):typeof value==='string'?value.trim():null;
+ if(text===null||!MONEY.test(text))return null;
+ const [whole,fraction='']=text.split('.'),cents=Number(whole)*100+Number((fraction+'00').slice(0,2));
