+import {readFileSync} from 'node:fs';
+import {assertCeoSourcePolicy} from './ceo-vnext-context.js';
+import {buildPaidOrderDictionary,buildPaidOrderDomain} from './ceo-paid-order-core.js';
+import {requireApprovedRealContract,mapRealExport,assertIsolatedFixtureRoot} from './ceo-paid-order-contract.js';
+import {requireVerifiedStoreMapping} from './ceo-store-mapping.js';
+import {sha,contentHash,freeze,fail,timestamp,safeText,exact} from './ceo-vnext-common.js';
+
+/**
+ * Controlled real-export adapter (G2-B1, item C).
+ *
+ * The synthetic adapter in ceo-payment-domain.js is untouched and still refuses real
+ * data. This adapter is the only door to a REAL context, and it is closed unless the
+ * whole chain is present and mutually bound:
+ *
+ *   approved contract  x  approved source policy  x  verified store mapping  x  reviewer authority
+ *
+ * No single object can open it. A caller cannot self-approve by passing a policy, and a
+ * fixture-identitied reviewer can never approve real rows.
+ */
+
+const baseUrl=new URL('../test/fixtures/ceo-g2a/metrics-schema.1.0.0.json',import.meta.url);
+const baseBytes=readFileSync(baseUrl);
+const ID=/^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$/;
+
+const realDictionaryBytes=()=>buildPaidOrderDictionary({
+ baseBytes,
+ suffix:' + paid-orders.real.v1',
+ calibers:[
+  ['orders.payment.count','支付订单数','单','real-paid-export','Own-store paid events from an approved closed-period de-identified export; not market data and not net income.'],
+  ['orders.payment.units','支付件数','件','real-paid-export','Own-store paid events from an approved closed-period de-identified export; not market data and not net income.'],
+  ['orders.payment.gross','支付原始金额（非净收入）','CNY','real-paid-export','Own-store paid events from an approved closed-period de-identified export; not market data and not net income.']
+ ]
+});
+export const realPaidOrderDictionaryBytes=realDictionaryBytes();
+export const realPaidOrderBaseDictionaryHash=sha(baseBytes);
+
+export function loadRealPaidOrderPolicy(){
+ let parsed;try{parsed=JSON.parse(readFileSync(new URL('../../config/ceo-paid-orders.real-policy.v1.json',import.meta.url),'utf8'));}catch{fail('INVALID_REAL_POLICY');}
+ if(!parsed||typeof parsed!=='object'||Array.isArray(parsed))fail('INVALID_REAL_POLICY');
+ if(parsed.schema!=='ceo-data-source-policy/v1'||parsed.mode!=='REAL_APPROVED'||typeof parsed.version!=='string')fail('INVALID_REAL_POLICY');
+ if(typeof parsed.testOnly!=='boolean')fail('INVALID_REAL_POLICY');
+ if(!['DRAFT_PENDING_HUMAN_APPROVAL','APPROVED'].includes(parsed.status))fail('INVALID_REAL_POLICY');
+ return freeze({policy:structuredClone(parsed),policyHash:contentHash(parsed),declaredStatus:parsed.status});
+}
+
+/**
+ * Real-policy gate. A DRAFT policy is refused; a test-only one needs a marked isolated root.
+ * The approval envelope must bind the exact policy bytes, and the approver must also be a
+ * registered store-mapping reviewer (checked by the adapter, which owns that registry).
+ */
+export function requireApprovedRealPolicy({policy,fixtureRoot,now=new Date()}={}){
+ const p=structuredClone(policy);
+ if(!p||typeof p!=='object'||Array.isArray(p))fail('INVALID_REAL_POLICY');
+ if(p.schema!=='ceo-data-source-policy/v1'||p.mode!=='REAL_APPROVED'||p.storeId!=='400370')fail('INVALID_REAL_POLICY');
+ if(typeof p.testOnly!=='boolean'||typeof p.version!=='string')fail('INVALID_REAL_POLICY');
+ if(!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_REAL_POLICY');
+ if(p.testOnly===true)assertIsolatedFixtureRoot(fixtureRoot);
+ if(p.status!=='APPROVED'){const e=Object.assign(new Error('REAL_POLICY_NOT_APPROVED'),{code:'REAL_POLICY_NOT_APPROVED',status:p.status,policyVersion:p.version});throw e;}
