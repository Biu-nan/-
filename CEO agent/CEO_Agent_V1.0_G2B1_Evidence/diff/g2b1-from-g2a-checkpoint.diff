+  if(!exact(a,['approvedBy','approverRole','approvedAt','validUntil','contractHash','retentionPolicy'])||!ID.test(a.approvedBy??'')||!safeText(a.approverRole)||!timestamp(a.approvedAt)||!timestamp(a.validUntil)||!HASH.test(a.contractHash??'')||!safeText(a.retentionPolicy))fail('INVALID_REAL_CONTRACT');
