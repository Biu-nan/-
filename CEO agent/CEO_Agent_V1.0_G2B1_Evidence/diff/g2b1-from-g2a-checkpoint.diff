+}
+
+export function contractGaps(){const {contract}=loadRealPaidOrderContract();return freeze({status:contract.status,version:contract.version,knownGaps:[...contract.knownGaps],approvalRequired:[...contract.approvalRequirements]});}
diff --git a/dist/src/ceo-paid-order-core.js b/dist/src/ceo-paid-order-core.js
