+import {readFileSync} from 'node:fs';
+import {buildPaidOrderDictionary,buildPaidOrderDomain} from './ceo-paid-order-core.js';
+import {sha,freeze} from './ceo-vnext-common.js';
+
+const baseBytes=readFileSync(new URL('../test/fixtures/ceo-g2a/metrics-schema.1.0.0.json',import.meta.url));
+const sourcePolicy=JSON.parse(readFileSync(new URL('../../config/ceo-paid-orders.synthetic.v1.json',import.meta.url),'utf8'));
+
+/** Synthetic source profile. Every value here is fixture-bound on purpose. */
+export const paidOrderSourcePolicy=freeze(sourcePolicy);
+export const paidOrderDictionaryBytes=buildPaidOrderDictionary({
+ baseBytes,
+ suffix:' + paid-orders.synthetic.v1',
+ calibers:[
+  ['orders.payment.count','合成支付订单数','单','fixture-paid-export','Only synthetic own-store paid events; not market data, shipped sales, or net income.'],
+  ['orders.payment.units','合成支付件数','件','fixture-paid-export','Only synthetic own-store paid events; not market data, shipped sales, or net income.'],
+  ['orders.payment.gross','合成支付原始金额（非净收入）','CNY','fixture-paid-export','Only synthetic own-store paid events; not market data, shipped sales, or net income.']
+ ]
+});
+
+export const SYNTHETIC_PAYMENT_SOURCE=freeze({
+ mode:'SYNTHETIC',
+ storeId:'400370',
+ sourceKind:'OWN_STORE_ORDER_EXPORT',
+ orderRefPattern:/^syn-[A-Za-z0-9._:-]{1,100}$/,
+ sourcePath:'paid-orders.synthetic.json',
+ sourceId:'fixture-paid-export',
+ approvalPath:'approval.synthetic.json',
+ approvalScope:'SYNTHETIC',
+ baseGaps:['REAL_STORE_BINDING_UNVERIFIED','REAL_SOURCE_AND_REVIEWER_UNVERIFIED','COMPARISON_PERIOD_MISSING','REFUNDS_AND_NET_INCOME_UNVERIFIED'],
+ verificationScope:'SYNTHETIC',
+ eventBasis:'PAID_EVENT_GROSS'
+});
+
+/** Synthetic input only. A real export goes through the controlled adapter, never here. */
+export function prepareCeoPaymentDomain({snapshot,approval=null,now=new Date()}={}){
+ const domain=buildPaidOrderDomain({source:SYNTHETIC_PAYMENT_SOURCE,snapshot,approval,policy:paidOrderSourcePolicy,dictionaryBytes:paidOrderDictionaryBytes,now});
+ return freeze({...domain,baseDictionaryHash:sha(baseBytes)});
+}
