@@ -0,0 +1,126 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,writeFile,rm} from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {loadRealPaidOrderContract,requireApprovedRealContract,mapRealExport,validateRealContract,contractGaps} from '../src/ceo-paid-order-contract.js';
+import {approvedTestContract,exportPayload,columns,draftContract} from './fixtures/ceo-real-export-fixture.js';
+
+const now=new Date('2026-11-05T00:00:00Z');
+async function fixtureRoot(t){
+ const root=await mkdtemp(path.join(os.tmpdir(),'b1-contract-'));
+ t.after(()=>rm(root,{recursive:true,force:true}));
+ await writeFile(path.join(root,'.ceo-isolated-fixture.json'),'{"synthetic":true}');
+ return root;
+}
+
+test('the shipped real contract is a DRAFT and the real path is refused by default',()=>{
+ const loaded=loadRealPaidOrderContract();
+ assert.equal(loaded.contract.status,'DRAFT_PENDING_HUMAN_APPROVAL');
+ assert.equal(loaded.contract.approval,null);
+ assert.match(loaded.contractHash,/^[a-f0-9]{64}$/);
+ assert.throws(()=>requireApprovedRealContract({contract:loaded.contract,now}),{code:'REAL_CONTRACT_NOT_APPROVED'});
+ const gaps=contractGaps();
+ assert.ok(gaps.knownGaps.includes('REAL_SOURCE_OWNER_UNVERIFIED'));
+ assert.ok(gaps.approvalRequired.includes('contractHash'));
+});
+
+test('a test-only approved contract is usable only inside a marked isolated fixture root',async t=>{
+ const contract=approvedTestContract();
+ assert.throws(()=>requireApprovedRealContract({contract,now}),{code:'ISOLATED_FIXTURE_REQUIRED'});
+ const root=await fixtureRoot(t);
+ const gate=requireApprovedRealContract({contract,fixtureRoot:root,now});
+ assert.equal(gate.contract.status,'APPROVED');
+ assert.match(gate.contractHash,/^[a-f0-9]{64}$/);
+ assert.throws(()=>requireApprovedRealContract({contract:approvedTestContract({status:'DRAFT_PENDING_HUMAN_APPROVAL'}),fixtureRoot:root,now}),{code:'REAL_CONTRACT_NOT_APPROVED'});
+});
+
+test('editing the contract after approval breaks the approval binding',()=>{
+ const contract=approvedTestContract();
+ contract.canonicalFields.itemCount.definition='edited after approval';
+ assert.throws(()=>validateRealContract(contract),/REAL_CONTRACT_APPROVAL_NOT_BOUND/);
+});
+
+test('expired or future-dated contract approvals are refused',async t=>{
+ const root=await fixtureRoot(t);
+ assert.throws(()=>requireApprovedRealContract({contract:approvedTestContract({validUntil:'2026-11-01T00:00:00Z'}),fixtureRoot:root,now}),{code:'REAL_CONTRACT_EXPIRED'});
+ assert.throws(()=>requireApprovedRealContract({contract:approvedTestContract({approvedAt:'2027-01-01T00:00:00Z'}),fixtureRoot:root,now}),{code:'REAL_CONTRACT_APPROVAL_INVALID'});
+});
+
+test('exporter-owned column names are resolved through the contract, never by position or guesswork',()=>{
+ const mapped=mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload()});
+ assert.deepEqual(mapped.rows.map(r=>r.orderRef),['AE20261102001','AE20261102002','AE20261101003']);
+ assert.equal(mapped.rows[0].storeId,'shop-7788');
+ assert.equal(mapped.rows[0].payment.amount,128.4);
+ assert.equal(mapped.rows[0].itemCount,2);
+ assert.equal(mapped.rows[2].payment.status,'UNPAID');
+ assert.equal(mapped.rows[2].payment.amount,null);
+ assert.deepEqual(mapped.stats,{inputRows:3,canonicalRows:3,duplicates:0,conflicts:0,unknownStatus:0,unknownCurrency:0,missingUnits:0});
+});
+
+test('renaming an export column to an unmapped one is a structural failure, not a silent skip',()=>{
+ const changed={...columns,paidAmount:'gmv'};
+ const payload=exportPayload({columnMap:changed});
+ payload.rows=payload.rows.map(r=>{const {pay_amount,...rest}=r;return{...rest,gmv:pay_amount};});
+ const ok=mapRealExport({contract:approvedTestContract(),exportPayload:payload});
+ assert.equal(ok.rows[0].payment.amount,128.4);
+ const wrong={...columns,paidAmount:'not_a_column'};
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({columnMap:wrong})}),{code:'REAL_EXPORT_COLUMNS_MISMATCH'});
+});
+
+test('personal data columns are rejected outright',()=>{
+ const payload=exportPayload();
+ payload.rows=payload.rows.map(r=>({...r,buyer_email:'a@example.com'}));
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:payload}),{code:'REAL_EXPORT_PII_REJECTED'});
+});
+
+test('partial coverage, open periods and missing time zones cannot be admitted',()=>{
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({coverage:'PARTIAL'})}),{code:'REAL_EXPORT_COVERAGE_INCOMPLETE'});
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({exportedAt:'2026-11-04T00:00:00Z'})}),{code:'REAL_EXPORT_NOT_CLOSED_PERIOD'});
+ const noTz=exportPayload();delete noTz.period.timeZone;
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:noTz}),{code:'REAL_EXPORT_PERIOD_INVALID'});
+ const badTz=exportPayload({period:{start:'2026-11-01',end:'2026-11-04',timeZone:'Mars/Olympus'}});
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:badTz}),{code:'REAL_EXPORT_TIMEZONE_REQUIRED'});
+});
+
+test('store mapping mismatch and currency mismatch are refused',()=>{
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({storeMappingId:'mapping-other'})}),{code:'REAL_EXPORT_STORE_MAPPING_MISMATCH'});
+ assert.throws(()=>mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({currency:'USD'})}),{code:'REAL_EXPORT_CURRENCY_MISMATCH'});
+});
+
+test('unknown status, imprecise money and out-of-period payments become declared gaps instead of zeros',()=>{
+ const rows=[
+  {order_id:'A1',shop_id:'shop-7788',order_status:'FULFILLED',item_count:1,pay_status:'PAID',pay_time:'2026-11-02T03:00:00+08:00',pay_amount:'10.005',pay_currency:'CNY'},
+  {order_id:'A2',shop_id:'shop-7788',order_status:'MYSTERY',item_count:1,pay_status:'PAID',pay_time:'2026-11-02T03:00:00+08:00',pay_amount:'10.00',pay_currency:'CNY'},
+  {order_id:'A3',shop_id:'shop-7788',order_status:'FULFILLED',item_count:1,pay_status:'PAID',pay_time:'2026-10-20T03:00:00+08:00',pay_amount:'10.00',pay_currency:'CNY'},
+  {order_id:'A4',shop_id:'shop-7788',order_status:'FULFILLED',item_count:1,pay_status:'PAID',pay_time:'2026-11-02T03:00:00+08:00',pay_amount:'0.01',pay_currency:'CNY'}
+ ];
+ const mapped=mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({rows})});
+ assert.deepEqual(mapped.rows.map(r=>r.orderRef),['A4']);
+ assert.ok(mapped.gaps.includes('CURRENCY_OR_AMOUNT_UNVERIFIED'));
+ assert.ok(mapped.gaps.includes('ORDER_OR_PAYMENT_STATUS_UNKNOWN'));
+ assert.equal(mapped.stats.unknownStatus,1);
+});
+
+test('identical retries dedupe while conflicting duplicates are flagged',()=>{
+ const base={order_id:'A1',shop_id:'shop-7788',order_status:'FULFILLED',item_count:1,pay_status:'PAID',pay_time:'2026-11-02T03:00:00+08:00',pay_amount:'10.00',pay_currency:'CNY'};
+ const dedupe=mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({rows:[base,{...base}],storeMappingId:'mapping-nawu-store-1'})});
+ assert.equal(dedupe.stats.duplicates,1);
+ assert.equal(dedupe.rows.length,1);
+ const conflict=mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({rows:[base,{...base,item_count:5}]})});
+ assert.equal(conflict.stats.conflicts,1);
+ assert.ok(conflict.gaps.includes('ORDER_SOURCE_CONFLICT'));
+});
+
+test('paid timestamps must carry an explicit offset',()=>{
+ const rows=[{order_id:'A1',shop_id:'shop-7788',order_status:'FULFILLED',item_count:1,pay_status:'PAID',pay_time:'2026-11-02 03:00:00',pay_amount:'10.00',pay_currency:'CNY'}];
+ const mapped=mapRealExport({contract:approvedTestContract(),exportPayload:exportPayload({rows})});
+ assert.equal(mapped.rows.length,0);
+ assert.ok(mapped.gaps.includes('PAYMENT_STATUS_OR_TIME_UNVERIFIED'));
+});
+
+test('the draft contract on disk is never mutated by test fixtures',()=>{
+ assert.equal(draftContract().status,'DRAFT_PENDING_HUMAN_APPROVAL');
+ assert.equal(draftContract().approval,null);
+ assert.equal(loadRealPaidOrderContract().contract.status,'DRAFT_PENDING_HUMAN_APPROVAL');
+});
