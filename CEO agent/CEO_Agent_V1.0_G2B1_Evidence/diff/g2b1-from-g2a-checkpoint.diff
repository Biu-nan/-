+
+const now=new Date('2026-11-05T01:00:00Z');
+const question=CEO_PAYMENT_QUESTION;
+
+async function setup(t){
+ const root=await mkdtemp(path.join(os.tmpdir(),'b1-loop-'));
+ await writeFile(path.join(root,'.ceo-isolated-fixture.json'),'{"synthetic":true}');
+ const credentials={legacy:{id:'fixture-legacy',profile:'legacy',storeId:'400370',token:'l'.repeat(48)},shadow:{id:'fixture-shadow',profile:'shadow',storeId:'400370',token:'s'.repeat(48)},human:{id:'fixture-human',profile:'human',storeId:'400370',token:'h'.repeat(48)}};
+ const governance=createCeoGovernance({credentials}),p=Object.fromEntries(Object.entries(credentials).map(([k,c])=>[k,governance.authenticateToken(c.token)]));
+ const state={now,chain:realChain()};
+ const clock=()=>state.now;
+ const policy=state.chain.policy;
+ const resolveVersions=createCeoReadinessVersionResolver({dictionaryBytes:realPaidOrderDictionaryBytes,sourcePolicy:policy});
+ const trace=createCeoShadowTrace({fixtureRoot:root,filePath:path.join(root,'events.jsonl'),governance,now:clock});
+ const archive=createCeoReportArchive({fixtureRoot:root,directory:path.join(root,'archive'),governance,resolveVersions,traceReader:x=>trace.read(x),now:clock});
+ const dbPath=path.join(root,'synthetic-tasks.sqlite'),db=new DatabaseSync(dbPath);
+ db.exec('CREATE TABLE ceo_tasks(task_id TEXT,version INTEGER,payload_json TEXT);CREATE TABLE ceo_task_events(event_id INTEGER,task_id TEXT,command TEXT,actor_id TEXT,created_at TEXT,payload_json TEXT)');
+ db.close();
+ const protection={dbPath,before:await readFile(dbPath)};
+ // Verify bytes before cleanup; a failed assert must not be masked by a missing directory.
+ t.after(async()=>{try{assert.deepEqual(await readFile(protection.dbPath),protection.before,'taskboard bytes must not change');}finally{await rm(root,{recursive:true,force:true});}});
+ const domainBuilder=async()=>prepareCeoRealPaymentDomain({fixtureRoot:root,...state.chain,now:clock()});
+ const loop=createCeoPaymentLoop({fixtureRoot:root,governance,archive,trace,resolveVersions,domainBuilder,verificationScope:'REAL',readTaskSnapshot:()=>readCeoTaskSnapshot({dbPath,fixtureRoot:root,offlineSnapshot:true,storeId:'400370',now:clock()}),readWorkflowSnapshot:async()=>readCeoWorkflowState({storeId:'400370',snapshot:{storeId:'400370',version:1,capturedAt:clock().toISOString(),states:[{workflowId:'system.state.read',version:'1',status:'IDLE'}]},now:clock()}),now:clock});
+ return{root,state,p,governance,trace,archive,loop,resolveVersions};
+}
+
+test('a verified real export drives the shared shadow loop end to end',async t=>{
+ const x=await setup(t);
+ const result=await x.loop.analyze({principal:x.p.shadow,requestId:'real-1',question});
+ assert.equal(result.status,'COMPLETE');
+ assert.equal(result.verificationScope,'REAL');
+ const values=result.context.facts.map(f=>f.value);
+ assert.deepEqual(values,[2,3,188.3]);
+ assert.ok(result.context.facts.every(f=>f.quality==='VERIFIED'));
+ assert.ok(result.report.priorities.length<=3&&result.report.priorities.length>0);
+ assert.ok(result.report.priorities.every(p=>p.acceptance&&p.rationale));
+ assert.ok(result.report.claims.some(c=>c.kind==='FACT'&&c.status==='SUPPORTED'));
+ assert.equal(result.report.formalTaskWrites,0);
+ assert.equal(result.report.workflowExecutions,0);
+ assert.ok(result.domainGaps.includes('COMPARISON_PERIOD_MISSING'));
+ const stored=await x.archive.read({principal:x.p.human,reportId:result.reportId});
+ assert.deepEqual(stored.context,result.context);
+ assert.deepEqual(stored.report,result.report);
+ assert.equal(stored.status,'COMPLETE');
+ assert.ok(stored.evidence.some(e=>e.path==='paid-orders.real-export.json'));
+ const approval=JSON.parse(stored.evidence.find(e=>e.path==='approval.real.json').content);
+ assert.equal(approval.scope,'REAL');
+ assert.equal(approval.accepted,true);
+ assert.equal(approval.sourceApproval.reviewerId,'owner-store-data');
+ const events=await x.trace.read({principal:x.p.human,storeId:'400370'});
+ assert.equal(events.length,1);
+ assert.equal(events[0].event.reportId,result.reportId);
+ assert.ok(events[0].event.decisionSummary.includes('"scope":"REAL"'));
+});
+
+test('retrying the same real request replays the original report instead of rereading data',async t=>{
+ const x=await setup(t);
+ const a=await x.loop.analyze({principal:x.p.shadow,requestId:'real-stable',question});
+ // A later export revision must not silently replace the already archived report.
+ x.state.chain=realChain({exportPayload:exportPayload({rows:[{order_id:'AE20261102001',shop_id:'shop-7788',order_status:'FULFILLED',item_count:9,pay_status:'PAID',pay_time:'2026-11-02T03:04:05+08:00',pay_amount:'999.00',pay_currency:'CNY'}]}),revision:2});
+ x.state.now=new Date('2026-11-05T02:00:00Z');
+ const b=await x.loop.analyze({principal:x.p.shadow,requestId:'real-stable',question});
+ assert.equal(b.reportId,a.reportId);
+ assert.equal(b.replayed,true);
+ assert.deepEqual(b.context.facts.map(f=>f.value),[2,3,188.3]);
+ assert.equal((await x.trace.read({principal:x.p.human,storeId:'400370'})).length,1);
+});
+
+test('Human correction on real data keeps the previous report and version history',async t=>{
+ const x=await setup(t);
+ const first=await x.loop.analyze({principal:x.p.shadow,requestId:'real-old',question});
+ x.state.chain=realChain({revision:2,exportPayload:exportPayload({rows:[{order_id:'AE20261102001',shop_id:'shop-7788',order_status:'FULFILLED',item_count:3,pay_status:'PAID',pay_time:'2026-11-02T03:04:05+08:00',pay_amount:'128.40',pay_currency:'CNY'},{order_id:'AE20261102002',shop_id:'shop-7788',order_status:'OPEN',item_count:1,pay_status:'PAID',pay_time:'2026-11-03T11:00:00+08:00',pay_amount:'59.90',pay_currency:'CNY'}]}),approval:approvalEnvelope({approvalRecordId:'approval-real-2026-11-05-02',reviewedAt:'2026-11-05T00:40:00Z'})});
+ const second=await x.loop.correct({humanPrincipal:x.p.human,analysisPrincipal:x.p.shadow,requestId:'real-fix-1',correctsReportId:first.reportId,note:'source owner corrected paid units',question});
+ assert.notEqual(first.reportId,second.reportId);
+ assert.equal(second.context.facts[1].value,4);
+ const oldReport=await x.archive.read({principal:x.p.human,reportId:first.reportId});
+ const newReport=await x.archive.read({principal:x.p.human,reportId:second.reportId});
+ assert.equal(oldReport.context.facts[1].value,3);
+ assert.equal(newReport.correctsReportId,first.reportId);
+ assert.equal(newReport.revision,2);
+ assert.equal(oldReport.revision,1);
+ const events=await x.trace.read({principal:x.p.human,storeId:'400370'});
+ assert.equal(events.length,3);
+ assert.equal(events[1].event.type,'HUMAN_CORRECTION');
+ assert.equal(events[1].event.note,'source owner corrected paid units');
+});
+
+test('a real loop still refuses legacy principals, replayed bodies and formal execution routes over HTTP',async t=>{
+ const x=await setup(t);
+ const stops=[];t.after(async()=>{for(const s of stops.reverse())await s();});
+ const server=await startCeoPaymentReadinessService({fixtureRoot:x.root,governance:x.governance,loop:x.loop,archive:x.archive,analysisPrincipal:x.p.shadow});
+ stops.push(()=>server.stop());
+ const request=(route,body,token='s'.repeat(48))=>fetch(server.baseUrl+route,{method:body?'POST':'GET',headers:{authorization:'Bearer '+token,'content-type':'application/json'},body:body?JSON.stringify(body):undefined});
+ const ok=await request('/api/ceo/payment-readiness',{requestId:'real-http-1',question});
+ assert.equal(ok.status,200);
+ const body=await ok.json();
+ assert.equal(body.verificationScope,'REAL');
+ const stored=await request('/api/ceo/payment-reports/'+body.reportId,null,'h'.repeat(48));
+ assert.equal(stored.status,200);
+ assert.equal((await request('/api/ceo/payment-readiness',{requestId:'legacy-real',question},'l'.repeat(48))).status,403);
+ assert.equal((await request('/api/ceo/payment-readiness',{requestId:'inject',question,facts:[{quality:'VERIFIED'}]})).status,400);
+ assert.equal((await request('/api/workflow/execute',{commit:true})).status,403);
+});
+
+test('the loop rejects an unknown verification scope label at construction',async t=>{
+ const x=await setup(t);
+ assert.throws(()=>createCeoPaymentLoop({fixtureRoot:x.root,governance:x.governance,archive:x.archive,trace:x.trace,resolveVersions:x.resolveVersions,domainBuilder:async()=>x,verificationScope:'real-lower',readTaskSnapshot:()=>{},readWorkflowSnapshot:()=>{},now:()=>now}),{code:'INVALID_VERIFICATION_SCOPE'});
+});
