+  "version": "real.v1-draft-1",
+  "status": "DRAFT_PENDING_HUMAN_APPROVAL",
+  "testOnly": false,
+  "approval": null,
+  "intendedDomain": "纳物一店订单支付表现",
+  "storeMappingId": "mapping-nawu-store-1",
+  "sourceKind": "OWN_STORE_ORDER_EXPORT",
+  "sourceOwner": "UNVERIFIED",
+  "exportFormat": "CLOSED_PERIOD_DEIDENTIFIED_JSON_ROWS",
+  "exportEnvelope": {
+    "required": [
+      "schema",
+      "exportId",
+      "storeMappingId",
+      "period",
+      "exportedAt",
+      "coverage",
+      "currency",
+      "columns",
+      "rows"
+    ],
+    "schemaValue": "ceo-real-paid-export/v1",
+    "columnsDefinition": "Canonical field to exact export column name. The exporter owns the names; the runtime never guesses them."
+  },
+  "canonicalFields": {
+    "orderRef": { "type": "STRING", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$", "definition": "Platform order reference after de-identification; must be stable and unique within the store." },
+    "storeRef": { "type": "STRING", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$", "definition": "Platform shop reference; must equal the approved store mapping platformShopId." },
+    "orderStatus": { "type": "ENUM", "values": ["OPEN", "FULFILLED", "CANCELLED", "REFUNDED", "PARTIALLY_REFUNDED"], "definition": "Order lifecycle state at export time, not at payment time." },
+    "itemCount": { "type": "INTEGER", "min": 0, "max": 100000, "definition": "Paid item units on the order. Bundles are counted as sold units, not as component SKUs." },
+    "paymentStatus": { "type": "ENUM", "values": ["PAID", "UNPAID"], "definition": "Whether a payment event exists for this order within the closed period." },
+    "paidAt": { "type": "TIMESTAMP_WITH_OFFSET", "definition": "Timestamp of the first successful payment event; attributed to a business day in period.timeZone." },
+    "paidAmount": { "type": "DECIMAL_STRING", "scale": 2, "min": "0", "definition": "Gross amount actually paid, before refunds and platform deductions." },
+    "paidCurrency": { "type": "CURRENCY", "values": ["CNY"], "definition": "Settlement currency of paidAmount. No cross-currency conversion is performed." }
+  },
+  "forbiddenExportFields": [
+    "buyer_email",
+    "buyer_name",
+    "buyer_phone",
+    "consignee",
+    "shipping_address",
+    "id_card",
+    "passport",
+    "card_number",
+    "payment_credential",
+    "access_token"
+  ],
+  "periodSemantics": {
+    "closedPeriodRequired": true,
+    "dateInclusive": true,
+    "ianaTimeZoneRequired": true,
+    "attribution": "PAYMENT_EVENT_DAY",
+    "comparisonPeriodRequired": false,
+    "note": "Comparison period stays a declared gap until an equal-length approved snapshot exists."
+  },
+  "currency": { "code": "CNY", "minorUnit": "cent", "conversion": "NONE", "refundTreatment": "GROSS_PAID_ONLY" },
+  "coverage": { "allowed": ["COMPLETE"], "definition": "COMPLETE means every paid order in the closed period is present. Partial exports must be declared and are not admissible." },
+  "paidStatusDefinition": "An order counts as paid when at least one successful payment event exists inside the closed period. Cancelled or refunded orders may still carry a paid event; gross paid amount is not net revenue.",
+  "approvalRequirements": [
+    "approverId",
+    "approverRole",
+    "approvedAt",
+    "contractHash",
+    "snapshotHash",
+    "periodHash",
+    "storeMappingHash",
+    "validUntil",
+    "retentionPolicy"
+  ],
+  "knownGaps": [
+    "REAL_SOURCE_OWNER_UNVERIFIED",
+    "EXPORT_COLUMNS_UNCONFIRMED_BY_SOURCE",
+    "COMPARISON_PERIOD_MISSING",
+    "REFUNDS_AND_NET_INCOME_UNVERIFIED",
+    "COSTS_AND_PENALTIES_UNVERIFIED"
+  ],
+  "acceptanceCriteria": [
+    "Source owner and shop mapping are verified before the contract can leave DRAFT.",
+    "A closed-period, isolated, de-identified export is produced by the source owner, not by this runtime.",
+    "Every canonical field resolves to an exporter-owned column; no positional or name-based guessing.",
+    "Approval binds contractHash, snapshotHash, periodHash and storeMappingHash to immutable bytes.",
+    "Unknown status, currency, unit or coverage yields a declared gap, never a zero."
+  ]
+}
