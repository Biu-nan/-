index 0000000..465bf07
--- /dev/null
+++ b/dist/test/ceo-store-mapping.test.js
@@ -0,0 +1,135 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {loadStoreMappingRegistry,evaluateStoreMapping,requireVerifiedStoreMapping,validateRegistry,findMapping} from '../src/ceo-store-mapping.js';
+import {contentHash} from '../src/ceo-vnext-common.js';
+
+const now=new Date('2026-11-05T00:00:00Z');
+const hash=v=>contentHash(v);
+
+function shipped(){return loadStoreMappingRegistry();}
+
+function registry({reviewers=['owner-approved-mapping'],stores=null,migration=false}={}){
+ const base=JSON.parse(JSON.stringify(shipped().registry));
+ base.authorityReviewers=reviewers;
+ base.identityMigrationAllowed=migration;
+ if(stores)base.stores=stores;
+ return validateRegistry(base);
+}
+
+/** A fully-formed mapping whose approval is bound to its own bytes. */
+function verifiedMapping(overrides={}){
+ const record={mappingId:'mapping-nawu-store-1',storeAlias:'纳物一店',platform:'aliexpress-choice',ceoStoreId:'400370',environmentId:'400370',platformShopId:'shop-7788',authorityRecordId:'authority-2026-11-05-01',approvedBy:'owner-approved-mapping',approvedAt:'2026-11-04T12:00:00Z',validUntil:'2026-12-31T00:00:00Z',mappingHash:null,declaredStatus:'UNVERIFIED',...overrides};
+ const {notes,...core}=record;
+ return {...record,mappingHash:hash({...core,mappingHash:null})};
+}
+
+test('shipped registry keeps the real store mapping UNVERIFIED and offers no reviewer that could self-approve',()=>{
+ const loaded=shipped();
+ assert.equal(loaded.registry.identityMigrationAllowed,false);
+ assert.deepEqual(loaded.registry.authorityReviewers,[]);
+ const mapping=findMapping(loaded,'mapping-nawu-store-1');
+ assert.ok(mapping);
+ const evaluation=evaluateStoreMapping({mapping,registry:loaded,now});
+ assert.equal(evaluation.status,'UNVERIFIED');
+ assert.equal(evaluation.authorityGranted,false);
+ assert.ok(evaluation.missing.includes('PLATFORM_SHOP_ID_MISSING'));
+ assert.ok(evaluation.missing.includes('AUTHORITY_RECORD_MISSING'));
+ assert.ok(evaluation.missing.includes('APPROVER_MISSING'));
+ assert.ok(evaluation.missing.includes('NO_AUTHORITY_REVIEWER_REGISTERED'));
+ assert.throws(()=>requireVerifiedStoreMapping({mapping,registry:loaded,now}),{code:'STORE_MAPPING_UNVERIFIED'});
+});
+
+test('a declared VERIFIED status inside the registry is rejected as a claim, not evidence',()=>{
+ const base=JSON.parse(JSON.stringify(shipped().registry));
+ base.stores[0].declaredStatus='VERIFIED';
+ assert.throws(()=>validateRegistry(base),/DECLARED_STATUS_IS_NOT_AUTHORITY/);
+});
+
+test('re-pointing the CEO store scope is refused instead of silently migrating identity',()=>{
+ const loaded=registry();
+ const evaluation=evaluateStoreMapping({mapping:verifiedMapping({ceoStoreId:'999999'}),registry:loaded,now});
+ assert.equal(evaluation.status,'REJECTED');
+ assert.ok(evaluation.rejected.includes('CEO_STORE_SCOPE_MISMATCH'));
+ assert.equal(evaluation.authorityGranted,false);
+});
+
+test('identity migration flag cannot be turned on through the registry',()=>{
+ const base=JSON.parse(JSON.stringify(shipped().registry));
+ base.identityMigrationAllowed=true;
+ assert.throws(()=>validateRegistry(base),/IDENTITY_MIGRATION_NOT_ALLOWED/);
+});
+
+test('a complete owner-approved mapping becomes VERIFIED only when the approval is bound to its exact bytes',()=>{
+ const loaded=registry();
+ const mapping=verifiedMapping();
+ const evaluation=evaluateStoreMapping({mapping,registry:loaded,now});
+ assert.equal(evaluation.status,'VERIFIED',JSON.stringify(evaluation.reasons));
+ assert.equal(evaluation.authorityGranted,true);
+ assert.equal(evaluation.mappingHash,mapping.mappingHash);
+ assert.deepEqual(evaluation.reasons,[]);
+ assert.equal(requireVerifiedStoreMapping({mapping,registry:loaded,now}).status,'VERIFIED');
+});
+
+test('editing an approved field without re-approval invalidates the binding',()=>{
+ const loaded=registry();
+ const tampered=verifiedMapping();
+ tampered.platformShopId='shop-9999';
+ const evaluation=evaluateStoreMapping({mapping:tampered,registry:loaded,now});
+ assert.equal(evaluation.status,'REJECTED');
+ assert.ok(evaluation.rejected.includes('APPROVAL_NOT_BOUND_TO_BYTES'));
+});
+
+test('an approver outside the registered authority list is rejected',()=>{
+ const loaded=registry({reviewers:['someone-else']});
+ const evaluation=evaluateStoreMapping({mapping:verifiedMapping(),registry:loaded,now});
+ assert.equal(evaluation.status,'REJECTED');
+ assert.ok(evaluation.rejected.includes('APPROVER_NOT_IN_REGISTRY'));
+});
+
+test('an expired mapping is EXPIRED and still refuses authority',()=>{
+ const loaded=registry();
+ const evaluation=evaluateStoreMapping({mapping:verifiedMapping({validUntil:'2026-11-01T00:00:00Z',approvedAt:'2026-10-01T00:00:00Z'}),registry:loaded,now});
+ assert.equal(evaluation.status,'EXPIRED');
+ assert.throws(()=>requireVerifiedStoreMapping({mapping:verifiedMapping({validUntil:'2026-11-01T00:00:00Z',approvedAt:'2026-10-01T00:00:00Z'}),registry:loaded,now}),{code:'STORE_MAPPING_EXPIRED'});
+});
+
+test('a mapping absent from the registry cannot be injected by the caller',()=>{
+ const loaded=registry();
+ const evaluation=evaluateStoreMapping({mapping:verifiedMapping({mappingId:'mapping-injected'}),registry:loaded,now});
+ assert.equal(evaluation.status,'REJECTED');
+ assert.ok(evaluation.rejected.includes('MAPPING_NOT_IN_REGISTRY'));
+});
+
+test('malformed shop or authority identifiers fail closed',()=>{
+ const loaded=registry();
+ const bad=evaluateStoreMapping({mapping:verifiedMapping({platformShopId:'shop 7788',authorityRecordId:'../etc/passwd'}),registry:loaded,now});
+ assert.equal(bad.status,'REJECTED');
+ assert.ok(bad.rejected.includes('PLATFORM_SHOP_ID_MALFORMED'));
+ assert.ok(bad.rejected.includes('AUTHORITY_RECORD_MALFORMED'));
+});
+
+test('future-dated approval and inverted validity windows are rejected',()=>{
+ const loaded=registry();
+ const future=evaluateStoreMapping({mapping:verifiedMapping({approvedAt:'2027-01-01T00:00:00Z'}),registry:loaded,now});
+ assert.equal(future.status,'REJECTED');
+ assert.ok(future.rejected.includes('APPROVED_AT_INVALID'));
+ const inverted=evaluateStoreMapping({mapping:verifiedMapping({approvedAt:'2026-12-30T00:00:00Z',validUntil:'2026-12-01T00:00:00Z'}),registry:loaded,now});
+ assert.equal(inverted.status,'REJECTED');
+ assert.ok(inverted.rejected.includes('VALIDITY_WINDOW_INVALID'));
+});
+
+test('evaluation is deterministic and the loaded registry is deeply frozen against later tampering',()=>{
+ const loaded=registry();
+ const mapping=verifiedMapping();
+ const a=evaluateStoreMapping({mapping,registry:loaded,now});
+ assert.ok(Object.isFrozen(loaded.registry));
+ assert.ok(Object.isFrozen(loaded.registry.stores[0]));
+ assert.throws(()=>{loaded.registry.stores[0].notes='mutated';},TypeError);
+ const b=evaluateStoreMapping({mapping,registry:loaded,now});
+ assert.equal(a.status,b.status);
+ assert.equal(a.mappingHash,b.mappingHash);
+ assert.equal(a.registryHash,b.registryHash);
+ assert.ok(Object.isFrozen(a));
+ const fresh=registry();
+ assert.equal(fresh.registryHash,loaded.registryHash);
+});
