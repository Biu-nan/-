+}
+
+/**
+ * @param {object} args
+ * @param {string} args.fixtureRoot   required only to exercise test-only contracts/policies
+ * @param {object} args.contract      real paid-order export contract
+ * @param {object} args.policy        real source policy
+ * @param {object} args.mapping       one store mapping record
+ * @param {object} args.registry      store mapping registry (authority root)
+ * @param {object} args.exportPayload exporter-produced, closed-period, de-identified export
+ * @param {object} args.approval      {approvalRecordId,reviewerId,reviewedAt,retentionPolicy}
+ * @param {number} args.revision      monotonic source revision for this snapshot
+ */
+export function prepareCeoRealPaymentDomain({fixtureRoot,contract,policy,mapping,registry,exportPayload,approval,revision,now=new Date()}={}){
+ if(!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_PAYMENT_SNAPSHOT');
+ if(!Number.isSafeInteger(revision)||revision<1)fail('INVALID_PAYMENT_SNAPSHOT');
+ const contractGate=requireApprovedRealContract({contract,fixtureRoot,now});
+ const policyGate=requireApprovedRealPolicy({policy,fixtureRoot,now});
+ const mappingGate=requireVerifiedStoreMapping({mapping,registry,now});
+ // The store mapping and the source policy must describe the same CEO store scope.
+ if(mappingGate.ceoStoreId!==policyGate.policy.storeId)fail('STORE_SCOPE_MISMATCH');
+ const mapped=mapRealExport({contract:contractGate.contract,exportPayload});
+ // The export carries the platform shop reference; the mapping turns it into the CEO store
+ // scope. More than one shop in a single-store export means the file is not admissible.
+ const storeRefs=[...new Set(mapped.rows.map(r=>r.storeId))];
+ if(storeRefs.length>1)fail('STORE_REF_MISMATCH');
+ if(storeRefs.length===1&&storeRefs[0]!==mapping.platformShopId)fail('STORE_REF_MISMATCH');
+ if(mapped.rows.some(r=>typeof r.orderRef==='string'&&r.orderRef.startsWith('syn-')))fail('SYNTHETIC_MARKER_IN_REAL_EXPORT');
+ // A fully verified empty export is a genuine zero; rows are re-scoped only after the shop ref matched.
+ const scopedRows=mapped.rows.map(r=>({...structuredClone(r),storeId:mappingGate.ceoStoreId}));
+ const snapshot={schema:'ceo-paid-order-snapshot/v1',mode:'REAL',revision,storeId:mappingGate.ceoStoreId,sourceKind:'OWN_STORE_ORDER_EXPORT',period:structuredClone(mapped.period),exportedAt:mapped.exportedAt,coverage:mapped.coverage,currency:mapped.currency,rows:scopedRows};
+ if(!approval||typeof approval!=='object'||Array.isArray(approval))fail('REAL_APPROVAL_REQUIRED');
+ if(!exact(approval,['approvalRecordId','reviewerId','reviewedAt','retentionPolicy'])||!ID.test(approval.approvalRecordId??'')||!safeText(approval.retentionPolicy))fail('REAL_APPROVAL_REQUIRED');
+ if(typeof approval.reviewerId!=='string'||approval.reviewerId.startsWith('fixture-')||!policyGate.policy.approvedReviewers.includes(approval.reviewerId))fail('REAL_APPROVAL_REVIEWER_UNAUTHORIZED');
+ if(!registry.registry.authorityReviewers.includes(approval.reviewerId))fail('REAL_APPROVAL_REVIEWER_UNAUTHORIZED');
+ if(!timestamp(approval.reviewedAt)||Date.parse(approval.reviewedAt)<Date.parse(mapped.exportedAt)||Date.parse(approval.reviewedAt)>+now)fail('REAL_APPROVAL_TIME_INVALID');
+ const snapshotContent=JSON.stringify(snapshot);
+ const envelope={scope:'REAL',storeId:snapshot.storeId,snapshotHash:sha(snapshotContent),periodHash:contentHash(snapshot.period),reviewerId:approval.reviewerId,reviewedAt:approval.reviewedAt};
+ const resolved=new Set(['REAL_SOURCE_OWNER_UNVERIFIED','EXPORT_COLUMNS_UNCONFIRMED_BY_SOURCE']);
+ const baseGaps=[...contractGate.contract.knownGaps.filter(g=>!resolved.has(g)),...mapped.gaps];
+ const source=Object.freeze({
+  mode:'REAL',storeId:mappingGate.ceoStoreId,sourceKind:'OWN_STORE_ORDER_EXPORT',
+  orderRefPattern:new RegExp(contractGate.contract.canonicalFields.orderRef.pattern),
+  sourcePath:'paid-orders.real-export.json',sourceId:policyGate.policy.sourceIds[0],
+  approvalPath:'approval.real.json',approvalScope:'REAL',
+  baseGaps,verificationScope:'REAL',eventBasis:'PAID_EVENT_GROSS'
+ });
+ const domain=buildPaidOrderDomain({source,snapshot,approval:envelope,policy:policyGate.policy,dictionaryBytes:realPaidOrderDictionaryBytes,now});
+ return freeze({
+  ...domain,
+  baseDictionaryHash:realPaidOrderBaseDictionaryHash,
+  realEvidence:freeze({
+   schema:'ceo-real-paid-evidence/v1',
+   contractVersion:contractGate.contract.version,
+   contractHash:contractGate.contractHash,
+   policyVersion:policyGate.policy.version,
+   policyHash:policyGate.policyHash,
+   mappingHash:mappingGate.mappingHash,
+   registryHash:mappingGate.registryHash,
+   storeAlias:mappingGate.storeAlias,
+   platformShopId:mapping.platformShopId,
+   exportId:mapped.exportId,
+   snapshotHash:envelope.snapshotHash,
+   periodHash:envelope.periodHash,
+   reviewerId:approval.reviewerId,
+   approvalRecordId:approval.approvalRecordId,
+   reviewedAt:approval.reviewedAt,
+   stats:mapped.stats,
+   exportGaps:[...mapped.gaps]
+  })
+ });
+}
