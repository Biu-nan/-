+      }
+    },
+    "failed": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["checkId", "code"],
+        "properties": {
+          "checkId": { "type": "string" },
+          "code": { "type": ["string", "null"] }
+        }
+      }
+    },
+    "notEvaluated": { "type": "array", "items": { "type": "string" } },
+    "exportGaps": { "type": "array", "items": { "type": "string" } },
+    "stats": { "type": ["object", "null"] },
+    "contractHash": { "type": ["string", "null"] },
+    "policyHash": { "type": ["string", "null"] },
+    "mappingHash": { "type": ["string", "null"] },
+    "evaluatedAt": { "type": "string" },
+    "domainCode": { "type": ["string", "null"] },
+    "receipt": { "type": "string", "pattern": "^verify-[a-f0-9]{64}$" },
+    "domain": { "type": ["object", "null"] }
+  }
+}
