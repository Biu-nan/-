+ if(Number((cents/100).toFixed(2))!==Number(text))return null;
+ return cents;
+};
+
+/**
+ * Structural validation of an exporter payload against an approved contract.
+ * Structural violations throw; genuine data uncertainty is returned as gaps.
+ */
+export function mapRealExport({contract,exportPayload}={}){
+ const checked=validateRealContract(contract);
+ if(!checked.approval)fail('REAL_CONTRACT_NOT_APPROVED');
+ const payload=exportPayload;
+ if(!exact(payload,ENVELOPE_KEYS)||payload.schema!==checked.exportEnvelope.schemaValue)fail('REAL_EXPORT_ENVELOPE_INVALID');
+ if(!ID.test(payload.exportId??''))fail('REAL_EXPORT_ENVELOPE_INVALID');
+ if(payload.storeMappingId!==checked.storeMappingId)fail('REAL_EXPORT_STORE_MAPPING_MISMATCH');
+ const period=payload.period;
+ if(!period||typeof period!=='object'||Array.isArray(period))fail('REAL_EXPORT_PERIOD_INVALID');
+ if(!exact(period,['start','end','timeZone']))fail('REAL_EXPORT_PERIOD_INVALID');
+ if(![period.start,period.end].every(s=>typeof s==='string'&&DATE.test(s)&&Number.isFinite(Date.parse(s))&&new Date(s).toISOString().slice(0,10)===s))fail('REAL_EXPORT_PERIOD_INVALID');
+ if(period.start>period.end)fail('REAL_EXPORT_PERIOD_INVALID');
+ if(typeof period.timeZone!=='string'||!period.timeZone)fail('REAL_EXPORT_TIMEZONE_REQUIRED');
+ try{new Intl.DateTimeFormat('en',{timeZone:period.timeZone});}catch{fail('REAL_EXPORT_TIMEZONE_REQUIRED');}
+ if(!timestamp(payload.exportedAt))fail('REAL_EXPORT_ENVELOPE_INVALID');
+ const formatter=new Intl.DateTimeFormat('en-CA',{timeZone:period.timeZone,year:'numeric',month:'2-digit',day:'2-digit'});
+ // A closed period means the exporter produced the file on a business day after the last included day.
+ if(formatter.format(new Date(Date.parse(payload.exportedAt)))<=period.end)fail('REAL_EXPORT_NOT_CLOSED_PERIOD');
+ if(payload.coverage!=='COMPLETE')fail('REAL_EXPORT_COVERAGE_INCOMPLETE');
+ if(payload.currency!==checked.currency.code)fail('REAL_EXPORT_CURRENCY_MISMATCH');
+ const columns=payload.columns;
+ if(!columns||typeof columns!=='object'||Array.isArray(columns)||!exact(columns,Object.keys(checked.canonicalFields)))fail('REAL_EXPORT_COLUMNS_MISMATCH');
+ const names=Object.values(columns);
+ if(new Set(names).size!==names.length||names.some(n=>!safeText(n)||n.length>80))fail('REAL_EXPORT_COLUMNS_MISMATCH');
+ if(!Array.isArray(payload.rows)||payload.rows.length>50000)fail('REAL_EXPORT_ENVELOPE_INVALID');
+ const forbidden=new Set(checked.forbiddenExportFields.map(f=>f.toLowerCase()));
+ const allowed=new Set(names);
+ const gaps=new Set(),rows=[],seen=new Map();
+ let conflicts=0,duplicates=0,unknownStatus=0,unknownCurrency=0,missingUnits=0;
+ for(const row of payload.rows){
+  if(!row||typeof row!=='object'||Array.isArray(row))fail('REAL_EXPORT_ROW_INVALID');
+  const keys=Object.keys(row);
+  for(const key of keys){
+   if(forbidden.has(key.toLowerCase()))fail('REAL_EXPORT_PII_REJECTED');
+   if(!allowed.has(key))fail('REAL_EXPORT_COLUMNS_MISMATCH');
+  }
+  if(keys.length!==allowed.size)fail('REAL_EXPORT_COLUMNS_MISMATCH');
+  const pick=field=>row[columns[field]];
+  const orderRef=pick('orderRef'),storeRef=pick('storeRef'),orderStatus=pick('orderStatus'),itemCount=pick('itemCount'),paymentStatus=pick('paymentStatus'),paidAt=pick('paidAt'),paidAmount=pick('paidAmount'),paidCurrency=pick('paidCurrency');
+  if(typeof orderRef!=='string'||!new RegExp(checked.canonicalFields.orderRef.pattern).test(orderRef)||orderRef.length>80)fail('REAL_EXPORT_ROW_INVALID');
+  if(typeof storeRef!=='string'||!new RegExp(checked.canonicalFields.storeRef.pattern).test(storeRef))fail('REAL_EXPORT_ROW_INVALID');
+  const canonicalStatus=checked.canonicalFields.orderStatus.values.includes(orderStatus)?orderStatus:null;
+  const payment=checked.canonicalFields.paymentStatus.values.includes(paymentStatus)?paymentStatus:null;
+  if(!canonicalStatus||!payment){unknownStatus++;gaps.add('ORDER_OR_PAYMENT_STATUS_UNKNOWN');continue;}
+  if(!Number.isSafeInteger(itemCount)||itemCount<0||itemCount>100000){missingUnits++;gaps.add('PAID_UNITS_MISSING');}
+  if(paidCurrency!==payload.currency&&paidCurrency!==null&&paidCurrency!==undefined){unknownCurrency++;gaps.add('CURRENCY_OR_AMOUNT_UNVERIFIED');continue;}
+  let cents=null;
+  if(payment==='PAID'){
+   if(!timestamp(paidAt)){gaps.add('PAYMENT_STATUS_OR_TIME_UNVERIFIED');continue;}
+   // A payment outside the closed period is out of scope for this snapshot, not an error.
+   const day=formatter.format(new Date(Date.parse(paidAt)));
+   if(day<period.start||day>period.end)continue;
+   cents=decimalCents(paidAmount);
+   if(cents===null){gaps.add('CURRENCY_OR_AMOUNT_UNVERIFIED');continue;}
+  }else if(paidAt!==null&&paidAt!==undefined&&paidAt!==''){gaps.add('PAYMENT_STATUS_OR_TIME_UNVERIFIED');continue;}
