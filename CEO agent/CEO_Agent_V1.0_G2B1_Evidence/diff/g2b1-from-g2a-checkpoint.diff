+ if(!approval||typeof approval!=='object'||Array.isArray(approval)||!exact(approval,['approvedBy','approvedAt','validUntil','policyHash','retentionPolicy']))fail('REAL_POLICY_APPROVAL_MISSING');
+ if(!timestamp(approval.approvedAt)||Date.parse(approval.approvedAt)>+now)fail('REAL_POLICY_APPROVAL_INVALID');
+ if(!timestamp(approval.validUntil)||Date.parse(approval.validUntil)<=+now)fail('REAL_POLICY_EXPIRED');
+ // Full policy shape (including the byte-bound approval) is enforced by the context builder.
+ assertCeoSourcePolicy(p);
