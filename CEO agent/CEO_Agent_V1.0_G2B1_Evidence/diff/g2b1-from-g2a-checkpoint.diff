+  const {manifestHash,...body}=m;if(!HASH.test(manifestHash??'')||contentHash(body)!==manifestHash||m.reportId!==reportId||m.schema!=='ceo-full-report-archive/v1'||!plain(m.objects)||!Array.isArray(m.evidence)||!['context','report','versions','taskSnapshot','workflowState'].every(k=>m.objects[k]))fail('ARCHIVE_CORRUPT');return m;
