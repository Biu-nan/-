+   if(verified!==3)domain=null;
+  }else{domainCode=result.code;failByCode('SNAPSHOT_ADMISSIBLE',result.code);}
+ }else set('SNAPSHOT_ADMISSIBLE',false,'PREREQUISITE_FAILED');
