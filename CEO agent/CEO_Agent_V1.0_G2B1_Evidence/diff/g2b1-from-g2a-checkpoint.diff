+    "checks": {
+      "type": "array",
+      "minItems": 15,
+      "maxItems": 15,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["checkId", "ok", "code", "evaluated"],
+        "properties": {
+          "checkId": {
+            "enum": [
+              "CONTRACT_APPROVED", "CONTRACT_BOUND", "POLICY_APPROVED", "STORE_MAPPING_VERIFIED",
+              "STORE_SCOPE_ALIGNED", "REVIEWER_AUTHORIZED", "STORE_REF_BOUND", "EXPORT_COLUMNS_CONTRACTED",
+              "NO_PERSONAL_DATA", "CLOSED_PERIOD", "TIMEZONE_DECLARED", "CURRENCY_DECLARED",
