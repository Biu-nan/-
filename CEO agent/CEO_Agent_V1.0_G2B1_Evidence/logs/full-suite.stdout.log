                      <button id="importInsertListingContentButton" class="button secondary" title="当文案已生成但未回传时，从当前 ChatGPT 对话恢复">从当前 ChatGPT 导入</button>
                      <button id="previewInsertStockSheetButton" class="button secondary">写入内胆库存尺寸表</button>
                      <button id="archiveInsertButton" class="button secondary">完成并归档内胆任务</button>
                    </div>
                    <details id="insertListingContentBox" class="result-box hidden">
                      <summary>查看内胆 Listing 文案</summary><pre id="insertListingContentText"></pre>
                    </details>
                    <div id="insertStockSheetPreview" class="result-box hidden"></div>
                    <button id="insertNextProductButton" class="button secondary wide">
                      开始下一个内胆任务
