                      <button type="button" class="board-metric" data-sb-filter="ready"><strong id="sbMetricReady">0</strong><span>待制作 Listing</span></button>
                      <button type="button" class="board-metric" data-sb-filter="listing"><strong id="sbMetricListing">0</strong><span>Listing 中</span></button>
                      <button type="button" class="board-metric" data-sb-filter="synced"><strong id="sbMetricSaved">0</strong><span>已存店小秘</span></button>
                    </div>
        
                    <article class="panel board-create-card">
                      <div class="profile-card-heading">
                        <div>
                          <span class="mini-label">NEW CANDIDATE</span>
                          <h3>录入一个候选</h3>
                        </div>
                        <button id="sbToggleCreate" class="text-button" type="button">收起</button>
                      </div>
                      <div id="sbCreateBody" class="board-create-body">
                        <div class="board-form-grid">
                          <label>产品名称
                            <input id="sbName" type="text" placeholder="如：帆布多格笔袋 / 真空压缩收纳袋" />
                          </label>
                          <label>来源平台
                            <input id="sbPlatform" type="text" placeholder="1688 / AliExpress / 线下" />
                          </label>
                          <label class="span2">来源 URL
                            <input id="sbSourceUrl" type="text" placeholder="https://detail.1688.com/offer/xxxx.html" spellcheck="false" />
                          </label>
                          <label class="span2">客观信息（人工已确认的参数，AI 不得猜测）
                            <textarea id="sbObjectiveInfo" rows="3" placeholder="规格：20 × 15 × 8 cm&#10;材质：帆布 + EVA&#10;重量：320 g&#10;产地：中国广东" spellcheck="false"></textarea>
                          </label>
                          <label class="span2">图片直链（每行一个，最多 12 条）
                            <textarea id="sbImageUrls" rows="2" placeholder="https://cbu01.alicdn.com/img/ibank/xxxx.jpg" spellcheck="false"></textarea>
                          </label>
                          <div class="span2 board-form-actions">
                            <button id="sbCreateButton" class="button primary" type="button">＋ 加入看板</button>
                            <label class="button secondary compact-button" for="sbCreateImages">选择本地图片</label>
                            <input id="sbCreateImages" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple hidden />
                            <span id="sbCreateImagesHint" class="board-hint">可选，也可加入后再补图</span>
                            <span id="sbCreateStatus" class="board-status"></span>
                          </div>
                        </div>
                      </div>
                    </article>
        
                    <article class="panel board-table-card">
                      <div class="profile-card-heading">
                        <div>
                          <span class="mini-label">CANDIDATES</span>
                          <h3>候选清单</h3>
                        </div>
                        <div class="board-table-tools">
                          <input id="sbSearch" type="search" placeholder="搜索名称 / 来源" />
                          <select id="sbStatusFilter">
                            <option value="">全部状态</option>
                          </select>
                          <button id="sbRefreshButton" class="text-button" type="button">刷新</button>
                        </div>
                      </div>
                      <div class="board-table-wrap">
                        <table class="board-table">
                          <thead>
                            <tr>
                              <th class="col-seq">#</th>
                              <th class="col-thumb">图</th>
                              <th class="col-product">产品</th>
