        });
        elements.gotoSelectionRadarFromEntryLink?.addEventListener("click", (event) => {
          event.preventDefault();
          /* 先切到 luxury_insert 模式再进 selection-radar（选款视图需要该模式） */
          if (window.latestPayload?.state?.workflowMode !== "luxury_insert") {
