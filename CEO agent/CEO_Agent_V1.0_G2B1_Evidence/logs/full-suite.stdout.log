                        <div>
                          <button class="flow-secondary-action" type="button" data-flow-step="content">跳过，直接进入 Listing</button>
                          <button class="flow-primary-action" type="button" data-flow-step="planning">保存并进入市场调研</button>
                        </div>
                      </div>
                      <div class="listing-entry-cards-row hidden" id="listingEntryCardsRow">
