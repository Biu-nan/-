                            <div><span class="mini-label">NEW PRODUCT</span><h3>新建商品档案</h3></div>
                          </div>
                          <div class="form-grid two">
                            <label class="wide">商品名称<input id="newProductDisplayName" maxlength="120" placeholder="例如：Dior Book Tote 棕色毛毡内胆 / 透明番茄 PVC 拉链钥匙扣 / 行李箱轮" /></label>
