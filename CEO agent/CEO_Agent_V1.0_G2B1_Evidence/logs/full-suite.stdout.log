                      <label><input type="checkbox" data-claim="waterproof" />Waterproof</label>
                      <label><input type="checkbox" data-claim="tearResistant" />High Tear Resistance</label>
                      <label><input type="checkbox" data-claim="colorfast" />Color Fastness</label>
                    </fieldset>
                    <div class="row-actions">
                      <button id="unlockDesignButton" class="button warning hidden">返回修改内胆方案</button>
                      <button id="freezeDesignButton" class="button primary">确认并冻结最终产品事实</button>
                    </div>
                    <div id="linerUploadGrid" class="liner-upload-grid"></div>
                  </article>
        
                  <article class="insert-step-card">
                    <header><span>05</span><div><h3>Image 01–07 Prompt Pack 与逐图生成</h3><p>主推 SKU 用于 Image 01–06，全部 SKU 汇总到 Image 07。</p></div></header>
                    <div id="insertGenerationSteps" class="generation-steps seven"></div>
                    <div class="row-actions">
