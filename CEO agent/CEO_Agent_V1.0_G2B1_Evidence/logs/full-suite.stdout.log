                        <strong>选择或拖入产品图片</strong>
                        <span id="folderHint">支持 JPG、PNG、WEBP，单张不超过 15 MB</span>
                      </label>
                      <div id="urlImportPanel" class="url-import">
                        <div>
                          <strong>通过图片直链导入</strong>
                          <p id="urlImportHint">每行一个公开图片 URL，最多 12 条。</p>
                        </div>
                        <textarea
                          id="imageUrls"
                          placeholder="https://example.com/product-image.jpg"
                          spellcheck="false"
                        ></textarea>
                        <button id="importUrlsButton" class="button secondary">导入 URL</button>
                      </div>
                      <div id="objectiveInfoPanel" class="objective-info-panel">
