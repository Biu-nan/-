                        <button id="importCurrentChatMarketRadarButton" class="button secondary" title="当 ChatGPT 已生成答案但网页未显示时，从当前对话导入">从当前 ChatGPT 导入</button>
                        <button id="recoverMarketRadarButton" class="button secondary" title="当候选数据未显示但磁盘有文件时，尝试恢复">从磁盘恢复</button>
                        <button id="resetInsertMarketRadarButton" class="button secondary">重置每日选款</button>
                        <span id="selectionRadarStatus" class="selection-radar-status hidden"></span>
                      </div>
                      <div id="insertMarketRadarMeta" class="radar-meta hidden"></div>
                      <div id="insertMarketRadarCandidates" class="radar-candidates hidden"></div>
