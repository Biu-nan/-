                  </div>
                  ${busy ? `<div class="bl-hint">采集箱上架进行中，进度每秒刷新…</div>` : ""}
                  <div id="blc-heartbeat" class="bl-heartbeat"></div>
                  ${(batchListingState.explore) ? `<pre class="bl-explore">${blEscapeHtml(batchListingState.explore)}</pre>` : ""}
                </div>
        
                ${rows.length ? `
