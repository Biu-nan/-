          }
          // 节流拉取 listing 资料就绪状态（SOP 守卫可视化）
          dxCheckFactsStatus();
        }
        
        /* ───────────────────────── 批量流水线上架（Batch Listing，v1.4.0）───────────────────────── */
        const batchListingState = { rows: [], uploaded: false, busy: false, active: false, summary: null, generated: "", mode: "reference", explore: "", importing: false, importInfo: null };
        let batchListingSig = "";
        const BL_STATUS_LABEL = { idle: "待上架", running: "进行中", done: "成功", failed: "失败", skipped: "跳过" };
        
        function blEscapeHtml(s) {
          return String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]));
        }
        
        // 批量上架表格辅助：把"启用"列/勾选与"自定义名称"文本统一成有效值
        // 规则（用户约定）：只要自定义名称列填了内容，即视为启用并采用该内容，无需手勾。
        function blBool(v) {
          if (typeof v === "boolean") return v;
          const s = String(v == null ? "" : v).trim().toLowerCase();
          return s === "true" || s === "1" || s === "是" || s === "yes";
        }
        // 计算某字段的有效值：启用勾选 OR 文本非空 → 取文本；否则空串（=不覆盖）
        function blEff(val, on) {
          return (on === true || (val && String(val).trim())) ? String(val || "").trim() : "";
        }
        function blRowToPayload(r) {
          return {
            packageName: r.packageName,
            category: r.category,
            enabled: r.enabled !== false,
            referenceProductId: (r.referenceProductId && String(r.referenceProductId).trim()) || "",
            store: blEff(r.store, r.storeOn),
            brand: blEff(r.brand, r.brandOn),
            variantParams: blEff(r.variantParams, r.variantOn),
            stockType: blEff(r.stockType, r.stockTypeOn)
          };
        }
        
        function parseBatchCsv(text) {
          // 简易 CSV：逗号分隔（变种参数含逗号时建议用 xlsx）。# 开头行忽略。
          const lines = String(text || "").split(/\r?\n/).filter((l) => {
            const t = l.trim();
            return t !== "" && !t.startsWith("#");
          });
          if (!lines.length) return [];
          const header = lines[0].split(",").map((h) => h.trim());
          const idxName = Math.max(header.findIndex((h) => /packageName|产品包名|包名/i.test(h)), 0);
          const idxCat = header.findIndex((h) => /category|类目/i.test(h));
          const idxRefId = header.findIndex((h) => /引用商品ID|引用商品|引用ID|templateProductId|商品id/i.test(h));
          const idxEn = header.findIndex((h) => /enabled|上架|启用/i.test(h));
          const idxStoreOn = header.findIndex((h) => /^店铺_启用$|^店铺启用$/.test(h));
          const idxStore = header.findIndex((h) => /^店铺_名称$|^店铺名称$|^店铺$/.test(h));
          const idxBrandOn = header.findIndex((h) => /^品牌_启用$|^品牌启用$/.test(h));
          const idxBrand = header.findIndex((h) => /^品牌_名称$|^品牌名称$|^品牌$/.test(h));
          const idxVarOn = header.findIndex((h) => /^变种参数_启用$|^变种参数启用$/.test(h));
          const idxVar = header.findIndex((h) => /^变种参数$|^变种$/.test(h));
          const idxStockOn = header.findIndex((h) => /^备货类型_启用$|^备货类型启用$/.test(h));
          const idxStock = header.findIndex((h) => /^备货类型_名称$|^备货类型名称$|^备货类型$|^备货$/.test(h));
          const rows = [];
          for (let i = 1; i < lines.length; i++) {
            const cols = lines[i].split(",");
            const name = (cols[idxName] || "").trim();
            if (!name) continue;
            let category = idxCat >= 0 ? (cols[idxCat] || "").trim() : "";
            if (!category || category === "auto") category = "auto";
            let enabled = true;
            if (idxEn >= 0) {
              const ev = (cols[idxEn] || "").trim().toLowerCase();
              enabled = !(ev === "false" || ev === "0" || ev === "no" || ev === "否");
            }
            const txt = (idx) => (idx >= 0 ? (cols[idx] || "").trim() : "");
            const onf = (idx) => (idx >= 0 ? blBool(cols[idx]) : false);
            const store = txt(idxStore), brand = txt(idxBrand), variantParams = txt(idxVar), stockType = txt(idxStock);
            const referenceProductId = txt(idxRefId);
            rows.push({
              packageName: name, category, referenceProductId, enabled, status: "idle", progress: 0, reason: "",
              store, storeOn: onf(idxStoreOn) || !!store,
              brand, brandOn: onf(idxBrandOn) || !!brand,
              variantParams, variantOn: onf(idxVarOn) || !!variantParams,
              stockType, stockTypeOn: onf(idxStockOn) || !!stockType
            });
          }
          return rows;
        }
        
        function downloadXlsx(rows, filename) {
          try {
            const ws = XLSX.utils.aoa_to_sheet(rows);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "上架表");
            const buf = XLSX.write(wb, { bookType: "xlsx", type: "array" });
            const blob = new Blob([buf], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a); URL.revokeObjectURL(url);
          } catch (_e) { /* ignore */ }
        }
        
        function parseBatchXlsx(arrayBuffer) {
          const data = new Uint8Array(arrayBuffer);
          const wb = XLSX.read(data, { type: "array" });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" });
          if (!aoa || !aoa.length) return [];
          const header = (aoa[0] || []).map((h) => String(h || "").trim());
          const col = (re) => header.findIndex((h) => re.test(h));
          const idxName = Math.max(col(/packageName|产品包名|包名/i), 0);
          const idxCat = col(/^category$|类目/i);
          const idxRefId = col(/^引用商品ID$|^引用商品$|^引用ID$|^templateProductId$|^商品id$/i);
          const idxEn = col(/^enabled$|上架|启用/i);
          const idxStoreOn = col(/^店铺_启用$|^店铺启用$/);
          const idxStore = col(/^店铺_名称$|^店铺名称$|^店铺$/);
          const idxBrandOn = col(/^品牌_启用$|^品牌启用$/);
          const idxBrand = col(/^品牌_名称$|^品牌名称$|^品牌$/);
          const idxVarOn = col(/^变种参数_启用$|^变种参数启用$/);
          const idxVar = col(/^变种参数$|^变种$/);
          const idxStockOn = col(/^备货类型_启用$|^备货类型启用$/);
          const idxStock = col(/^备货类型_名称$|^备货类型名称$|^备货类型$|^备货$/);
          const rows = [];
          for (let i = 1; i < aoa.length; i++) {
            const cols = aoa[i] || [];
            const name = String(cols[idxName] || "").trim();
            if (!name) continue;
            let category = idxCat >= 0 ? String(cols[idxCat] || "").trim() : "";
            if (!category || category === "auto") category = "auto";
            let enabled = true;
            if (idxEn >= 0) {
              const ev = String(cols[idxEn] || "").trim().toLowerCase();
              enabled = !(ev === "false" || ev === "0" || ev === "no" || ev === "否");
            }
            const txt = (idx) => (idx >= 0 ? String(cols[idx] || "").trim() : "");
            const onf = (idx) => (idx >= 0 ? blBool(cols[idx]) : false);
            const store = txt(idxStore), brand = txt(idxBrand), variantParams = txt(idxVar), stockType = txt(idxStock);
            const referenceProductId = txt(idxRefId);
            rows.push({
              packageName: name, category, referenceProductId, enabled, status: "idle", progress: 0, reason: "",
              store, storeOn: onf(idxStoreOn) || !!store,
              brand, brandOn: onf(idxBrandOn) || !!brand,
              variantParams, variantOn: onf(idxVarOn) || !!variantParams,
              stockType, stockTypeOn: onf(idxStockOn) || !!stockType
            });
          }
          return rows;
        }
        
        function downloadCsv(text, filename) {
          try {
            const blob = new Blob([text], { type: "text/csv;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (_e) { /* ignore */ }
        }
        
        // 批量上架表格表头（基础列 + 可选自定义列）。可选列规则：填了"自定义名称"即覆盖默认，无需手勾。
        // 引用商品ID：逐行覆盖类目默认模板 ID；留空则用类目 profile.templateProductId。
        const BATCH_XLSX_HEADER = [
          "产品包名", "类目", "引用商品ID", "上架",
          "店铺_启用", "店铺_名称",
          "品牌_启用", "品牌_名称",
          "变种参数_启用", "变种参数",
          "备货类型_启用", "备货类型_名称"
        ];
        
        async function batchGenerateSource() {
          try {
            const data = await request("/api/dianxiaomi/product-packages");
            const pkgs = (data.packages || []).filter((p) => p.hasFacts);
            const rows = [BATCH_XLSX_HEADER.slice()];
            for (const p of pkgs) rows.push([p.name, p.category, "", true, "", "", "", "", "", "", "", ""]);
            downloadXlsx(rows, "批量上架数据源.xlsx");
          } catch (e) {
            alert("下载数据源表格失败：" + (e && e.message ? e.message : e));
          }
        }
        
        function batchDownloadTemplate() {
          downloadXlsx([
            BATCH_XLSX_HEADER.slice(),
            ["示例-乳贴(上传前请删除此行)", "", "", "true", "TRUE", "洛慈全托管", "FALSE", "", "TRUE", "颜色:肤色,黑色;尺寸:One Size", "FALSE", ""],
            ["示例-箱包(上传前请删除此行)", "xiangBao", "", "true", "TRUE", "洛慈全托管", "TRUE", "MyBrand", "TRUE", "古铜色=Bronze=bronze.jpg;Rose Gold=Rose Gold=rose.jpg;淡金色=Light Gold=lg.jpg;巧克力色=Chocolate=white.jpg;金=Gold=4pcs.jpg", "FALSE", ""],
            ["示例-箱包便携折叠包(上传前请删除此行)", "xiangBaoFold", "1005011985916829", "true", "TRUE", "洛慈全托管", "TRUE", "MyBrand", "TRUE", "古铜色=Bronze=bronze.jpg;Rose Gold=Rose Gold=rose.jpg;淡金色=Light Gold=lg.jpg;巧克力色=Chocolate=white.jpg;金=Gold=4pcs.jpg", "FALSE", ""]
          ], "批量上架模板.xlsx");
        }
        
        function batchOnFile(e) {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          const ext = (file.name.split(".").pop() || "").toLowerCase();
          const reader = new FileReader();
          reader.onload = () => {
            let rows = [];
            if (batchListingState.mode === "collect") {
              if (ext === "xlsx" || ext === "xls") {
                rows = parseCollectXlsx(reader.result);
              } else {
                rows = parseCollectCsv(String(reader.result || ""));
              }
            } else if (ext === "xlsx" || ext === "xls") {
              rows = parseBatchXlsx(reader.result);
            } else {
              rows = parseBatchCsv(String(reader.result || ""));
            }
            batchListingState.rows = rows;
            batchListingState.uploaded = rows.length > 0;
            batchListingState.busy = false;
            batchListingState.active = false;
            batchListingState.summary = null;
            renderBatchListing();
          };
          if (ext === "xlsx" || ext === "xls") reader.readAsArrayBuffer(file);
          else reader.readAsText(file);
        }
        
        // 批次操作幂等键（operationId）：用 rows 内容算指纹。
        // 同内容重发（网络超时重试 / 刷新页面后重发）→ 同一 op，后端识别为重放，不会把同一批商品上架两次；
        // 改了表格内容再点 → 指纹变化 → 视为新批次，正常执行。
        function batchOperationId(prefix, rows) {
          const key = (rows || []).map((r) => [
            r.packageName || "",
            r.category || "",
            r.searchTitle || "",
            r.referenceProductId || "",
            r.variantParams || "",
            r.store || "",
            r.productTemplate || "",
            r.enabled === false ? "0" : "1"
          ].join("~")).join("\u00a7");
          let hash = 5381;
          for (let i = 0; i < key.length; i += 1) hash = ((hash * 33) ^ key.charCodeAt(i)) >>> 0;
          return `${prefix}-${hash.toString(36)}-${(rows || []).length}`;
        }
        
        async function batchStart() {
          if (!batchListingState.uploaded || batchListingState.busy) return;
          const rows = batchListingState.rows;
          if (!rows.length) { alert("请先生成或上传数据源表格"); return; }
          try {
            await request("/api/dianxiaomi/batch-apply", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rows: rows.map((r) => blRowToPayload(r)), operationId: batchOperationId("ref-apply", rows) })
            });
            batchListingState.busy = true;
            batchListingState.active = true;
            batchListingState.summary = null;
          } catch (e) {
            alert("启动批量上架失败：" + (e && e.message ? e.message : e));
          }
        }
        
        async function batchRetry() {
          const failed = batchListingState.rows.filter((r) => r.status === "failed");
          if (!failed.length) return;
          try {
            await request("/api/dianxiaomi/batch-apply", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rows: failed.map((r) => blRowToPayload(Object.assign({}, r, { enabled: true }))), operationId: batchOperationId("ref-retry", failed) })
            });
            for (const r of failed) { r.status = "idle"; r.progress = 0; r.reason = ""; }
            batchListingState.busy = true;
            batchListingState.active = true;
          } catch (e) {
            alert("重试失败：" + (e && e.message ? e.message : e));
          }
        }
        
        async function pollBatchStatus() {
          try {
            const endpoint = (batchListingState.mode === "collect") ? "/api/dianxiaomi/collect-batch-status" : "/api/dianxiaomi/batch-status";
            const data = await request(endpoint);
            if (!data || !data.ok) return;
            const map = new Map((data.items || []).map((it) => [it.name, it]));
            for (const r of batchListingState.rows) {
              const it = map.get(r.packageName);
              if (it) { r.status = it.status; r.progress = it.progress; r.reason = it.reason || ""; }
            }
            if (data.summary) batchListingState.summary = data.summary;
            if (data.dianxiaomiStage) batchListingState.stage = data.dianxiaomiStage;
            updateBatchHeartbeat(data.running);
            if (!data.running) { batchListingState.active = false; batchListingState.busy = false; }
          } catch (_e) { /* ignore */ }
        }
        
        // P1-2：店小秘上品端到端心跳。根据后端 dianxiaomiStage（name+since）显示「正在 XX 已等待 Ns」，
        // 消除采集箱批量上架「卡死无反馈」的错觉。仅在 running 且阶段非 idle 时显示。
        function updateBatchHeartbeat(running) {
          const el = document.getElementById("blc-heartbeat");
          if (!el) return;
          const st = batchListingState.stage;
          if (!running || !st || !st.name || st.name === "idle") {
            el.textContent = "";
            el.classList.remove("active");
            return;
          }
          const waited = Math.max(0, Math.round((Date.now() - (st.since || Date.now())) / 1000));
          const detail = st.detail ? `（${st.detail}）` : "";
          el.textContent = `🔄 正在 ${st.name}${detail} · 已等待 ${waited}s`;
          el.classList.add("active");
        }
        
        // ───────────────────────── 采集箱批量上架（v 新路径，2026-07-28）─────────────────────────
        // 表格行形状：{ packageName, category, searchTitle, enabled, status, progress, reason, factsPath }
        function collectRowToPayload(r) {
          return {
            packageName: r.packageName,
            category: r.category,
            searchTitle: r.searchTitle || r.packageName,
            enabled: r.enabled !== false,
            factsPath: r.factsPath || "",
            variantThemeMap: r.variantThemeMap || "",
            // 产品模板：填模板名（如「箱包配件-包饰」）则编辑页第一步自动引用，带入海关/产品/物流/合规属性。
            productTemplate: r.productTemplate || "",
            // 变种覆盖：留空 = 沿用采集源变种；填 1/是/覆盖 才用 facts 重建颜色/尺寸/SKU。
            variantOverride: r.variantOverride || "",
            // 物流属性：填 普货/带电/液体 等；留空 = 走 profile/默认「普货」。
            logisticsAttribute: r.logisticsAttribute || "",
            // 材质：填 Felt/硅胶 等；留空 = 走 facts.material 或模板带入值。
            material: r.material || ""
          };
        }
        
        // 采集箱模式 CSV/XLSX 解析：列 搜索标题 / 类目 / 变种主题映射 / 产品包名（兼容 引用模式 的 packageName 列）。
        function collectRowFromCols(cols, header) {
          const col = (re) => header.findIndex((h) => re.test(h));
          const idxTitle = Math.max(col(/搜索标题|标题|searchTitle|title/i), 0);
          const idxName = col(/产品包名|包名|packageName|name/i);
          const idxCat = col(/^类目$|category|category$/i);
          const idxMap = col(/变种主题映射|variantThemeMap|theme\s*map/i);
          const idxTpl = col(/产品模板|productTemplate|template/i);
          const idxVo = col(/变种覆盖|variantOverride/i);
          const idxLog = col(/物流属性|logistics|logisticsAttribute/i);
          const idxMat = col(/材质|material/i);
          const name = (idxName >= 0 ? (cols[idxName] || "") : "").trim() || (cols[idxTitle] || "").trim();
          if (!name) return null;
          let category = idxCat >= 0 ? String(cols[idxCat] || "").trim() : "";
          if (!category || category === "auto") category = "auto";
          const variantThemeMap = idxMap >= 0 ? String(cols[idxMap] || "").trim() : "";
          const productTemplate = idxTpl >= 0 ? String(cols[idxTpl] || "").trim() : "";
          const variantOverride = idxVo >= 0 ? String(cols[idxVo] || "").trim() : "";
          const logisticsAttribute = idxLog >= 0 ? String(cols[idxLog] || "").trim() : "";
          const material = idxMat >= 0 ? String(cols[idxMat] || "").trim() : "";
          let enabled = true;
          const idxEn = col(/^enabled$|上架|启用/i);
          if (idxEn >= 0) { const ev = String(cols[idxEn] || "").trim().toLowerCase(); enabled = !(ev === "false" || ev === "0" || ev === "no" || ev === "否"); }
          return { packageName: name, category, searchTitle: (cols[idxTitle] || name).trim(), variantThemeMap, productTemplate, variantOverride, logisticsAttribute, material, enabled, status: "idle", progress: 0, reason: "", factsPath: "" };
        }
        
        // 采集箱模式文件解析：读取 CSV/XLSX 每行，映射到 collect 形状（搜索标题/类目/产品包名）。
        function parseCollectCsv(text) {
          const lines = String(text || "").split(/\r?\n/).filter((l) => {
            const t = l.trim();
            return t !== "" && !t.startsWith("#");
          });
          if (!lines.length) return [];
          const header = lines[0].split(",").map((h) => h.trim());
          const rows = [];
          for (let i = 1; i < lines.length; i++) {
            const cols = lines[i].split(",");
            const r = collectRowFromCols(cols, header);
            if (r) rows.push(r);
          }
          return rows;
        }
        
        function parseCollectXlsx(arrayBuffer) {
          const data = new Uint8Array(arrayBuffer);
          const wb = XLSX.read(data, { type: "array" });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" });
          if (!aoa || !aoa.length) return [];
          const header = (aoa[0] || []).map((h) => String(h || "").trim());
          const rows = [];
          for (let i = 1; i < aoa.length; i++) {
            const cols = (aoa[i] || []).map((c) => String(c == null ? "" : c));
            const r = collectRowFromCols(cols, header);
            if (r) rows.push(r);
          }
          return rows;
        }
        
        function collectDownloadTemplate() {
          const header = ["搜索标题", "类目", "变种主题映射", "产品模板", "变种覆盖", "物流属性", "材质", "产品包名", "enabled"];
          downloadXlsx([
            header,
            ["采集箱里该链接的真实标题", "xiangBaoFold", "颜色:Color;型号:Size", "箱包配件-包饰", "", "普货", "Felt", "已完成产品里的包名", "true"],
            ["示例-幸运草手机挂链", "xiangBao", "", "箱包配件-包饰", "", "普货", "Silicone", "幸运草手机挂链", "true"]
          ], "采集箱上架模板.xlsx");
        }
        
        async function collectGenerateSource() {
          try {
            const data = await request("/api/dianxiaomi/collect-batch-generate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({}) });
            if (!data || !data.ok) { alert("生成采集模板失败：" + (data && data.error ? data.error : "未知错误")); return; }
            // productTemplate / variantOverride 必须原样保留：后端按类目 profile 已自动带出默认模板
            // （如箱包配件→箱包配件-包饰），丢掉则编辑页不会执行「引用产品模板」第一步。
            const rows = (data.rows || []).map((r) => ({ packageName: r.packageName, category: r.category, searchTitle: r.searchTitle || "", variantThemeMap: r.variantThemeMap || "", productTemplate: r.productTemplate || "", variantOverride: r.variantOverride || "", logisticsAttribute: r.logisticsAttribute || "", material: r.material || "", enabled: r.enabled !== false, status: "idle", progress: 0, reason: "", factsPath: r.factsPath || "" }));
            if (!rows.length) { alert("没有含 product-facts.json 的已完成产品包，无法生成采集模板。"); return; }
            batchListingState.rows = rows;
            batchListingState.uploaded = true;
            batchListingState.busy = false;
            batchListingState.active = false;
            batchListingState.summary = null;
            renderBatchListing();
          } catch (e) {
            alert("生成采集模板失败：" + (e && e.message ? e.message : e));
          }
        }
        
        async function collectStart() {
          if (!batchListingState.uploaded || batchListingState.busy) return;
          const rows = batchListingState.rows;
          if (!rows.length) { alert("请先生成或上传采集模板"); return; }
          try {
            await request("/api/dianxiaomi/collect-batch-apply", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rows: rows.map((r) => collectRowToPayload(r)), operationId: batchOperationId("col-apply", rows) })
            });
            batchListingState.busy = true;
            batchListingState.active = true;
            batchListingState.summary = null;
          } catch (e) {
            alert("启动采集箱批量上架失败：" + (e && e.message ? e.message : e));
          }
        }
        
        async function collectRetry() {
          const failed = batchListingState.rows.filter((r) => r.status === "failed" || r.status === "skipped");
          if (!failed.length) return;
          if (!window.confirm(`将对 ${failed.length} 个失败/跳过项重新上架（已成功项保留）。继续？`)) return;
          try {
            await request("/api/dianxiaomi/collect-batch-retry", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rows: failed.map((r) => collectRowToPayload(r)), operationId: batchOperationId("col-retry", failed) })
            });
            for (const r of failed) { r.status = "running"; r.progress = 0; r.reason = ""; }
            batchListingState.busy = true;
            batchListingState.active = true;
            batchListingState.summary = null;
          } catch (e) {
            alert("重试失败：" + (e && e.message ? e.message : e));
          }
        }
        
        async function collectExplore() {
          try {
            const data = await request("/api/dianxiaomi/collect-explore", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({}) });
            if (!data || !data.ok) { alert("探索采集箱失败：" + (data && data.error ? data.error : "未知错误")); return; }
            batchListingState.explore = JSON.stringify(data.dump || {}, null, 2);
            renderBatchListing();
          } catch (e) {
            alert("探索采集箱失败：" + (e && e.message ? e.message : e));
          }
        }
        
        function catOpts(cur) {
            const profiles = (dianxiaomiState.profiles && dianxiaomiState.profiles.length)
                ? dianxiaomiState.profiles
                : [
                    { key: "ruTie", label: "乳贴" },
                    { key: "xiangBao", label: "箱包配件" },
                    { key: "xiangBaoFold", label: "箱包配件(折叠)" }
                  ];
            let opts = profiles.map((p) => `<option value="${p.key}" ${cur === p.key ? "selected" : ""}>${blEscapeHtml(p.label || p.key)}</option>`).join("");
            if (cur && !profiles.find((p) => p.key === cur)) {
                opts += `<option value="${blEscapeHtml(cur)}" selected>${blEscapeHtml(cur)}</option>`;
            }
            return opts;
        }
        
        function blImportInfoHtml(info) {
            if (info.running) return `⏳ ${blEscapeHtml(info.msg || "制作作业运行中")}`;
            if (info.error) return `<span class="bl-import-err">⚠ ${blEscapeHtml(info.error)}</span>`;
            if (info.autoStarting) return `✅ 带入 ${info.added || 0} 行 · 正在自动开始上架…`;
            return `✅ 带入 ${info.added || 0} 行（合并 ${info.merged || 0}）· 跳过已上架 ${info.dedupCount || 0} · 跳过失败 ${info.skipped || 0}` + (info.mode ? `（${info.mode === "reference" ? "引用" : "采集箱"}模式）` : "");
        }
        
        async function blImportFromCreateJob(silent, chainStart, _depth = 0) {
            if (batchListingState.importing) return;
            batchListingState.importing = true;
            renderBatchListing();
            try {
                const cb = document.getElementById("bl-include-uploaded");
                const includeUploaded = cb ? cb.checked : false;
                const data = await request("/api/workflow/listing-to-upload", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ excludeUploaded: !includeUploaded })
                });
                if (!data || data.running) {
                    if (silent && chainStart && _depth < 3) {
                        setTimeout(() => void blImportFromCreateJob(true, true, _depth + 1), 1500);
                        return;
                    }
                    batchListingState.importInfo = { running: true, msg: "制作作业仍在运行中，请稍后再试" };
                    return;
                }
                if (!data.ok) {
                    batchListingState.importInfo = { error: data.error || "桥接失败" };
                    return;
                }
                // 一站式模式：按制作作业里两种模式行数选主导模式，自动切到对应 tab
                if (chainStart) {
                    const refN = (data.referenceRows || []).length;
                    const colN = (data.collectRows || []).length;
                    const targetMode = colN >= refN ? "collect" : "reference";
                    if (batchListingState.mode !== targetMode) {
                        batchListingState.mode = targetMode;
                        renderBatchListing();
                    }
                }
                const mode = batchListingState.mode;
                const src = mode === "reference" ? (data.referenceRows || []) : (data.collectRows || []);
                const map = {};
                batchListingState.rows.forEach((r) => { map[r.packageName] = r; });
                let added = 0, merged = 0;
                src.forEach((r) => {
                    if (map[r.packageName]) { Object.assign(map[r.packageName], r); merged++; }
                    else { batchListingState.rows.push(r); added++; }
                });
                batchListingState.uploaded = true;
                batchListingState.importInfo = {
                    added, merged,
                    dedupCount: data.dedupCount || 0,
                    skipped: (data.skipped || []).length,
                    mode
                };
                // 一站式：带入完成后自动开始上架（仅主导模式；混合模式需手动补另一 tab）
                if (chainStart && batchListingState.rows.length) {
                    batchListingState.importInfo.autoStarting = true;
                    setTimeout(() => {
                        if (batchListingState.mode === "collect") collectStart();
                        else batchStart();
                    }, 500);
                }
            } catch (e) {
                batchListingState.importInfo = { error: String((e && e.message) || e) };
                batchListingCreateState.autoUploadFailed = true;
            } finally {
                batchListingState.importing = false;
                batchListingCreateState.autoUploading = false;
                renderBatchListing();
            }
        }
        
        function renderBatchListing() {
          const root = document.getElementById("batch-listing-root");
          if (!root) return;
          if (activeViewName() !== "batch-listing") return;
          if (batchListingState.active) void pollBatchStatus();
          const mode = batchListingState.mode || "reference";
          const sig = JSON.stringify([mode, batchListingState.importing, batchListingState.importInfo, batchListingState.rows.map((r) => [r.packageName, r.category, r.searchTitle, r.enabled, r.status, r.progress, r.reason, r.store, r.storeOn, r.brand, r.brandOn, r.variantParams, r.variantOn, r.stockType, r.stockTypeOn, r.productTemplate, r.variantOverride, r.logisticsAttribute, r.material])]);
          if (sig === batchListingSig && root.dataset.rendered === "1") return;
          batchListingSig = sig;
          root.dataset.rendered = "1";
          const rows = batchListingState.rows;
          const busy = batchListingState.busy;
          const dis = busy ? "disabled" : "";
          const hasFailed = rows.some((r) => r.status === "failed" || r.status === "skipped");
          const enabledCount = rows.filter((r) => r.enabled !== false).length;
          // 采集箱模式「类目」为自由文本输入：用户手填对应店小秘精准类目（profile key 或精确类目串），
          // 运行时以该值为基准选类目（见 server.js runCollectBatchListing）。
          // 可选自定义列单元格：checkbox("自定义") + 文本输入(自定义名称)。填值即视为启用。
          const fieldCell = (r, textCls, onCls, textKey, onKey, ph) => `
            <td>
              <div class="bl-field">
                <label class="bl-field-on"><input type="checkbox" class="${onCls}" data-name="${blEscapeHtml(r.packageName)}" ${(r[onKey] || r[textKey]) ? "checked" : ""} ${dis}/> 自定义</label>
                <input type="text" class="${textCls}" data-name="${blEscapeHtml(r.packageName)}" value="${blEscapeHtml(r[textKey] || "")}" placeholder="${ph}" ${dis}/>
              </div>
            </td>`;
          root.innerHTML = `
            <div class="bl-board">
              <div class="bl-mode-toggle">
                <button class="bl-mode ${mode === "reference" ? "active" : ""}" data-mode="reference">① 引用上架（引用模板→填→存草稿）</button>
                <button class="bl-mode ${mode === "collect" ? "active" : ""}" data-mode="collect">② 采集箱上架（搜标题→点编辑→填 facts→存草稿不发布）</button>
              </div>
        
              ${mode === "reference" ? `
              <div class="bl-overview">
                <div class="bl-overview-icon">📦</div>
                  <div class="bl-overview-text">
                    <b>批量流水线上架（引用模式）</b>：下载 .xlsx 数据源表格 → 在 Excel 只保留要上架的行 → 填可选自定义项 → 上传 → 开始自动上架为草稿
