+
+/** Synthetic, host-owned offline copies only. The host must prevent concurrent writes.
+ * No immutable URI, workspace initializer, migration or writable connection is used.
+ */
+export async function readCeoTaskSnapshot({dbPath,storeId='400370',now=new Date(),fixtureRoot,offlineSnapshot}={}){
+ if(storeId!=='400370')fail('STORE_MISMATCH');
+ if(!(now instanceof Date)||!Number.isFinite(now.getTime()))fail('INVALID_TIME');
