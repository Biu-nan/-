+++ b/dist/src/ceo-g2a-service.js
@@ -0,0 +1,43 @@
+import http from 'node:http';
+import express from 'express';
+import {requireG1FixtureRoot} from './ceo-main-boundary.js';
+import {buildCeoVnextContext} from './ceo-vnext-context.js';
+import {buildCeoShadowReport} from './ceo-vnext-analysis.js';
+import {contentHash,exact,fail} from './ceo-vnext-common.js';
+/** Fixture-only composition. No executor/DB default, real credential discovery, or main-server wiring. */
+export async function startCeoG2aService({fixtureRoot,governance,loadContextInput,readTaskSnapshot,readWorkflowSnapshot,trace,now=()=>new Date(),port=0}={}){
+ if(port!==0)fail('ISOLATED_PORT_REQUIRED');
+ requireG1FixtureRoot({fixtureRoot,dataRoot:fixtureRoot});
+ if(!governance||![loadContextInput,readTaskSnapshot,readWorkflowSnapshot,trace?.append,trace?.read].every(f=>typeof f==='function'))fail('G2A_DEPENDENCY_REQUIRED');
+ const app=express();app.disable('x-powered-by');app.use(express.json({limit:262144}));
+ app.use((req,res,next)=>{res.setHeader('Cache-Control','no-store');next();});
+ const routes={'GET /api/ceo/vnext/context':'read','GET /api/ceo/vnext/tasks':'read','GET /api/ceo/vnext/workflows':'read','POST /api/ceo/vnext/shadow-analysis':'analyze','GET /api/ceo-shadow/events':'read','POST /api/ceo-shadow/events':'human.review'};
+ app.use((req,res,next)=>{
+  try{
+   const op=routes[req.method+' '+req.originalUrl];if(!op)fail('FORBIDDEN');
+   const token=/^Bearer ([^\s]+)$/.exec(req.headers.authorization??'')?.[1];req.principal=governance.authenticateToken(token);governance.authorize({principal:req.principal,operation:op,storeId:'400370'});next();
+  }catch(e){res.status(e.code==='UNAUTHORIZED'?401:403).json({error:e.code??'FORBIDDEN'});}
+ });
+ const context=async()=>buildCeoVnextContext({...await loadContextInput(),storeId:'400370',now:now()});
+ const wrap=fn=>async(req,res)=>{try{await fn(req,res);}catch(e){const code=e.code??'DEPENDENCY_UNAVAILABLE';res.status(code==='FORBIDDEN'?403:code==='UNAUTHORIZED'?401:['CONTEXT_CHANGED','TASK_VERSION_CONFLICT','OPERATION_CONFLICT'].includes(code)?409:/INVALID|REQUIRED|UNTRUSTED/.test(code)?400:503).json({error:code});}};
+ app.get('/api/ceo/vnext/context',wrap(async(_req,res)=>res.json(await context())));
+ app.get('/api/ceo/vnext/tasks',wrap(async(_req,res)=>res.json(await readTaskSnapshot())));
+ app.get('/api/ceo/vnext/workflows',wrap(async(_req,res)=>res.json(await readWorkflowSnapshot())));
+ app.get('/api/ceo-shadow/events',wrap(async(req,res)=>res.json(await trace.read({principal:req.principal,storeId:'400370'}))));
+ app.post('/api/ceo/vnext/shadow-analysis',wrap(async(req,res)=>{
+  if(!exact(req.body,['requestId','expectedContextId','draft'])||typeof req.body.requestId!=='string'||!/^[A-Za-z0-9._:-]{1,100}$/.test(req.body.requestId))fail('INVALID_ANALYSIS_REQUEST');
+  const c=await context();if(c.contextId!==req.body.expectedContextId)fail('CONTEXT_CHANGED');
+  const taskSnapshot=await readTaskSnapshot(),workflowState=await readWorkflowSnapshot();
+  const report=buildCeoShadowReport({context:c,taskSnapshot,workflowState,draft:req.body.draft,now:now()});
+  const event={type:'ANALYSIS',storeId:'400370',eventId:'event-'+req.body.requestId,analysisId:report.analysisId,contextId:c.contextId,snapshotId:taskSnapshot.snapshotId,sourceHash:contentHash(report.sourceRefs),policyVersion:governance.policyVersion,proposalRef:report.planCandidates[0]?.proposalRef??null,decisionSummary:JSON.stringify({claims:report.claims.map(c=>({id:c.claimId,status:c.status})),priorities:report.priorities.map(p=>p.title),stopReasons:report.stopReasons}).slice(0,1900)};
+  const committed=await trace.append({principal:req.principal,event});res.json({report,traceEventId:committed.event.eventId,archived:true});
+ }));
+ app.post('/api/ceo-shadow/events',wrap(async(req,res)=>{
+  if(!['HUMAN_FEEDBACK','HUMAN_CORRECTION','HUMAN_PAUSE','HUMAN_RESUME'].includes(req.body?.type))fail('FORBIDDEN');
+  res.json(await trace.append({principal:req.principal,event:req.body}));
+ }));
+ app.use((_error,_req,res,_next)=>res.status(400).json({error:'INVALID_INPUT'}));
+ const server=http.createServer(app);server.requestTimeout=10000;server.headersTimeout=10000;
+ await new Promise((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});
+ return Object.freeze({baseUrl:'http://127.0.0.1:'+server.address().port,stop:()=>new Promise(resolve=>{server.close(resolve);server.closeAllConnections();})});
+}
diff --git a/dist/src/ceo-shadow-trace.js b/dist/src/ceo-shadow-trace.js
