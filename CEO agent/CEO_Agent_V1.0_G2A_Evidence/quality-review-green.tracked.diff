+        "metric": "catalog.brokenSize",
+        "maxDelayMinutes": 60
+      },
+      {
+        "metric": "catalog.outOfStock",
+        "maxDelayMinutes": 60
+      },
+      {
+        "metric": "inventory.sellable",
+        "maxDelayMinutes": 1440
+      },
+      {
+        "metric": "sales.qty.total",
+        "maxDelayMinutes": 1440
+      }
+    ],
+    "stalePolicy": "超过 maxDelayMinutes 未更新时，指标值必须为 null 且 reason=STALE，禁止沿用上一周期数值。"
+  },
+  "metrics": {
+    "sellThroughRate": {
+      "label": "动销率",
+      "formula": "lifecycle.activeSkus / denominator",
+      "denominatorOptions": [
+        "catalog.platformItems",
+        "catalog.online",
+        "catalog.total"
+      ],
+      "denominatorNote": "三个分母都合法但结论不同，报告必须显式标注用了哪个。默认用 catalog.platformItems（与平台动销商品数同源）。",
+      "unit": "%",
+      "threshold": {
