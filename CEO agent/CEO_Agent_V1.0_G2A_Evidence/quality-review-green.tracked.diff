+      "note": "供给端积压，配合 publishFail 一起看。"
+    }
+  },
+  "forbidden": [
+    "把 sales.qty.direct 当作全店销量",
+    "把 sales.amount.net 当作利润",
+    "跨 caliber 求和或做比值（除 schema 显式声明 comparableWith 的组合）",
+    "把抓不到的值用上一周期数值填充",
+    "把 PDT 日期直接当北京日期入库而不记录时区"
+  ]
+}
