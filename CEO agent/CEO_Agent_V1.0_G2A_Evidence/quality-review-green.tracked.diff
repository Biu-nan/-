+const catalog=JSON.parse(readFileSync(new URL('../../config/ceo-workflow-capabilities.v1.json',import.meta.url),'utf8'));
+const issued=new WeakSet();
+export function readCeoWorkflowState({storeId,snapshot,now=new Date()}={}){
+ if(storeId!=='400370'||!(now instanceof Date)||!Number.isFinite(+now))fail('INVALID_WORKFLOW_INPUT');
+ const base=[];if(!snapshot||snapshot.storeId!==storeId||!Number.isSafeInteger(snapshot.version)||snapshot.version<1||!Array.isArray(snapshot.states))base.push('STATE_UNAVAILABLE');
