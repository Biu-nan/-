+test('schema rejects unknown keys, task/run mutations and secrets without filesystem mutation',async t=>{
+ const f=fixture(t),before=readdirSync(f.fixtureRoot);
+ for(const bad of [event({type:'TASK_COMMAND'}),event({taskId:'task-1'}),event({run:{status:'STOPPED'}}),event({sourceHash:'bad'}),event({eventId:'a\nsecret'}),event({proposalRef:'https://secret.example'}),event({note:'x'}),humanEvent('HUMAN_FEEDBACK',{note:'Authorization: Bearer abcdefghijklmnopqrstuvwxyz'}),humanEvent('HUMAN_FEEDBACK',{note:'api_key=secret'}),humanEvent('HUMAN_FEEDBACK',{note:'x'.repeat(2001)}),humanEvent('HUMAN_CORRECTION')]) {
