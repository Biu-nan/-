+test('Human correction appends links while original bytes remain; invalid links fail',async t=>{
+ const f=fixture(t);await f.trace.append({principal:f.shadow,event:event()});
+ await f.trace.append({principal:f.human,event:humanEvent('HUMAN_FEEDBACK')});const before=readFileSync(f.filePath);
+ const correction=await f.trace.append({principal:f.human,event:humanEvent('HUMAN_CORRECTION',{correctsEventId:'HUMAN_FEEDBACK-1'})});
+ assert.equal(correction.event.correctsEventId,'HUMAN_FEEDBACK-1');assert.deepEqual(readFileSync(f.filePath).subarray(0,before.length),before);
+ assert.equal((await f.trace.read({principal:f.human,storeId:'400370'})).length,3);
