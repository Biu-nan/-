+test('analysis decisionSummary persists immutably and rejects unsafe or unbounded text',async t=>{
+ const f=fixture(t),summary='status=NEEDS_REVIEW; priorities=inventory,listing; gaps=snapshot age';
+ const record=await f.trace.append({principal:f.shadow,event:event({decisionSummary:summary})});
+ assert.equal(record.event.decisionSummary,summary);assert.ok(Object.isFrozen(record.event));
+ assert.equal((await f.open().read({principal:f.human,storeId:'400370'}))[0].event.decisionSummary,summary);
+ const before=readFileSync(f.filePath);
+ for(const decisionSummary of ['x'.repeat(2001),'Authorization: Bearer synthetic-secret','api_key=synthetic-secret','bad\u0000text',{},'']) {
+  await assert.rejects(f.trace.append({principal:f.shadow,event:event({eventId:'bad-summary',analysisId:'bad-summary',decisionSummary})}),{code:'INVALID_TRACE_EVENT'});
+ }
+ await assert.rejects(f.trace.append({principal:f.human,event:humanEvent('HUMAN_FEEDBACK',{decisionSummary:summary})}),{code:'INVALID_TRACE_EVENT'});
