+test('unmarked fixtures and lexical/symlink path escapes never create outside output',async t=>{
+ const f=fixture(t),outside=mkdtempSync(join(tmpdir(),'ceo-trace-outside-'));t.after(()=>rmSync(outside,{recursive:true,force:true}));
