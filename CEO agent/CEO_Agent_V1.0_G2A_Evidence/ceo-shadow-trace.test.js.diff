+test('separate processes serialize concurrent appends and restart dedup',async t=>{
+ const f=fixture(t),moduleUrl=pathToFileURL(resolve('dist/src/ceo-shadow-trace.js')).href,governanceUrl=pathToFileURL(resolve('dist/src/ceo-governance.js')).href;
+ const child = index => new Promise((resolveChild,reject)=>{
+  const code=`import {createCeoShadowTrace} from ${JSON.stringify(moduleUrl)};import {createCeoGovernance} from ${JSON.stringify(governanceUrl)};const g=createCeoGovernance({credentials:${JSON.stringify(credentials)}});const s=createCeoShadowTrace({filePath:${JSON.stringify(f.filePath)},fixtureRoot:${JSON.stringify(f.fixtureRoot)},governance:g});await s.append({principal:g.authenticateToken('s'.repeat(48)),event:${JSON.stringify(event({eventId:`process-${index}`,analysisId:`process-${index}`}))}});`;
