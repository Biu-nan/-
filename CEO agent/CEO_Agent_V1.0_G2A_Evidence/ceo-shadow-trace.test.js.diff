+ await assert.rejects(f.trace.append({principal:f.shadow,event:event({storeId:'400371'})}),{code:'FORBIDDEN'});
+ await assert.rejects(f.trace.read({principal:forged,storeId:'400370'}),{code:'UNAUTHORIZED'});
+ await assert.rejects(f.trace.read({principal:f.shadow,storeId:'400371'}),{code:'FORBIDDEN'});
+ assert.deepEqual(readdirSync(f.fixtureRoot),before);
