+import http from 'node:http';
+import express from 'express';
+import {requireG1FixtureRoot} from './ceo-main-boundary.js';
+import {prepareCeoPaymentDomain} from './ceo-payment-domain.js';
+import {buildCeoShadowReport} from './ceo-vnext-analysis.js';
+import {contentHash,fail,exact,safeText} from './ceo-vnext-common.js';
+export const CEO_PAYMENT_QUESTION='分析纳物一店最近的经营情况，告诉我应该优先处理什么。';
+const requestOK=x=>typeof x==='string'&&/^[A-Za-z0-9._:-]{1,90}$/.test(x);
+export function createCeoPaymentLoop({fixtureRoot,governance,archive,trace,resolveVersions,loadPaymentInput,readTaskSnapshot,readWorkflowSnapshot,now=()=>new Date()}={}){
+ requireG1FixtureRoot({fixtureRoot,dataRoot:fixtureRoot});
+ if(!governance||![archive?.prepare,archive?.recover,archive?.confirmTrace,archive?.read,trace?.append,trace?.read,resolveVersions,loadPaymentInput,readTaskSnapshot,readWorkflowSnapshot,now].every(f=>typeof f==='function'))fail('READINESS_DEPENDENCY_REQUIRED');
+ const pending=new Map(),correctionPending=new Map();
+ function authorize(principal,operation){return governance.authorize({principal,operation,storeId:'400370'});}
+ function result(saved,replayed=false){if(saved.status!=='COMPLETE')fail('REPORT_NOT_COMPLETE');return{schema:'ceo-payment-readiness-result/v1',status:'COMPLETE',verificationScope:'SYNTHETIC',question:CEO_PAYMENT_QUESTION,reportId:saved.reportId,context:saved.context,report:saved.report,versions:saved.versions,traceRecordHash:saved.traceRecordHash,traceEventId:saved.traceReceipt.traceEventId,domainGaps:saved.report.dataGaps.filter(g=>g.gapId).map(g=>g.gapId),replayed,formalTaskWrites:0,workflowExecutions:0};}
+ async function complete(principal,saved){
+  if(saved.status==='COMPLETE')return saved;
+  const event={type:'ANALYSIS',storeId:'400370',eventId:'archive-'+saved.reportId.slice(7),analysisId:saved.report.analysisId,contextId:saved.context.contextId,snapshotId:saved.taskSnapshot.snapshotId,sourceHash:contentHash(saved.context.sourceRefs),policyVersion:governance.policyVersion,proposalRef:saved.report.planCandidates[0]?.proposalRef??null,reportId:saved.reportId,decisionSummary:JSON.stringify({reportId:saved.reportId,priorities:saved.report.priorities.map(p=>p.title.slice(0,30)),scope:'SYNTHETIC'})};
+  const record=await trace.append({principal,event});return archive.confirmTrace({principal,reportId:saved.reportId,traceRecord:record});
+ }
+ async function recover(principal,requestId){try{return await archive.recover({principal,requestId,storeId:'400370'});}catch(e){if(e.code==='ARCHIVE_NOT_FOUND')return null;throw e;}}
+ async function assemble(requestId,correctsReportId=null){
+  const input=await loadPaymentInput({correctsReportId}),domain=prepareCeoPaymentDomain({...input,now:now()});
+  const c=domain.context,verified=c.facts.filter(f=>f.quality==='VERIFIED');
+  const priorities=[];
+  if(verified.length!==3)priorities.push({title:'先补齐支付数据证据',kind:'INVESTIGATE',factIds:[],rationale:'支付来源、覆盖或核准存在缺口，不能把未知记为零。',acceptance:'取得完整闭期去标识订单支付快照，并由核准人确认店铺、期间、时区、状态和币种。'});
+  priorities.push({title:'核对支付后履约与退款',kind:'INVESTIGATE',factIds:verified.map(f=>f.factId),rationale:verified.length?'已有同期间原始支付事实，尚缺履约和退款结果，不能等同净收入。':'目前尚不能确认支付规模，应先核对状态和退款定义。',acceptance:'补充同店同期间的履约及退款对账，列出异常订单数量和原因；不触发任何订单操作。'});
+  priorities.push({title:'补齐同口径对比期再判断趋势',kind:'INVESTIGATE',factIds:verified.map(f=>f.factId),rationale:'只有一个期间，不能把规模变化归因于流量、价格或转化。',acceptance:'提供相邻等长闭期且口径、时区、币种一致的核准快照，输出可复核差异。'});
+  const draft={claims:[...c.facts.map((f,i)=>({claimId:'payment-fact-'+i,kind:'FACT',text:'host generated payment assertion',factIds:[f.factId],metric:'sales'})),{claimId:'diagnosis-scope',kind:'HYPOTHESIS',text:'支付后履约、退款或转化可能影响表现；当前证据不能确认具体原因。',factIds:[],metric:'general'}],priorities:priorities.slice(0,3),planCandidates:[]};
+  const taskSnapshot=await readTaskSnapshot(),workflowState=await readWorkflowSnapshot();
+  const report=buildCeoShadowReport({context:c,taskSnapshot,workflowState,draft,requestRef:requestId,now:now()});
+  return{context:c,report,evidence:domain.input.evidence,versions:resolveVersions(),taskSnapshot,workflowState,correctsReportId};
+ }
+ async function analyze(args={}){
+  if(!exact(args,['principal','requestId','question'])||!requestOK(args.requestId)||args.question!==CEO_PAYMENT_QUESTION)fail('INVALID_READINESS_REQUEST');authorize(args.principal,'analyze');
+  if(pending.has(args.requestId))return pending.get(args.requestId);
+  if(pending.size>=100)fail('READINESS_BUSY');
+  const promise=(async()=>{const old=await recover(args.principal,args.requestId);if(old)return result(await complete(args.principal,old),true);const bundle=await assemble(args.requestId);let saved;try{saved=await archive.prepare({principal:args.principal,requestId:args.requestId,...bundle});}catch(e){if(e.code!=='ARCHIVE_CONFLICT')throw e;saved=await recover(args.principal,args.requestId);if(!saved)throw e;}return result(await complete(args.principal,saved));})();pending.set(args.requestId,promise);try{return await promise;}finally{pending.delete(args.requestId);}
+ }
+ async function correctOnce(args={}){
+  if(!exact(args,['humanPrincipal','analysisPrincipal','requestId','correctsReportId','note','question'])||!requestOK(args.requestId)||!safeText(args.note)||args.note.length>1000||args.question!==CEO_PAYMENT_QUESTION)fail('INVALID_CORRECTION_REQUEST');
+  authorize(args.humanPrincipal,'human.review');authorize(args.analysisPrincipal,'analyze');
+  const recovered=await recover(args.humanPrincipal,args.requestId);if(recovered){const feedback=(await trace.read({principal:args.humanPrincipal,storeId:'400370'})).find(r=>r.event.feedbackId==='feedback-'+args.requestId);if(recovered.correctsReportId!==args.correctsReportId||!feedback||feedback.event.note!==args.note||feedback.actorId!==authorize(args.humanPrincipal,'human.review').actorId)fail('CORRECTION_CONFLICT');return result(await complete(args.analysisPrincipal,recovered),true);}
+  const old=await archive.read({principal:args.humanPrincipal,reportId:args.correctsReportId});const bundle=await assemble(args.requestId,args.correctsReportId);if(bundle.context.contextId===old.contextId)fail('CORRECTION_SOURCE_REVISION_REQUIRED');
+  const records=await trace.read({principal:args.humanPrincipal,storeId:'400370'}),previous=records.find(r=>r.recordHash===old.traceRecordHash);if(!previous)fail('ARCHIVE_TRACE_MISMATCH');
+  const {decisionSummary:oldSummary,...previousEvent}=previous.event;
+  await trace.append({principal:args.humanPrincipal,event:{...previousEvent,type:'HUMAN_CORRECTION',eventId:'human-'+args.requestId,feedbackId:'feedback-'+args.requestId,note:args.note,correctsEventId:previous.event.eventId}});
+  const prepared=await archive.prepare({principal:args.humanPrincipal,requestId:args.requestId,...bundle});return result(await complete(args.analysisPrincipal,prepared));
+ }
+ async function correct(args={}){
+  if(!exact(args,['humanPrincipal','analysisPrincipal','requestId','correctsReportId','note','question'])||!requestOK(args.requestId)||!safeText(args.note)||args.note.length>1000||args.question!==CEO_PAYMENT_QUESTION)fail('INVALID_CORRECTION_REQUEST');
+  const actor=authorize(args.humanPrincipal,'human.review');authorize(args.analysisPrincipal,'analyze');
+  const signature=contentHash({actor:actor.actorId,parent:args.correctsReportId,note:args.note,question:args.question});const old=correctionPending.get(args.requestId);if(old){if(old.signature!==signature)fail('CORRECTION_CONFLICT');return old.promise;}if(correctionPending.size>=100)fail('READINESS_BUSY');
+  const promise=correctOnce(args);correctionPending.set(args.requestId,{signature,promise});try{return await promise;}finally{correctionPending.delete(args.requestId);}
+ }
+ return Object.freeze({analyze,correct});
+}
+
+/** No WorkBuddy login/session or production credentials are imported; this is an explicit host API. */
+export async function startCeoPaymentReadinessService({fixtureRoot,governance,loop,archive,analysisPrincipal,port=0}={}){
+ if(port!==0)fail('ISOLATED_PORT_REQUIRED');requireG1FixtureRoot({fixtureRoot,dataRoot:fixtureRoot});governance.authorize({principal:analysisPrincipal,operation:'analyze',storeId:'400370'});
+ const app=express();app.disable('x-powered-by');app.use(express.json({limit:16384}));app.use((_req,res,next)=>{res.setHeader('Cache-Control','no-store');next();});
+ app.use((req,res,next)=>{try{req.principal=governance.authenticateToken(/^Bearer ([^\s]+)$/.exec(req.headers.authorization??'')?.[1]);next();}catch{res.status(401).json({error:'UNAUTHORIZED'});}});
+ const wrap=fn=>async(req,res)=>{try{res.json(await fn(req));}catch(e){const code=typeof e.code==='string'?e.code:'READINESS_UNAVAILABLE';res.status(code==='FORBIDDEN'?403:/^INVALID|REQUIRED/.test(code)?400:/CONFLICT|MISMATCH/.test(code)?409:503).json({error:code});}};
+ app.post('/api/ceo/payment-readiness',wrap(req=>{if(!exact(req.body,['requestId','question']))fail('INVALID_READINESS_REQUEST');return loop.analyze({principal:req.principal,...req.body});}));
+ app.post('/api/ceo/payment-corrections',wrap(req=>{if(!exact(req.body,['requestId','correctsReportId','note','question']))fail('INVALID_CORRECTION_REQUEST');return loop.correct({humanPrincipal:req.principal,analysisPrincipal,...req.body});}));
+ app.get('/api/ceo/payment-reports/:reportId',wrap(req=>archive.read({principal:req.principal,reportId:req.params.reportId})));
+ app.use((_req,res)=>res.status(403).json({error:'FORBIDDEN'}));app.use((_err,_req,res,_next)=>res.status(400).json({error:'INVALID_INPUT'}));
+ const server=http.createServer(app);server.requestTimeout=10000;server.headersTimeout=10000;await new Promise((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});return Object.freeze({baseUrl:'http://127.0.0.1:'+server.address().port,stop:()=>new Promise(resolve=>{server.close(resolve);server.closeAllConnections();})});
+}
