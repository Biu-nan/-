!/scripts/fetch-ae-daily.mjs
# D4 商品级补货计划（只读计算）
!/scripts/plan-restock.mjs
# D4 全量商品级抓取（稳卖 CDP 旁听 sales.query，交付资产）
!/scripts/fetch-ae-items.mjs
# 运营分析库构建器 + 日巡检器（只读，交付资产；库文件 data/metrics/ops.db 仍忽略）
!/scripts/build-ops-db.mjs
!/scripts/ops-daily-check.mjs
# 运营日更编排器（串联 抓取→建库→巡检→摘要；离线/超时护栏，交付资产）
!/scripts/daily-ops-pipeline.mjs
# 日更计划任务：入口壳 + 安装器（绕开非 ASCII .bat 坑，交付资产）
!/scripts/run-daily-ops.mjs
!/scripts/install-daily-task.mjs
# C2b-B 平台导出导入器（按日 CSV → fact_store_daily，交付资产）
!/scripts/import-platform-export.mjs
# A2d 方案 C 生产门验证器（含进程内 self-test，交付资产）
!/scripts/verify-production-gate.mjs
# 核心闭环一键验收器（7 环节聚合 PASS/FAIL，交付资产）
!/scripts/verify-core-loop.mjs

# 突变测试临时工作区（评测器每次运行生成，非交付资产；防止 git add . 误带）
/.eval-mutants-*/
