# scripts/ 整体仍忽略（探档脚本居多），但阶段 1 的三个验收脚本必须入库。
# 注意：必须写成 scripts/* 而不是 scripts/ —— 目录被整体忽略时 Git 不遍历，
# 后续 ! 例外规则无法生效（已实测确认）。
scripts/*
!/scripts/verify-phase1-identity-state.mjs
!/scripts/audit-product-identity.mjs
!/scripts/build-provisional-identity.mjs
# A2 合并执行器：A2 的实际执行依赖它，不能只躺在被忽略的目录里（同 启动一跨.bat 的教训）
!/scripts/a2-merge.mjs
# A2d-0 探针回归脚本：同理，验证脚本不能只躺在被忽略的目录里
!/scripts/verify-watchdog-probe.mjs
# 干净检出复现性验收：证明 git 里的字节 == 生产磁盘字节
!/scripts/verify-clean-checkout.mjs
# C2 采集器与其存储层：C2 的实际执行依赖它们，不能只躺在被忽略的目录里
!/scripts/fetch-ae-metrics.mjs
!/scripts/metrics-store.mjs
# C3 成本对账 / E1 T1 回写抽取器：同理，交付脚本不能只躺在被忽略的目录里
!/scripts/reconcile-cogs.py
!/scripts/writeback-t1.mjs
dist/src/dx_verify_detail.mjs
dist/src/poll_runall.mjs

