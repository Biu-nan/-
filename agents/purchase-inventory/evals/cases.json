  {
    "id": "quantity-split",
    "tier": "edge",
    "failureMode": "QUANTITY_LIMIT",
    "note": "单 SKU 建议 800 件超 500 上限 → 拆单并逐单确认，不截断成 500。复算：physical=300-50+0=250，velocity=420/14=30，800=30×(25+10)-250",
    "input": {
      "asOf": "2026-11-10T12:00:00+08:00",
      "calibers": {
        "inventory.actual": 300,
        "inventory.occupied": 50,
        "inventory.transit": 0,
        "sales.qty.total": 420
      },
      "historyDays": 14,
      "params": { "window": 14, "leadDays": 25, "safetyDays": 10, "minOrder": 20 }
    },
    "assertions": {
      "verdict": "RESTOCK",
      "physicalAvailable": 250,
      "dailyVelocity": 30,
      "rawSuggestQty": 800,
      "splitInto": 2,
      "eachOrderMax": 500,
      "onViolation": "SPLIT_AND_REQUIRE_HUMAN",
      "note": "不许静默截断为 500，也不许原样输出 800"
    }
  },
  {
    "id": "transit-stale-flag",
    "tier": "edge",
    "failureMode": "TRANSIT_STALE",
    "note": "在途滞后 100 分钟（>1 小时阈值）时仍可出结论，但理由必须带限定语。",
    "input": {
      "asOf": "2026-11-10T12:00:00+08:00",
      "transitCollectedAt": "2026-11-10T10:20:00+08:00",
      "calibers": {
        "inventory.actual": 120,
        "inventory.occupied": 20,
        "inventory.transit": 50,
        "sales.qty.total": 280
      },
      "historyDays": 14
    },
    "assertions": {
      "flags": ["TRANSIT_STALE"],
      "unknownsNonEmpty": true,
      "reasonMustContainAny": ["滞后", "可能更少", "未确认"]
    }
  }
